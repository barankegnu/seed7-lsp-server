$ include "seed7_05.s7i";
  include "utf8bytes.sd7";

const type: jsonWriter is new struct
    var string: buf is "";
  end struct;

const func string: hexByte (in integer: value) is
  return str(value radix 16 lpad0 2);

# The four-hex-digit form `\uXXXX' needs, for a code point above FF. Same shape as hexByte, and
# next to it because both are the JSON escape's number formatting.
const func string: hexQuad (in integer: value) is
  return str(value radix 16 lpad0 4);

const proc: jsonEscape (inout string: buf, in string: stri) is func
  local
    var integer: i is 0;
    var integer: cp is 0;
    var char: ch is ' ';
  begin
    buf &:= "\"";
    for i range 1 to length(stri) do
      ch := stri[i];
      cp := ord(ch);
      if ch = '"' then
        buf &:= "\\\"";
      elsif ch = '\\' then
        buf &:= "\\" & "\\";
      elsif ch = '\n' then
        buf &:= "\\n";
      elsif ch = '\r' then
        buf &:= "\\r";
      elsif ch = '\9;' then
        buf &:= "\\t";
      elsif cp < 32 then
        buf &:= "\\" <& "u00" <& hexByte(cp);
      elsif isSurrogate(cp) then
        # utf8bytes owns this bound; rpc.joinSurrogates reads the same one. A surrogate is a legal
        # SEED7 character (chr(55296) exists, and rpc keeps an unpaired one on purpose), but the
        # server's UTF-8 writer emits its three-byte CESU-8 form -- measured as ED A0 80, a count
        # utf8CharLength agrees with, so the frame survives and the bytes stay invalid. Escaping is
        # what makes the JSON and the stream agree. Everything outside the range stays raw, so a
        # real astral character and all of BMP text keep arriving readable.
        buf &:= "\\u" <& hexQuad(cp);
      else
        buf &:= stri[i .. i];
      end if;
    end for;
    buf &:= "\"";
  end func;

const proc: trimComma (inout string: buf) is func
  begin
    if endsWith(buf, ",") then
      buf := buf[1 .. pred(length(buf))];
    end if;
  end func;

const proc: openObject (inout jsonWriter: w) is func
  begin
    w.buf &:= "{";
  end func;

const proc: closeObject (inout jsonWriter: w) is func
  begin
    trimComma(w.buf);
    w.buf &:= "}";
    w.buf &:= ",";
  end func;

const proc: openArray (inout jsonWriter: w) is func
  begin
    w.buf &:= "[";
  end func;

const proc: closeArray (inout jsonWriter: w) is func
  begin
    trimComma(w.buf);
    w.buf &:= "]";
    w.buf &:= ",";
  end func;

const proc: field (inout jsonWriter: w, in string: name) is func
  begin
    trimComma(w.buf);
    if endsWith(w.buf, "{") then
    else
      w.buf &:= ",";
    end if;
    jsonEscape(w.buf, name);
    w.buf &:= ":";
  end func;

const proc: addStr (inout jsonWriter: w, in string: value) is func
  begin
    jsonEscape(w.buf, value);
    w.buf &:= ",";
  end func;

const proc: addInt (inout jsonWriter: w, in integer: value) is func
  begin
    w.buf &:= str(value);
    w.buf &:= ",";
  end func;

const proc: addBool (inout jsonWriter: w, in boolean: value) is func
  begin
    if value then
      w.buf &:= "true";
    else
      w.buf &:= "false";
    end if;
    w.buf &:= ",";
  end func;

const proc: addNull (inout jsonWriter: w) is func
  begin
    w.buf &:= "null";
    w.buf &:= ",";
  end func;

const func string: finishJson (inout jsonWriter: w) is func
  result
    var string: out is "";
  begin
    trimComma(w.buf);
    out := w.buf;
  end func;

const proc: raw (inout jsonWriter: w, in string: text) is func
  begin
    w.buf &:= text;
    w.buf &:= ",";
  end func;
