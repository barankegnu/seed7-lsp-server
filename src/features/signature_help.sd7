$ include "seed7_05.s7i";
  include "analysis.sd7";
  include "doc_store.sd7";
  include "jsonw.sd7";

const integer: MAX_SIGNATURES is 10;

# The callee for a request position, plus the index of the argument the cursor sits in.
#
# A single forward pass over the text up to the cursor, tracking the same three states
# insideText does (string literal, (* *) comment, # line comment) so a comma inside "..."
# is not an argument separator and a paren inside a comment is not a paren. The pass also
# remembers where each still-open '(' began, which is what makes the answer the INNERMOST
# unclosed call and not some unrelated earlier one -- the failure a backward walk produces
# on a real file, where a cursor inside a multi-line string happily reports the signature
# of a call that finished lines ago.
#
# Returns "" for an unopened document, a cursor inside text or a comment, a line with no
# unclosed "(", and a grouping "(...)" that has no name in front of it.
const func string: callContextOf (in lsDoc: doc, in integer: line0,
                                  in integer: character0,
                                  inout integer: active) is func
  result
    var string: out is "";
  local
    var integer: offset is 0;
    var integer: i is 0;
    var integer: depth is 0;
    var integer: cdepth is 0;
    var integer: lastIdx is 0;
    var boolean: inStr is FALSE;
    var boolean: inLine is FALSE;
    var boolean: esc is FALSE;
    var char: ch is ' ';
    var array integer: openAt is 1 times 0;
    var array integer: commas is 1 times 0;
  begin
    out := "";
    active := 0;
    offset := charIndexOf(doc, line0, character0);
    for i range 1 to pred(offset) do
      ch := doc.text[i];
      if inStr then
        if esc then
          esc := FALSE;
        elsif ch = BACKSLASH then
          esc := TRUE;
        elsif ch = '"' then
          inStr := FALSE;
        end if;
      elsif cdepth > 0 then
        if ch = '(' and nextIs(doc.text, i, '*') then
          cdepth +:= 1;
        elsif ch = '*' and nextIs(doc.text, i, ')') then
          cdepth := pred(cdepth);
        end if;
      elsif inLine then
        if ch = '\n' or ch = '\r' then
          inLine := FALSE;
        end if;
      elsif ch = '"' then
        inStr := TRUE;
      elsif ch = '(' and nextIs(doc.text, i, '*') then
        cdepth +:= 1;
      elsif ch = '#' then
        inLine := TRUE;
      elsif ch = '(' then
        depth +:= 1;
        if depth > length(openAt) then
          openAt &:= 0;
          commas &:= 0;
        end if;
        openAt[depth] := i;
        commas[depth] := 0;
      elsif ch = ')' then
        if depth > 0 then
          depth := pred(depth);
        end if;
      elsif ch = ',' then
        if depth > 0 then
          commas[depth] +:= 1;
        end if;
      end if;
    end for;
    if depth > 0 and not inStr and cdepth = 0 and not inLine then
      i := pred(openAt[depth]);
      while i >= 1 and doc.text[i] = ' ' do
        i := pred(i);
      end while;
      if i >= 1 and nameChar(doc.text[i]) then
        lastIdx := i;
        while pred(i) >= 1 and nameChar(doc.text[pred(i)]) do
          i := pred(i);
        end while;
        out := doc.text[i .. lastIdx];
        active := commas[depth];
      end if;
    end if;
  end func;

# SignatureHelp for one name: every overload, deduped by signature text. activeParameter
# is clamped only at the bottom -- an argument index past the last parameter is reported as
# typed, because that is the state the editor is in and dropping it would hide it.
const func string: signatureHelpResult (in array symRec: syms, in string: callee,
                                        in integer: active) is func
  result
    var string: out is "null";
  local
    var jsonWriter: w is jsonWriter.value;
    var array string: shown is 0 times "";
    var integer: emitted is 0;
    var integer: i is 0;
    var integer: p is 0;
    var integer: activeIdx is 0;
    var boolean: hasSigs is FALSE;
  begin
    if callee <> "" then
      openObject(w);
        field(w, "signatures");
        openArray(w);
          for i range 1 to length(syms) do
            if syms[i].name = callee and not listed(shown, syms[i].sign) and
               emitted < MAX_SIGNATURES then
              shown &:= syms[i].sign;
              emitted +:= 1;
              openObject(w);
                field(w, "label"); addStr(w, syms[i].sign);
                field(w, "parameters");
                openArray(w);
                  for p range 1 to length(syms[i].params) do
                    openObject(w);
                      field(w, "label"); addStr(w, syms[i].params[p]);
                    closeObject(w);
                  end for;
                closeArray(w);
              closeObject(w);
            end if;
          end for;
        closeArray(w);
        if emitted <> 0 then
          field(w, "activeSignature"); addInt(w, 0);
          activeIdx := active;
          if activeIdx < 0 then
            activeIdx := 0;
          end if;
          field(w, "activeParameter"); addInt(w, activeIdx);
          hasSigs := TRUE;
        end if;
      closeObject(w);
      if hasSigs then
        out := finishJson(w);
      end if;
    end if;
  end func;
