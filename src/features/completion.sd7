$ include "seed7_05.s7i";
  include "analysis.sd7";
  include "doc_store.sd7";
  include "features/kinds.sd7";
  include "jsonw.sd7";

const integer: MAX_COMPLETIONS is 100;

const type: nameSeen is hash [string] integer;

# The base vocabulary, copied from the lists seed7-mode tests against
# (~/seed7-mode/seed7-mode.el: seed7--statement-enclosing-keywords and
# seed7--declaration-intro-keywords). Seed7 syntax is DECLARED by $-pragmas in
# seed7_05.s7i, so no list of keywords can be complete -- this is what the base
# language offers, not what a project may add.
const array string: SEED7_KEYWORDS is
  []("attr", "block", "by", "case", "catch", "const", "do", "else", "elsif", "end",
   "enum", "exception", "for", "func", "global", "if", "in", "inout", "interface",
   "is", "local", "nested", "new", "otherwise", "out", "proc", "range", "ref",
   "repeat", "result", "return", "struct", "then", "type", "until", "val", "var",
   "varfunc", "while");

# The part of the token left of the cursor. word.character1 is a UTF-16 unit column
# from the scanner, and character0 is the request's UTF-16 column, so their difference
# is the prefix width in UTF-16 units. word.width is a CHARACTER count from the scanner,
# but names and numbers are ASCII, so for every visible token the character count equals
# the UTF-16 unit count and the clamp is safe.
const func string: prefixOf (in wordRef: word, in integer: character0) is func
  result
    var string: out is "";
  local
    var integer: left is 0;
  begin
    left := character0 - word.character1;
    if left > word.width then
      left := word.width;
    end if;
    if left > 0 then
      out := word.word[1 .. left];
    end if;
  end func;

# True when nm is something the user could actually type as an identifier. The analyzer's
# table contains operator and synthetic names ("." alone accounts for dozens of entries), and
# offering them puts text in the editor that cannot be parsed back.
const func boolean: isTypable (in string: nm) is func
  result
    var boolean: out is TRUE;
  local
    var integer: i is 0;
  begin
    if length(nm) = 0 or not nameChar(nm[1]) then
      out := FALSE;
    else
      for i range 1 to length(nm) do
        if not nameChar(nm[i]) then
          out := FALSE;
        end if;
      end for;
    end if;
  end func;

# One candidate pass over syms. `ownFile` first because the cap has to fall on the names
# from the file being edited, not on the first hundred of the standard library -- the
# analyzer returns globals in include order, so a single pass would rank stdlib first.
const func integer: emitSyms (inout jsonWriter: w, inout nameSeen: seen,
                              in array symRec: syms, in string: prefix,
                              in integer: emitted, in string: ownFile,
                              in boolean: wantOwn) is func
  result
    var integer: out is 0;
  local
    var string: nm is "";
    var integer: i is 0;
    var boolean: own is FALSE;
  begin
    out := emitted;
    for i range 1 to length(syms) do
      own := syms[i].file = ownFile or syms[i].file = BUFFER_FILE;
      if own = wantOwn then
        nm := syms[i].name;
        if isTypable(nm) and startsWith(nm, prefix) and nm <> prefix and
           nm not in seen and out < MAX_COMPLETIONS then
          seen @:= [nm] 1;
          out +:= 1;
          openObject(w);
            field(w, "label"); addStr(w, nm);
            field(w, "kind"); addInt(w, completionKindOf(syms[i].cat, syms[i].ty));
            field(w, "detail"); addStr(w, syms[i].sign);
            field(w, "sortText"); addStr(w, "0" <& nm);
          closeObject(w);
        end if;
      end if;
    end for;
  end func;

const func string: completionResult (in array symRec: syms, in wordRef: word,
                                     in integer: character0,
                                     in string: ownFile) is func
  result
    var string: out is "";
  local
    var jsonWriter: w is jsonWriter.value;
    var nameSeen: seen is nameSeen.EMPTY_HASH;
    var string: prefix is "";
    var string: nm is "";
    var integer: i is 0;
    var integer: emitted is 0;
  begin
    prefix := prefixOf(word, character0);
    openArray(w);
    emitted := emitSyms(w, seen, syms, prefix, emitted, ownFile, TRUE);
    emitted := emitSyms(w, seen, syms, prefix, emitted, ownFile, FALSE);
    for i range 1 to length(SEED7_KEYWORDS) do
      nm := SEED7_KEYWORDS[i];
      if startsWith(nm, prefix) and nm <> prefix and nm not in seen and
         emitted < MAX_COMPLETIONS then
        seen @:= [nm] 1;
        emitted +:= 1;
        openObject(w);
          field(w, "label"); addStr(w, nm);
          field(w, "kind"); addInt(w, 14);
          field(w, "sortText"); addStr(w, "1" <& nm);
        closeObject(w);
      end if;
    end for;
    closeArray(w);
    out := finishJson(w);
    if emitted = MAX_COMPLETIONS then
      # isIncomplete lives on CompletionList only, so the shape changes at the cap.
      out := "{\"isIncomplete\":true,\"items\":" <& out <& "}";
    end if;
  end func;
