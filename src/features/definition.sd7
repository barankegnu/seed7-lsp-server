$ include "seed7_05.s7i";
  include "analysis.sd7";
  include "doc_store.sd7";
  include "uris.sd7";
  include "jsonw.sd7";

const integer: MAX_LOCATIONS is 20;

const type: locSeen is hash [string] integer;

# Location[] for the token under the cursor: every declaration with that name, in this file
# or in any library it includes. Overloads are separate locations and the analyzer repeats
# some of them identically, hence the (file, line) dedupe. Reflection reports a declaration
# line and no column, so each location is the whole line -- the alternative is a second
# position function, which the invariants forbid.
#
# docUri is the document the request came from, and it is not decoration: reflection reports
# a declaration made in the analysed buffer as BUFFER_FILE ("STRING"), so without it the most
# common jump of all -- to a symbol defined in the file being edited -- becomes
# "file://STRING", which no client can open.
const func string: definitionResult (in array symRec: syms, in wordRef: word,
                                     in string: docUri) is func
  result
    var string: out is "null";
  local
    var jsonWriter: w is jsonWriter.value;
    var locSeen: seen is locSeen.EMPTY_HASH;
    var string: keyStr is "";
    var integer: emitted is 0;
    var integer: i is 0;
  begin
    if word.word <> "" then
      openArray(w);
      for i range 1 to length(syms) do
        if syms[i].name = word.word then
          keyStr := syms[i].file <& "|" <& str(syms[i].line1);
          if keyStr not in seen and emitted < MAX_LOCATIONS then
            seen @:= [keyStr] 1;
            emitted +:= 1;
            openObject(w);
              if syms[i].file = BUFFER_FILE then
                field(w, "uri"); addStr(w, docUri);
              else
                field(w, "uri"); addStr(w, uriFor(syms[i].file));
              end if;
              field(w, "range"); raw(w, lspWholeLine(syms[i].line1));
            closeObject(w);
          end if;
        end if;
      end for;
      closeArray(w);
      out := finishJson(w);
    end if;
  end func;
