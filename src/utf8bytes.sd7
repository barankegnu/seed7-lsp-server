$ include "seed7_05.s7i";

# Code-point widths, per character. The only place in this server that knows how wide a
# character is: utf8CharLength for the bytes a Content-Length must count, utf16CharLength for
# the units an LSP position counts under the negotiated "utf-16" encoding, and utf8Length for
# the whole-string byte count that writeMessage puts in a Content-Length. transport.sd7 owns
# every outbound byte count; doc_store.sd7 owns every position conversion; both call here
# rather than re-deriving a threshold, because the two rules differ on purpose (2048 and 65536
# are not the same boundary) and a copy of one of them is a bug waiting for the other to move.
# There is no whole-string utf16 count here on purpose: nothing calls for one, and a column
# table belongs to a document, not to a string.

# The surrogate range, in the one file that states code-point rules. Two callers need it and must
# not disagree on a bound: rpc.joinSurrogates folds a pair a client escaped, and it must know
# which half it is looking at; jsonw must NOT write one raw, because Seed7's UTF-8 encoder emits a
# surrogate as three bytes (measured: chr(55296) goes out as ED A0 80) -- a count utf8CharLength
# happily agrees with, and bytes no JSON decoder is obliged to accept. The halves are named
# separately because the fold's test is on a pair, not on one code point.
# A SURROGATE is one of the 2 048 code points 55296..57343 that UTF-8 reserves for nothing: they
# exist only as the two halves of a pair standing for a character above 65535.
const func boolean: isHighSurrogate (in integer: cp) is
  return cp >= 55296 and cp <= 56319;

const func boolean: isLowSurrogate (in integer: cp) is
  return cp >= 56320 and cp <= 57343;

const func boolean: isSurrogate (in integer: cp) is
  return cp >= 55296 and cp <= 57343;

const func integer: utf8CharLength (in char: ch) is func
  result
    var integer: n is 0;
  local
    var integer: cp is 0;
  begin
    cp := ord(ch);
    if cp < 128 then
      n := 1;
    elsif cp < 2048 then
      n := 2;
    elsif cp < 65536 then
      n := 3;
    else
      n := 4;
    end if;
  end func;

const func integer: utf16CharLength (in char: ch) is func
  result
    var integer: units is 1;
  begin
    if ord(ch) >= 65536 then
      units := 2;
    end if;
  end func;

const func integer: utf8Length (in string: stri) is func
  result
    var integer: n is 0;
  local
    var integer: i is 0;
  begin
    for i range 1 to length(stri) do
      n +:= utf8CharLength(stri[i]);
    end for;
  end func;
