$ include "seed7_05.s7i";
  include "lsp_server.sd7";

const proc: main is func
  local
    var string: body is "";
    var rpcMsg: msg is rpcMsg.value;
  begin
    libraryDirs &:= ".";
    while readMessage(body) do
      if body = "" then
      else
        # `msg' is loop-carried, so it must not survive into the next frame: handlerFailed now
        # echoes msg.idJson, and without this reset a raise inside parseMessage would answer the
        # PREVIOUS message's id -- a second response to a request already answered.
        msg := rpcMsg.value;
        block
          msg := parseMessage(body);
          if not msg.parseOkay then
            sendParseError(-32700, "Parse error: body is not JSON");
          elsif not gotInitialize and msg.method <> "initialize" and msg.method <> "exit" then
            if msg.isRequest then
              sendError(msg, -32002, "Server was not initialized");
            end if;
          elsif gotShutdown and msg.method <> "exit" then
            if msg.isRequest then
              sendError(msg, -32600, "InvalidRequest: server is shut down");
            end if;
          else
            handle(msg);
          end if;
        exception
          catch MEMORY_ERROR:    handlerFailed("memory", body, msg);
          catch ASSERTION_ERROR: handlerFailed("assertion", body, msg);
          catch NUMERIC_ERROR:   handlerFailed("numeric", body, msg);
          catch OVERFLOW_ERROR:  handlerFailed("overflow", body, msg);
          catch RANGE_ERROR:     handlerFailed("range", body, msg);
          catch INDEX_ERROR:     handlerFailed("index", body, msg);
          catch FILE_ERROR:      handlerFailed("file", body, msg);
          catch DATABASE_ERROR:  handlerFailed("database", body, msg);
          catch GRAPHIC_ERROR:   handlerFailed("graphic", body, msg);
          catch ILLEGAL_ACTION:  handlerFailed("illegal action", body, msg);
          catch CREATE_ERROR:    handlerFailed("create", body, msg);
          catch DESTROY_ERROR:   handlerFailed("destroy", body, msg);
          catch COPY_ERROR:      handlerFailed("copy", body, msg);
          catch IN_ERROR:        handlerFailed("input", body, msg);
        end block;
      end if;
    end while;
    if gotInitialize and gotShutdown then
      exit(0);
    elsif framingFatal then
      exit(2);
    end if;
  end func;
