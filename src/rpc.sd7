$ include "seed7_05.s7i";
  include "json.s7i";
  include "strifile.s7i";
  include "utf8bytes.sd7";
  include "jsonw.sd7";
  include "transport.sd7";

# ponytail: request ids are handled as integers only; every client tested
# (VS Code, eglot, lsp-mode, nvim) sends integers. A string id echoes back as
# 0, which the client ignores. Add raw-id text if a client ever needs it.

const type: rpcMsg is new struct
    var string: method is "";
    var integer: id is 0;
    var boolean: isRequest is FALSE;
    var boolean: parseOkay is TRUE;
    var jsonValue: params is jsonValue.value;
  end struct;

const func jsonValue: atKey (in jsonValue: obj, in string: name) is func
  result
    var jsonValue: value is jsonValue.value;
  begin
    block
      value := obj[name];
    exception
      catch RANGE_ERROR:     value := jsonValue(NULL);
      catch INDEX_ERROR:     value := jsonValue(NULL);
      catch ILLEGAL_ACTION:  value := jsonValue(NULL);
    end block;
  end func;

# A JSON string that holds an astral character usually holds it as a SURROGATE PAIR: Seed7's
# readJson turns each \uXXXX escape into its own char, so "\ud83d\ude00" arrives as two characters
# (55357, 56832) where the client meant one (128512 = 0x1F600, grinning face). Measured in M5 Task 10: the two astral
# characters of a didOpen body arrived as four lone surrogates and the analyzer published four
# Errors for them, which is the user-visible half of the damage -- the document text the server
# analyses was not the text the client sent.
#
# Total by construction: a stray high, a stray low, or a high followed by something that is not a
# low all pass through unchanged. Nothing here may raise, because every caller of this module sits
# on the request path and an exception would reach stdout -- the protocol channel.
#
# str(chr(n)) is how a code point becomes text here: "" & chr(n) and string(chr(n)) do not
# match, but str(char) does -- AGENTS.md says otherwise and is corrected in Task 11's doc pass.
const func string: joinSurrogates (in string: stri) is func
  result
    var string: out is "";
  local
    var integer: i is 0;
    var integer: hi is 0;
    var integer: lo is 0;
    var boolean: paired is FALSE;
  begin
    i := 1;
    while i <= length(stri) do
      hi := ord(stri[i]);
      paired := FALSE;
      if isHighSurrogate(hi) then
        if i < length(stri) then
          lo := ord(stri[succ(i)]);
          if isLowSurrogate(lo) then
            # 65536 here is the astral base of the pair formula, not a width rule -- the bounds
            # above are utf8bytes', which is also what jsonw refuses to write raw.
            out := out & str(chr(((hi - 55296) * 1024) + (lo - 56320) + 65536));
            paired := TRUE;
            i := succ(i);
          end if;
        end if;
      end if;
      if not paired then
        out := out & str(chr(hi));
      end if;
      i := succ(i);
    end while;
  end func;

# Does this string hold any code point the fold could touch? One scan, no allocation.
# The fold returns a string with no surrogate IDENTICAL to its input, so no black-box input
# separates the guarded path from the unguarded one and no mutant can redden a check -- what
# justifies the guard is a measurement, taken the way AGENTS.md requires: profiled AND optimised
# build, table read off profile_out, 50 strAt calls on the `text' of a 234-line didOpen body
# (11 466 characters, no surrogate anywhere). Command: s7c -p -O2 -l src <probe>, then run it.
#
#     226 310 us  joinSurrogates (50 calls)  <- 4 529 us per call: the unconditional fold
#      23 926 us  hasSurrogate   (50 calls)  <-   478 us per call: the scan that skips it
#
# Both halves of this were measured twice and the first pair of numbers was wrong, so they are
# recorded as corrected rather than as tidy: my first probe inlined the range test and reported
# 17 us, while the shipped scan calls the shared predicate and measured 1 392 us; collapsing
# utf8bytes.isSurrogate from `isHigh or isLow' to one ranged test is what brought it to 478 us.
# Every string in every request arrives through strAt, document text included, so the copy is paid
# on each didChange. ONE rpc_test check keeps the guard honest: "strAt joins the pair a client
# escaped" -- a real escaped pair must still come back as ONE character through strAt, which a guard
# that always took the fast path would break. The BMP reads that do traverse the FALSE path are
# "method", "nested uri" and "notification" -- the first and last through `parseMessage's own strAt
# of the method name -- and every one of them passes with the guard present, deleted, inverted or
# hard-wired, because on text with no surrogate the fold is the identity. "BMP text is untouched"
# is NOT one of those pins: it calls joinSurrogates directly and never enters strAt.
const func boolean: hasSurrogate (in string: stri) is func
  result
    var boolean: out is FALSE;
  local
    var integer: i is 0;
  begin
    for i range 1 to length(stri) do
      if not out then
        out := isSurrogate(ord(stri[i]));
      end if;
    end for;
  end func;

const func string: strAt (in jsonValue: obj, in string: name,
                          in string: fallback) is func
  result
    var string: value is "";
  local
    var jsonValue: found is jsonValue.value;
  begin
    found := atKey(obj, name);
    if category(found) = JSON_STRING then
      value := string(found);
      # Only the strings that need it pay the copy; see hasSurrogate for the measurement.
      if hasSurrogate(value) then
        value := joinSurrogates(value);
      end if;
    else
      value := fallback;
    end if;
  end func;

const func integer: intAt (in jsonValue: obj, in string: name,
                           in integer: fallback) is func
  result
    var integer: value is 0;
  local
    var jsonValue: found is jsonValue.value;
  begin
    value := fallback;
    found := atKey(obj, name);
    if category(found) = JSON_NUMBER then
      block
        value := integer(str(found));
      exception
        catch RANGE_ERROR: value := fallback;
      end block;
    end if;
  end func;

# The boolean reader. Total like intAt: `boolean(jsonValue)' raises ILLEGAL_ACTION for anything
# that is not JSON_BOOLEAN, and a client may send a number or a string in a boolean slot --
# `context.includeDeclaration' and `workspace.applyEdit' are both read through this.
const func boolean: boolAt (in jsonValue: obj, in string: name,
                            in boolean: fallback) is func
  result
    var boolean: value is FALSE;
  local
    var jsonValue: found is jsonValue.value;
  begin
    value := fallback;
    found := atKey(obj, name);
    if category(found) = JSON_BOOLEAN then
      value := boolean(found);
    end if;
  end func;

const func jsonValue: itemAt (in jsonValue: arr, in integer: index) is func
  result
    var jsonValue: value is jsonValue.value;
  begin
    if category(arr) = JSON_ARRAY then
      block
        value := arr[index];
      exception
        catch RANGE_ERROR:    value := jsonValue(NULL);
        catch INDEX_ERROR:    value := jsonValue(NULL);
      end block;
    end if;
  end func;

const func rpcMsg: parseMessage (in string: body) is func
  result
    var rpcMsg: msg is rpcMsg.value;
  local
    var jsonValue: root is jsonValue.value;
    var jsonValue: idValue is jsonValue.value;
  begin
    block
      root := readJson(body);
    exception
      catch RANGE_ERROR:    msg.parseOkay := FALSE;
      catch INDEX_ERROR:    msg.parseOkay := FALSE;
      catch ILLEGAL_ACTION: msg.parseOkay := FALSE;
    end block;
    if not msg.parseOkay then
    else
    msg.method := strAt(root, "method", "");
    msg.params := atKey(root, "params");
    idValue := atKey(root, "id");
    msg.isRequest := category(idValue) = JSON_NUMBER;
    if msg.isRequest then
      msg.id := intAt(root, "id", 0);
    end if;
    end if;
  end func;

const proc: sendParseError (in integer: code, in string: message) is func
  local
    var jsonWriter: w is jsonWriter.value;
  begin
    openObject(w);
      field(w, "jsonrpc"); addStr(w, "2.0");
      field(w, "id");      raw(w, "null");
      field(w, "error");
      openObject(w);
        field(w, "code");    addInt(w, code);
        field(w, "message"); addStr(w, message);
      closeObject(w);
    closeObject(w);
    writeMessage(finishJson(w));
  end func;

const proc: sendResult (in integer: id, in string: resultJson) is func
  local
    var jsonWriter: w is jsonWriter.value;
  begin
    openObject(w);
      field(w, "jsonrpc"); addStr(w, "2.0");
      field(w, "id");      addInt(w, id);
      field(w, "result");  raw(w, resultJson);
    closeObject(w);
    writeMessage(finishJson(w));
  end func;

const proc: sendError (in integer: id, in integer: code, in string: message) is func
  local
    var jsonWriter: w is jsonWriter.value;
  begin
    openObject(w);
      field(w, "jsonrpc"); addStr(w, "2.0");
      field(w, "id");      addInt(w, id);
      field(w, "error");
      openObject(w);
        field(w, "code");    addInt(w, code);
        field(w, "message"); addStr(w, message);
      closeObject(w);
    closeObject(w);
    writeMessage(finishJson(w));
  end func;

const proc: sendNotification (in string: method, in string: paramsJson) is func
  local
    var jsonWriter: w is jsonWriter.value;
  begin
    openObject(w);
      field(w, "jsonrpc"); addStr(w, "2.0");
      field(w, "method");  addStr(w, method);
      field(w, "params");  raw(w, paramsJson);
    closeObject(w);
    writeMessage(finishJson(w));
  end func;
