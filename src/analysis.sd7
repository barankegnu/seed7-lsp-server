$ include "seed7_05.s7i";
  include "progs.s7i";
  include "ref_list.s7i";

const type: lspDiag is new struct
    var integer: line1 is 1;
    var integer: column1 is 0;
    var string: message is "";
    var boolean: atEof is FALSE;
    var errorType: errKind is errorType.value;
    var integer: severity is 1;
  end struct;

const type: analysisResult is new struct
    var boolean: completed is FALSE;
    var array lspDiag: diags is 0 times lspDiag.value;
  end struct;

const func string: driverFor (in string: path) is
  return "$ include \"seed7_05.s7i\";\n  include " <& literal(path) <& ";\n";

# The diagnostics half of an already-parsed `program`. The parse is the expensive part
# (it builds the whole stdlib), and one parse can also answer the symbol half.
# analyzeAll is the only caller and the only entry point this server has.
const proc: collectDiags (in program: prog, inout analysisResult: res) is func
  local
    var parseError: err is parseError.value;
    var integer: i is 0;
    var lspDiag: diag is lspDiag.value;
  begin
    res.completed := TRUE;
    for i range 1 to errorCount(prog) do
      err := getError(prog, i);
      diag.line1 := err.lineNumber;
      diag.column1 := err.columnNumber;
      diag.message := err.message;
      diag.errKind := err.error;
      diag.atEof := err.message <> "" and pos(err.message, "END OF FILE") <> 0;
      res.diags &:= diag;
    end for;
  end func;

# Reflection's file for anything declared in the text handed to parseStri -- every buffer
# the editor owns. Included libraries keep their real absolute path, so this is what tells a
# document's own declarations apart from the ones it merely pulls in. Measured, not assumed.
const string: BUFFER_FILE is "STRING";

# One spelling of "declared in the document being edited": BUFFER_FILE for text handed to
# parseStri, and the document's OWN PATH for an open .s7i, which lsp_server analyses through
# driverFor(pathOf(uri)) with that same path as docPath -- so its declarations arrive with `file'
# equal to the path, never BUFFER_FILE (measured by analysis_test's probeDouble checks). The
# collectSyms guard below and occurrences' binding rows both ask through this one function.
const func boolean: isBufferFile (in string: fname, in string: docPath) is func
  result
    var boolean: out is FALSE;
  begin
    out := fname = BUFFER_FILE or fname = docPath;
  end func;

# One name visible inside a routine's own scope: a parameter, a local constant, a local
# variable or the result variable. `cat` is the reflection category stored VERBATIM, which
# is the measured shape (s7 5.4.10): a `const local' reports the category of its VALUE
# (INTOBJECT, STRIOBJECT, SETOBJECT) and only a `var local' answers LOCALVOBJECT. Nothing
# maps these, because a REFPARAMOBJECT and a VALUEPARAMOBJECT are different things for
# whichever feature reads a scope next.
const type: scopeRec is new struct
    var string: name is "";
    var integer: line1 is 0;
    var string: cat is "";
  end struct;

# One global declaration the analyzer knows about, as plain data. `file` is the absolute
# path reflection reports, or BUFFER_FILE for the analysed text itself; never "?". `line1`
# is the 1-based declaration line. There is no column anywhere in this API, which is why
# every range built from it is line-based. `locals` is the scope of a ROUTINE, filled only
# for the declarations of the document being analysed and reset to empty for every other
# record -- an empty `locals` on a library record is that guard, not an absence of scope.
const type: symRec is new struct
    var string: name is "";
    var string: cat is "";
    var string: ty is "";
    var string: file is "";
    var integer: line1 is 0;
    var string: sign is "";
    var array string: params is 0 times "";
    var array scopeRec: locals is 0 times scopeRec.value;
  end struct;

# The reflection accessors are partial, and every count here is measured over the 3 328
# globalObjects of the symbols fixture: getType raises RANGE_ERROR on 15 (all FWDREFOBJECT, a
# forward declaration has no type yet), localConsts, localVars and resultVar on 2 819 (every
# category that is not a routine). formalParams raised on none, yet `paramsOf' keeps its catch
# -- these are the totals that keep an exception off the protocol channel on stdout, and being
# total is not the same as having a witnessed raise. A proc is NOT a resultVar raiser: it
# answers the null reference, and it is `line' and `category' of THAT which raise.
const func string: safeType (in reference: obj) is func
  result
    var string: out is "";
  begin
    block
      out := str(getType(obj));
    exception
      catch RANGE_ERROR:
        out := "";
    end block;
  end func;

# formalParams lists the declared parameters AND a trailing self entry, which reflection
# reports as a plain SYMBOLOBJECT. Only the *PARAMOBJECT categories are parameters.
const func boolean: isParam (in reference: obj) is
  return pos(str(category(obj)), "PARAMOBJECT") <> 0;

const func string: paramText (in reference: obj) is func
  result
    var string: out is "";
  local
    var string: ty is "";
  begin
    ty := safeType(obj);
    if ty = "" or pos(ty, "*") <> 0 then
      # "" when the type raises; a marker when the type is anonymous -- a generic
      # parameter such as `pos's chSet reports " *ANONYM_TYPE* " instead of a name, and
      # printing that into a signature the user reads is worse than printing no type.
      out := str(obj);
    else
      out := ty <& ": " <& str(obj);
    end if;
  end func;

const func array string: paramsOf (in reference: obj) is func
  result
    var array string: out is 0 times "";
  local
    var ref_list: pl is ref_list.EMPTY;
    var integer: i is 0;
  begin
    block
      pl := formalParams(obj);
      for i range 1 to length(pl) do
        if isParam(pl[i]) then
          out &:= paramText(pl[i]);
        end if;
      end for;
    exception
      catch RANGE_ERROR:
        out := 0 times "";
    end block;
  end func;

# resultVar's answer for a routine that has no result variable -- a proc. Reading `line'
# or `category' of that reference raises, so the marker is checked before the fields.
const string: NULL_REFERENCE is " *NULL_OBJECT* ";

const func scopeRec: scopeOf (in reference: obj) is func
  result
    var scopeRec: out is scopeRec.value;
  begin
    out.name := str(obj);
    out.line1 := line(obj);
    out.cat := str(category(obj));
  end func;

# Every name the routine itself declares, in the order parameters, local constants, local
# variables, result variable. Total for the same reason as paramsOf -- and for one more:
# localConsts, localVars and resultVar answer RANGE_ERROR not only for a category that has
# no scope (a TYPEOBJECT, an ACTOBJECT) but for a routine whose own declaration failed,
# which is the ordinary state of a truncated buffer mid-typing.
const func array scopeRec: localsOf (in reference: obj) is func
  result
    var array scopeRec: out is 0 times scopeRec.value;
  local
    var ref_list: rl is ref_list.EMPTY;
    var reference: item is NIL;
    var reference: rv is NIL;
  begin
    block
      rl := formalParams(obj);
      for item range rl do
        if isParam(item) then
          out &:= scopeOf(item);
        end if;
      end for;
      rl := localConsts(obj);
      for item range rl do
        out &:= scopeOf(item);
      end for;
      rl := localVars(obj);
      for item range rl do
        out &:= scopeOf(item);
      end for;
      rv := resultVar(obj);
      if str(rv) <> NULL_REFERENCE then
        out &:= scopeOf(rv);
      end if;
    exception
      catch RANGE_ERROR:
        out := 0 times scopeRec.value;
      catch INDEX_ERROR:
        out := 0 times scopeRec.value;
      catch ILLEGAL_ACTION:
        out := 0 times scopeRec.value;
    end block;
  end func;

# The one place that knows what a Seed7 declaration looks like in prose. The parameter
# specifiers (in/inout/ref/val) are not recoverable: `in string:` and `in Widget:` both
# report REFPARAMOBJECT while `in integer:` reports VALUEPARAMOBJECT, so the honest form is
# "type: name". ponytail: a scanner could read the specifiers off the source; scan.sd7 (M4).
const func string: buildSign (in string: cat, in string: ty, in string: nm,
                              in array string: params) is func
  result
    var string: out is "";
  local
    var integer: i is 0;
  begin
    if cat = "TYPEOBJECT" then
      out := "const type: " <& nm;
    elsif cat = "ENUMLITERALOBJECT" then
      out := nm;
    elsif startsWith(ty, "func ") then
      out := "const func " <& ty[6 ..] <& ": " <& nm;
    elsif startsWith(ty, "proc") then
      out := "const proc: " <& nm;
    elsif pos(ty, "*") <> 0 then
      # Anonymous and generated types report a compiler marker (" *ANONYM_TYPE* ",
      # " *NULL_ENTITY_OBJECT* ") instead of a name -- every `set of char' in the
      # stdlib does. A marker in a hover is worse than no type, so the name stands alone.
      out := nm;
    elsif ty <> "" then
      out := "const " <& ty <& ": " <& nm;
    else
      out := nm;
    end if;
    if length(params) <> 0 then
      out := out <& " (";
      for i range 1 to length(params) do
        out &:= params[i];
        if i < length(params) then
          out &:= ", ";
        end if;
      end for;
      out := out <& ")";
    end if;
  end func;

const func string: signatureOf (in reference: obj) is func
  result
    var string: out is "";
  begin
    out := buildSign(str(category(obj)), safeType(obj), str(obj), paramsOf(obj));
  end func;

# `x not in arr` does not match when x is a struct field select, and the dedupe this
# needs is the whole point of the helper, so the loop is written out once here.
const func boolean: listed (in array string: texts, in string: one) is func
  result
    var boolean: out is FALSE;
  local
    var integer: i is 0;
  begin
    for i range 1 to length(texts) do
      if texts[i] = one then
        out := TRUE;
      end if;
    end for;
  end func;

const type: symSeen is hash [string] integer;

# The symbol half of an already-parsed `program`, appended to `syms`. Same reason as
# collectDiags: one parseStri, both answers.
const proc: collectSyms (in program: prog, inout array symRec: syms,
                         in string: docPath) is func
  local
    var ref_list: objs is ref_list.EMPTY;
    var reference: obj is NIL;
    var symSeen: seen is symSeen.EMPTY_HASH;
    var string: keyStr is "";
    var symRec: rec is symRec.value;
  begin
    objs := globalObjects(prog);
    for obj range objs do
      rec.name := str(obj);
      rec.file := file(obj);
      if rec.file <> "?" and rec.file <> "" then
        rec.cat := str(category(obj));
        rec.ty := safeType(obj);
        rec.line1 := line(obj);
        rec.params := paramsOf(obj);
        # Buffer declarations only. A library local can shadow nothing visible in this
        # document, and four accessor walks per record is not free: filling every one of the
        # 3 328 globalObjects the symbols fixture parses to measured 52 ms per analyzeAll
        # against 43 ms guarded, calc7 140 against 130, shiftjis 71 against 64 -- medians of
        # three runs of nine analyses each, the same harness and text on both sides.
        if isBufferFile(rec.file, docPath) then
          rec.locals := localsOf(obj);
        else
          # `rec' is loop-carried and this is the only field the guard does not re-stamp,
          # so without the reset a library record copies whatever the previous filled
          # routine left in it -- measured with a late-loaded include after a buffer
          # declaration, which is legal Seed7 and real library files do it.
          rec.locals := 0 times scopeRec.value;
        end if;
        rec.sign := signatureOf(obj);
        keyStr := rec.name <& "|" <& rec.file <& "|" <& str(rec.line1);
        if keyStr not in seen then
          seen @:= [keyStr] 1;
          syms &:= rec;
        end if;
      end if;
    end for;
  end func;

# Diagnostics and symbols from ONE parse, and the only analysis entry point this server has: the
# dispatcher holds one of these per open document (spec §4.2), so a didChange followed by a hover
# costs one parseStri rather than the two analyzeText and analyzeSymbols each paid for
# themselves. Error containment is deliberately asymmetric, and it is a behaviour change from
# those two functions, which this one replaces:
# - the parse is OUTSIDE the guard. Wrapping it would turn a raise into an EMPTY diagnostic
#   list, which publishes a falsely clean document -- the class of lie this branch deletes. The
#   cost is that a raise from `parseStri' now escapes to main.sd7's -32603 net on all six paths
#   that reach here (five symbol branches and refresh), where analyzeSymbols used to answer
#   "no records" for its own and analyzeText never guarded it at all. AGENTS.md's claim that the
#   net is unreachable is now WIDER than it was: no input this server can be given produces one,
#   but MEMORY_ERROR territory exists, and nothing can check for it.
# - the reflection walk keeps the guard it always had: a raise there loses the records and keeps
#   the diagnostics, because `globalObjects' and its accessors are the unreliable half.
const type: docAnalysis is new struct
    var analysisResult: parsed is analysisResult.value;
    var array symRec: syms is 0 times symRec.value;
  end struct;

const func docAnalysis: analyzeAll (in string: text,
                                    in array string: libraryDirs,
                                    in string: docPath) is func
  result
    var docAnalysis: out is docAnalysis.value;
  local
    var program: prog is program.EMPTY;
  begin
    prog := parseStri(text, parseOptions.value, libraryDirs);
    collectDiags(prog, out.parsed);
    block
      collectSyms(prog, out.syms, docPath);
    exception
      # Every accessor above is total, so reaching here means the walk itself is
      # unreliable. Report nothing rather than a half-truth.
      catch RANGE_ERROR:
        out.syms := 0 times symRec.value;
      catch INDEX_ERROR:
        out.syms := 0 times symRec.value;
      catch ILLEGAL_ACTION:
        out.syms := 0 times symRec.value;
    end block;
  end func;
