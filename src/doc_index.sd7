$ include "seed7_05.s7i";
  include "utf8.s7i";

# The (** ... *) comment above a declaration, which is the only documentation Seed7
# libraries carry. Hover asks for it by (file, declaration line) -- both come straight out
# of reflection -- and gets "" when there is none.
#
# readLinesOf opens with openUtf8: the .s7i files hold UTF-8 and plain open() yields one
# character per byte, which is how the euro sign in lib/asn1.s7i's own comment for
# genAsn1String reached hover as U+00E2 U+0082 U+00AC (310 characters became 314).

const func array string: readLinesOf (in string: path) is func
  result
    var array string: lines is 0 times "";
  local
    var file: f is STD_NULL;
    var string: one is "";
  begin
    block
      f := openUtf8(path, "r");
      while not eof(f) do
        readln(f, one);
        lines &:= one;
      end while;
      close(f);
    exception
      catch FILE_ERROR:
        lines := 0 times "";
      # readln on a utf8File raises RANGE_ERROR at the first byte sequence that is not valid
      # UTF-8 (measured: FF FE, C3 28, a lone 80; ut8_rtl.c(771)). The empty list is what an
      # unreadable comment already answers, so hover keeps the signature and loses the prose
      # instead of costing the request a -32603. Do not fall back to open() here -- that is
      # the one byte per character read whose mojibake the reader above exists to remove.
      catch RANGE_ERROR:
        lines := 0 times "";
    end block;
  end func;

const func string: trimLeft (in string: lineText) is func
  result
    var string: out is "";
  local
    var integer: i is 1;
  begin
    out := lineText;
    while i <= length(out) and (out[i] = ' ' or out[i] = '\9;') do
      i +:= 1;
    end while;
    out := out[i ..];
  end func;

# The decoration is " *  " at the front of every body line; the closing " *)" line is
# detected with trimLeft alone, because stripping its star is what would hide it.
const func string: stripDoc (in string: lineText) is func
  result
    var string: out is "";
  local
    var string: trimmed is "";
  begin
    out := trimLeft(lineText);
    if startsWith(out, "*") then
      out := out[2 ..];
    end if;
    trimmed := out;
    if length(trimmed) >= 1 and trimmed[1] = ' ' then
      out := trimmed[2 ..];
    end if;
    out := trimLeft(out);
  end func;

const func boolean: blank (in string: lineText) is
  return trimLeft(lineText) = "";

const func string: trimRight (in string: lineText) is func
  result
    var string: out is "";
  local
    var integer: lastIdx is 0;
  begin
    out := lineText;
    lastIdx := length(out);
    while lastIdx >= 1 and (out[lastIdx] = ' ' or out[lastIdx] = '\9;' or out[lastIdx] = '\r') do
      lastIdx := pred(lastIdx);
    end while;
    out := out[1 .. lastIdx];
  end func;

# (** ... *) written on one line: the body is between the two markers.
const func string: proseBody (in string: lineText) is func
  result
    var string: out is "";
  local
    var integer: openAt is 0;
    var integer: closeAt is 0;
  begin
    openAt := pos(lineText, "(**");
    closeAt := pos(lineText, "*)");
    if openAt <> 0 and closeAt > openAt + 2 then
      out := trimRight(stripDoc(lineText[openAt + 3 .. pred(closeAt)]));
    end if;
  end func;

const func string: proseIn (in array string: lines, in integer: line1) is func
  result
    var string: out is "";
  local
    var integer: idx is 0;
    var integer: startIdx is 0;
    var integer: stopIdx is 0;
    var string: one is "";
  begin
    idx := line1 - 1;
    if idx > length(lines) then
      idx := 0;
    end if;
    while idx >= 1 and blank(lines[idx]) do
      idx := idx - 1;
    end while;
    if idx >= 1 and endsWith(trimLeft(lines[idx]), "*)") then
      stopIdx := idx;
      startIdx := idx;
      while startIdx >= 1 and pos(lines[startIdx], "(**") = 0 do
        startIdx := pred(startIdx);
      end while;
      if startIdx >= 1 then
        if startIdx = stopIdx then
          out := proseBody(lines[startIdx]);
        else
          for idx range succ(startIdx) to pred(stopIdx) do
            one := stripDoc(trimRight(lines[idx]));
            if one <> "" and not startsWith(one, "@") then
              if out <> "" then
                out &:= "\n";
              end if;
              out &:= one;
            end if;
          end for;
        end if;
      end if;
    end if;
  end func;

const func string: proseFor (in string: path, in integer: line1) is func
  result
    var string: out is "";
  local
    var array string: lines is 0 times "";
  begin
    lines := readLinesOf(path);
    out := proseIn(lines, line1);
  end func;

# The same walk over text that never reached disk. Reflection reports a declaration made in
# an editor buffer as BUFFER_FILE, so there is no path to open -- hover needs the prose out
# of the document it is already holding.
const func string: proseForText (in string: text, in integer: line1) is func
  result
    var string: out is "";
  begin
    out := proseIn(split(text, '\n'), line1);
  end func;
