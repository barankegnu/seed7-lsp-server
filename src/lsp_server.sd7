$ include "seed7_05.s7i";
  include "stdio.s7i";
  include "utf8.s7i";
  include "transport.sd7";
  include "rpc.sd7";
  include "doc_store.sd7";
  include "analysis.sd7";
  include "diagnostics.sd7";
  include "uris.sd7";
  include "features/document_symbol.sd7";
  include "features/definition.sd7";
  include "features/hover.sd7";
  include "features/completion.sd7";
  include "features/signature_help.sd7";
  include "features/folding_range.sd7";
  include "features/selection_range.sd7";
  include "features/semantic_tokens.sd7";
  include "features/references.sd7";
  include "features/prepare_rename.sd7";
  include "features/rename.sd7";

const integer: MAX_DIAGNOSTICS is 100;

# window/logMessage MessageType. Deliberately not diagnostics.sd7's SEV_INFORMATION: the
# two enums share the number 3 and nothing else.
const integer: MSG_INFO is 3;
const integer: MSG_WARNING is 2;

const type: docMap is hash [string] lsDoc;

var docMap: openDocs is docMap.EMPTY_HASH;
var array string: libraryDirs is 0 times "";
var boolean: gotInitialize is FALSE;
var boolean: gotShutdown is FALSE;

# Decoded root paths the client declared at initialize, empty means none declared.
var array string: projectRoots is 0 times "";
# TRUE iff initialize yielded at least one usable root.
var boolean: rootsDeclared is FALSE;

# Two readers of `initialize' params: the applyEdit flag below (a WorkspaceEdit is a promise only
# a client that declared workspace.applyEdit can keep), and the project roots captured for the
# trust gate. Every other member of that payload stays unread -- that debt
# (hierarchicalDocumentSymbolSupport, SymbolKind valueSet) is LISTED in the M5 design's section 10
# rather than paid here, and this flag is the one place section 7 lets section 6 depend on. It
# reaches prepare_rename.sd7 as a PARAMETER: a file in src/features/ is included before
# this global exists and must read no global.
var boolean: clientCanApplyEdits is FALSE;

# One analysis per OPEN document, held beside openDocs rather than inside `lsDoc`: `symRec` is
# declared in analysis.sd7 and doc_store.sd7 must not come to include that.
#
# The entry is valid by PRESENCE, deliberately, and that is the whole invalidation rule: any
# path that changes a document's text or version must delete its entry first. Each of the three
# drops that exist today has its own pin: didOpen's by the didOpen-with-no-close wire check,
# didChange's by the versionless-change wire check, didClose's by the unit assertion that a close
# empties the map -- the reopen-after-close wire check CANNOT pin didClose, because didOpen's drop
# would rescue it, which is why the unit suite holds that one. didClose's drop is the O(open
# documents) memory bound, nothing more.
const type: analysisMap is hash [string] docAnalysis;

var analysisMap: analysisCache is analysisMap.EMPTY_HASH;

const proc: note (in string: text) is func
  begin
    writeln(STD_UTF8_ERR, "seed7-lsp: " <& text);
  end func;

# A handler that raises must cost the request, never the server: log enough to
# reproduce it, answer a JSON-RPC internal error, and keep reading. The `body' stays in the log
# line because it is what makes the failure reproducible; `msg' is what the answer echoes.
const proc: handlerFailed (in string: kind, in string: body, in rpcMsg: msg) is func
  begin
    note("handler failed (" <& kind <& "): " <& body);
    sendError(msg, -32603, "internal error: " <& kind);
  end func;

# A line the feature said it needed the user to see, sent to the client as a window/logMessage
# BEFORE whatever answer follows, and mirrored to stderr. Both halves are frames or stderr: this
# is the only place a log line reaches the protocol channel, and nothing writes it to stdout.
const proc: logMessage (in integer: level, in string: text) is func
  local
    var jsonWriter: w is jsonWriter.value;
  begin
    note(text);
    openObject(w);
      field(w, "type");    addInt(w, level);
      field(w, "message"); addStr(w, text);
    closeObject(w);
    sendNotification("window/logMessage", finishJson(w));
  end func;

const func string: capabilitiesJson is func
  result
    var string: out is "";
  local
    var jsonWriter: w is jsonWriter.value;
  begin
    openObject(w);
      field(w, "textDocumentSync");
      openObject(w);
        field(w, "openClose"); addBool(w, TRUE);
        field(w, "change");    addInt(w, 1);
      closeObject(w);
      field(w, "signatureHelpProvider");
      openObject(w);
        field(w, "triggerCharacters");
        openArray(w);
          addStr(w, "(");
          addStr(w, ",");
        closeArray(w);
      closeObject(w);
      field(w, "completionProvider");
      openObject(w);
      closeObject(w);
      field(w, "hoverProvider"); addBool(w, TRUE);
      field(w, "definitionProvider"); addBool(w, TRUE);
      field(w, "documentSymbolProvider"); addBool(w, TRUE);
      field(w, "referencesProvider"); addBool(w, TRUE);
      field(w, "renameProvider");
      openObject(w);
        field(w, "prepareProvider"); addBool(w, TRUE);
      closeObject(w);
      field(w, "foldingRangeProvider"); addBool(w, TRUE);
      field(w, "selectionRangeProvider"); addBool(w, TRUE);
      field(w, "semanticTokensProvider");
      openObject(w);
        field(w, "legend"); raw(w, semanticTokensLegend);
        field(w, "range"); addBool(w, TRUE);
        field(w, "full");  addBool(w, TRUE);
      closeObject(w);
      field(w, "positionEncoding"); addStr(w, "utf-16");
    closeObject(w);
    out := finishJson(w);
  end func;

const func string: initializeResultJson is func
  result
    var string: out is "";
  local
    var jsonWriter: w is jsonWriter.value;
  begin
    openObject(w);
      field(w, "capabilities"); raw(w, capabilitiesJson);
      field(w, "serverInfo");
      openObject(w);
        field(w, "name");    addStr(w, "seed7-lsp");
        field(w, "version"); addStr(w, "0.1");
      closeObject(w);
    closeObject(w);
    out := finishJson(w);
  end func;

# The only place that decides whether a document is analysed as typed or through the
# synthetic .s7i driver. Everything downstream -- diagnostics and every symbol feature --
# asks for text here, so the two cannot disagree about what "this document" is.
const func string: textToAnalyze (in string: uri) is func
  result
    var string: out is "";
  begin
    if uri in openDocs then
      if isLibraryBufferPath(pathOf(uri)) then
        out := driverFor(pathOf(uri));
      else
        out := openDocs[uri].text;
      end if;
    end if;
  end func;

# TRUE for a root that narrows the gate: non-empty and not all slashes (a root of /
# strips to empty inside underRoot and matches every path, so it is rootless in effect).
# A mixed list keeps only the narrowing roots — declaring / alongside another root does
# not open everything; the narrower result still refuses paths outside the surviving root.
const func boolean: usableRoot (in string: p) is func
  result
    var boolean: out is FALSE;
  local
    var string: stripped is "";
  begin
    stripped := p;
    while length(stripped) <> 0 and stripped[length(stripped)] = '/' do
      stripped := stripped[1 .. pred(length(stripped))];
    end while;
    out := length(stripped) <> 0;
  end func;

# The gate predicate: TRUE when no roots were declared (the rootless case is open by design)
# or the document's decoded path is inside one of them. Consulted by ensureAnalyzed and refresh.
const func boolean: analysable (in string: uri) is func
  result
    var boolean: out is FALSE;
  begin
    out := not rootsDeclared or underRoot(pathOf(uri), projectRoots);
  end func;

# The single place a document is analysed. Every reader below goes through it, so a changed
# document costs one parseStri and a symbol request arriving after that change costs none -- the
# change's own refresh has already filled the entry. OBLIGATION: any path that changes a
# document's text or version must delete its entry before refreshing; validity here is presence,
# deliberately (see `analysisCache' above for why there is no second mechanism). The
# `seed7-lsp: analyzed ' line on stderr is what tests/transcript.py counts, because the log is
# the observable and no counter variable belongs in the product.
const proc: ensureAnalyzed (in string: uri) is func
  local
    var docAnalysis: fresh is docAnalysis.value;
  begin
    # Scanner-backed features (foldingRange, selectionRange, semanticTokens) keep answering for
    # an untrusted buffer: they read doc.text and cannot execute code. The hover/definition/
    # outline/references/rename family answers from an empty symbol list instead -- references
    # returns its text occurrences with an unresolved disclosure (spec 12.2's read may over-include).
    if analysable(uri) then
      if uri in openDocs and not (uri in analysisCache) then
        fresh := analyzeAll(textToAnalyze(uri), libraryDirs, pathOf(uri));
        # ponytail: one entry per OPEN document, which is what didClose's drop bounds -- the
        # alternative is one per version, and spec §4.3 prices a single 1 060-record array at
        # +1.15 MiB (measured here: 21 versions of one document raised RSS by 1.5 MiB in TOTAL,
        # not 21 times). A `hash [string] struct` stores by value (probed), so this cannot alias
        # `fresh`.
        analysisCache @:= [uri] fresh;
        note("analyzed " <& uri <& " version " <& str(openDocs[uri].version) <&
             " records " <& str(length(fresh.syms)));
      end if;
    end if;
  end func;

const func analysisResult: analyzeDocument (in string: uri) is func
  result
    var analysisResult: out is analysisResult.value;
  begin
    ensureAnalyzed(uri);
    if uri in analysisCache then
      out := analysisCache[uri].parsed;
    end if;
  end func;

# The document half of every textDocument request. Read once because all five features
# and the three sync handlers need it, and a variant that forgets the "" check or the
# membership check is an exception on the protocol channel.
const func string: uriOfRequest (in rpcMsg: msg) is func
  result
    var string: out is "";
  begin
    out := strAt(atKey(msg.params, "textDocument"), "uri", "");
  end func;

# The position half of every TextDocumentPosition request: an unresolved uri or a
# document that was never opened yields the empty wordRef, which each feature turns into
# its own "nothing here" answer. Written once because the uri check and the two intAt
# defaults must not be re-derived per feature.
const func wordRef: wordOfRequest (in rpcMsg: msg) is func
  result
    var wordRef: out is wordRef.value;
  local
    var string: uri is "";
    var jsonValue: at is jsonValue.value;
  begin
    uri := uriOfRequest(msg);
    at := atKey(msg.params, "position");
    if uri <> "" and uri in openDocs then
      out := wordAt(openDocs[uri], intAt(at, "line", 0), intAt(at, "character", 0));
    end if;
  end func;

# The symbol table behind all five symbol features. Signature unchanged, body now cached:
# a client that asks for a hover and a definition on one version pays for neither, and a
# document that is not open answers with no records rather than analysing the empty text.
const func array symRec: symbolsOfDocument (in string: uri) is func
  result
    var array symRec: out is 0 times symRec.value;
  begin
    ensureAnalyzed(uri);
    if uri in analysisCache then
      out := analysisCache[uri].syms;
    end if;
  end func;

# The one sentence R-F10 owes the user. analysis.sd7's driverFor(path) is how a library
# gets analysed, because the interpreter will not take a library's own text once that
# library is inside seed7_05.s7i's include closure -- measured in docs/rf10-measurement.md:
# 184 of the 214 top-level libraries analyse clean from text and 29 redeclare (basearray 2
# names, null_file 44); the 30th, multiscr.s7i, is NOISY on either route, so it is not a split.
# So the symbols, ranges and prose an open .s7i shows are the
# FILE's, and an unsaved edit is invisible -- including when the buffer already matches disk,
# which is why no comparison is made and no second read is paid per keystroke. The write path
# already refuses on this same predicate.
const string: LIB_STALE_MESSAGE is
  "unsaved edits in this library are not analysed: the outline, hover, completion"
  <& " and the diagnostics come from the file on disk";

# Pure, not inlined into `refresh`: a unit suite grades this decision and cannot capture the
# protocol channel. It is handed the buffer because the anchor is a property of the buffer: every
# real .s7i opens with an empty line, and a record anchored there collapses to a zero-width range
# (doc_store.firstNonEmptyLine). The caller looks the buffer up once and hands the same value to
# both the publisher and this.
const func array lspDiag: discloseStaleLibrary (in array lspDiag: mapped,
                                                in string: uri,
                                                in lsDoc: doc) is func
  result
    var array lspDiag: out is 0 times lspDiag.value;
  local
    var lspDiag: stale is lspDiag.value;
  begin
    out := mapped;
    if isLibraryBufferPath(pathOf(uri)) then
      stale.line1 := firstNonEmptyLine(doc);
      stale.column1 := 0;
      stale.message := LIB_STALE_MESSAGE;
      stale.severity := SEV_INFORMATION;
      out &:= stale;
    end if;
  end func;

const proc: refresh (in string: uri) is func
  local
    var analysisResult: a is analysisResult.value;
    var array lspDiag: mapped is 0 times lspDiag.value;
    var lsDoc: buf is lsDoc.value;
  begin
    # Returning early for an untrusted uri: publishing an empty diagnostics list would claim
    # a clean document, which is the class of lie the spec's §4 already refuses for parseStri.
    if analysable(uri) then
      a := analyzeDocument(uri);
      mapped := mapDiagnostics(a.diags, MAX_DIAGNOSTICS);
      buf := openDocs[uri];
      publish(uri, buf, discloseStaleLibrary(mapped, uri, buf));
    end if;
  end func;

const proc: handleChange (in rpcMsg: msg) is func
  local
    var string: uri is "";
    var jsonValue: changes is jsonValue.value;
    var jsonValue: last is jsonValue.value;
  begin
    uri := uriOfRequest(msg);
    if uri <> "" and uri in openDocs then
      # Full sync: the last change object holds the whole text (LSP 3.18).
      changes := atKey(msg.params, "contentChanges");
      if category(changes) = JSON_ARRAY then
        last := itemAt(changes, length(changes));
      end if;
      if category(last) = JSON_OBJECT then
        setVersion(openDocs[uri], strAt(last, "text", openDocs[uri].text),
                   intAt(atKey(msg.params, "textDocument"), "version",
                         openDocs[uri].version));
      end if;
      # The version above may be the one intAt invented: LSP 3.18 REQUIRES `version' on
      # VersionedTextDocumentIdentifier, so a frame without it is malformed, and this server
      # answers it instead of rejecting it. A change we tolerate is a change we must not cache
      # past, so the entry is dropped here rather than left to a number comparison.
      excl(analysisCache, uri);
      refresh(uri);
    end if;
  end func;

const proc: handle (in rpcMsg: msg) is func
  local
    var string: uri is "";
    var string: callee is "";
    var integer: activeArg is 0;
    var integer: fromLine is 0;
    var integer: toLine is 0;
    var jsonValue: span is jsonValue.value;
    var refsAnswer: refs is refsAnswer.value;
    var prepareAnswer: prep is prepareAnswer.value;
    var renameAnswer: ren is renameAnswer.value;
    var selAnswer: sel is selAnswer.value;
    var string: newName is "";
    var jsonValue: folders is jsonValue.value;
    var jsonValue: rootUriVal is jsonValue.value;
    var string: rootPath is "";
    var integer: fi is 0;
    var array string: collected is 0 times "";
  begin
    if msg.method = "initialize" then
      gotInitialize := TRUE;
      # atKey answers NULL for a missing `workspace' and boolAt falls back for a missing key or a
      # non-boolean value, so the boolean true is the only input that raises the flag.
      clientCanApplyEdits := boolAt(atKey(msg.params, "workspace"), "applyEdit", FALSE);
      # Trust gate: collect the project roots the client declared. workspaceFolders is an
      # array of {uri} objects; rootUri is the single-folder fallback. An empty string is
      # skipped, never fatal.
      collected := 0 times "";
      folders := atKey(msg.params, "workspaceFolders");
      rootUriVal := atKey(msg.params, "rootUri");
      if category(folders) = JSON_ARRAY and length(folders) <> 0 then
        for fi range 1 to length(folders) do
          rootPath := pathOf(strAt(itemAt(folders, fi), "uri", ""));
          if usableRoot(rootPath) then
            collected &:= rootPath;
          end if;
        end for;
      elsif category(rootUriVal) = JSON_STRING then
        rootPath := pathOf(strAt(msg.params, "rootUri", ""));
        if usableRoot(rootPath) then
          collected &:= rootPath;
        end if;
      end if;
      projectRoots := collected;
      rootsDeclared := length(collected) <> 0;
      sendResult(msg, initializeResultJson);
      # A rootless client runs unguarded by design (single-file editing must not break), but
      # the plan promises the client is told once. Sent AFTER the result so the InitializeResult
      # is the first frame on the wire, not a logMessage.
      if not rootsDeclared then
        logMessage(MSG_WARNING, "the server will analyse every document it is given because no project roots were declared");
      end if;
    elsif msg.method = "initialized" then
    elsif msg.method = "$/setTrace" then
    elsif msg.method = "$/cancelRequest" then
    elsif msg.method = "shutdown" then
      gotShutdown := TRUE;
      sendResult(msg, "null");
    elsif msg.method = "exit" then
      if gotInitialize and gotShutdown then
        exit(0);
      else
        exit(1);
      end if;
    elsif msg.method = "textDocument/didOpen" then
      uri := uriOfRequest(msg);
      if uri <> "" then
        openDocs @:= [uri] lsDoc.value;
        setVersion(openDocs[uri], strAt(atKey(msg.params, "textDocument"), "text", ""),
                   intAt(atKey(msg.params, "textDocument"), "version", 0));
        # A didOpen with no didClose in between is another frame a client must not send and this
        # server answers. The document was just replaced, whatever its version number says.
        excl(analysisCache, uri);
        if not analysable(uri) then
          logMessage(MSG_INFO, "refusing to analyse " <& uri <& ": it is outside the project roots this client declared");
        else
          refresh(uri);
        end if;
      end if;
    elsif msg.method = "textDocument/documentSymbol" then
      uri := uriOfRequest(msg);
      if uri <> "" and uri in openDocs then
        sendResult(msg, documentSymbolResult(symbolsOfDocument(uri), pathOf(uri)));
      else
        sendResult(msg, "null");
      end if;
    elsif msg.method = "textDocument/definition" then
      uri := uriOfRequest(msg);
      if uri <> "" and uri in openDocs then
        sendResult(msg, definitionResult(symbolsOfDocument(uri),
                     wordOfRequest(msg), uri));
      else
        sendResult(msg, "null");
      end if;
    elsif msg.method = "textDocument/references" then
      uri := uriOfRequest(msg);
      if uri <> "" and uri in openDocs then
        refs := referencesAnswer(openDocs[uri], symbolsOfDocument(uri), wordOfRequest(msg),
                                 uri,
                                 boolAt(atKey(msg.params, "context"), "includeDeclaration",
                                        FALSE));
        # The disclosure goes out before the answer it describes, so a client that shows the
        # notification cannot be handed a wider list than the symbol without being told.
        if refs.unresolved then
          logMessage(MSG_INFO, refs.why);
        end if;
        sendResult(msg, refs.json);
      else
        sendResult(msg, "null");
      end if;
    elsif msg.method = "textDocument/prepareRename" then
      uri := uriOfRequest(msg);
      if uri <> "" and uri in openDocs then
        prep := prepareRenameAnswer(openDocs[uri], symbolsOfDocument(uri),
                                    wordOfRequest(msg), uri, clientCanApplyEdits);
        # The reason goes out before the null it explains, as references' disclosure does.
        if prep.refused then
          logMessage(MSG_INFO, prep.why);
        end if;
        sendResult(msg, prep.json);
      else
        sendResult(msg, "null");
      end if;
    elsif msg.method = "textDocument/rename" then
      uri := uriOfRequest(msg);
      if uri <> "" and uri in openDocs then
        newName := strAt(msg.params, "newName", "");
        ren := renameResult(openDocs[uri], symbolsOfDocument(uri), wordOfRequest(msg), uri,
                            newName, clientCanApplyEdits);
        # Two events, and the client reads them differently. A REFUSAL -- this cursor names a
        # symbol this server will not rewrite -- is null, the same answer prepareRename gives for
        # the same reason, from the same predicate. A REJECTED newName or a collision is a request
        # the user can correct, so it is -32602 InvalidParams. Both mirror `why' to the log and
        # stderr; only the second costs an error frame.
        if ren.error = "invalid" then
          logMessage(MSG_INFO, ren.why);
          sendError(msg, -32602, ren.why);
        else
          if ren.why <> "" then
            logMessage(MSG_INFO, ren.why);
          end if;
          sendResult(msg, ren.json);
        end if;
      else
        sendResult(msg, "null");
      end if;
    elsif msg.method = "textDocument/hover" then
      uri := uriOfRequest(msg);
      if uri <> "" and uri in openDocs then
        sendResult(msg, hoverResult(openDocs[uri], symbolsOfDocument(uri),
                     wordOfRequest(msg)));
      else
        sendResult(msg, "null");
      end if;
    elsif msg.method = "textDocument/completion" then
      uri := uriOfRequest(msg);
      if uri <> "" and uri in openDocs then
        sendResult(msg, completionResult(symbolsOfDocument(uri), wordOfRequest(msg),
                     intAt(atKey(msg.params, "position"), "character", 0), pathOf(uri)));
      else
        sendResult(msg, "[]");
      end if;
    elsif msg.method = "textDocument/signatureHelp" then
      uri := uriOfRequest(msg);
      # callContextOf writes activeArg through an inout parameter, so it must not be
      # nested inside the call that reads it.
      if uri in openDocs then
        callee := callContextOf(openDocs[uri],
                                intAt(atKey(msg.params, "position"), "line", 0),
                                intAt(atKey(msg.params, "position"), "character", 0),
                                activeArg);
      else
        callee := "";
      end if;
      sendResult(msg, signatureHelpResult(symbolsOfDocument(uri), callee, activeArg));
    elsif msg.method = "textDocument/foldingRange" then
      uri := uriOfRequest(msg);
      if uri <> "" and uri in openDocs then
        sendResult(msg, foldingResult(openDocs[uri]));
      else
        sendResult(msg, "[]");
      end if;
    elsif msg.method = "textDocument/selectionRange" then
      uri := uriOfRequest(msg);
      if uri <> "" and uri in openDocs then
        sel := selectionResult(openDocs[uri], atKey(msg.params, "positions"));
        # The disclosure goes out before the answer it describes, mirroring references.
        if sel.truncated then
          logMessage(MSG_INFO, sel.why);
        end if;
        sendResult(msg, sel.json);
      else
        sendResult(msg, "[]");
      end if;
    elsif msg.method = "textDocument/semanticTokens/full" then
      uri := uriOfRequest(msg);
      if uri <> "" and uri in openDocs then
        sendResult(msg, tokensIn(openDocs[uri], symbolsOfDocument(uri),
                                    pathOf(uri), 0, pred(lineCount(openDocs[uri]))));
      else
        sendResult(msg, "null");
      end if;
    elsif msg.method = "textDocument/semanticTokens/range" then
      uri := uriOfRequest(msg);
      if uri <> "" and uri in openDocs then
        span := atKey(msg.params, "range");
        fromLine := intAt(atKey(span, "start"), "line", 0);
        toLine := intAt(atKey(span, "end"), "line", pred(lineCount(openDocs[uri])));
        sendResult(msg, tokensIn(openDocs[uri], symbolsOfDocument(uri), pathOf(uri),
                                    fromLine, toLine));
      else
        sendResult(msg, "null");
      end if;
    elsif msg.method = "textDocument/didChange" then
      handleChange(msg);
    elsif msg.method = "textDocument/didClose" then
      uri := uriOfRequest(msg);
      if uri in openDocs then
        if analysable(uri) then
          publish(uri, openDocs[uri], 0 times lspDiag.value);
        end if;
        excl(openDocs, uri);
        # The drop that bounds the cache at one entry per OPEN document.
        excl(analysisCache, uri);
      end if;
    else
      if msg.isRequest then
        sendError(msg, -32601, "Method not found: " <& msg.method);
      end if;
    end if;
  end func;
