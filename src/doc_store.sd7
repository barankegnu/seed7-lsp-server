$ include "seed7_05.s7i";
  include "utf8bytes.sd7";
  include "scan.sd7";

const type: lsDoc is new struct
    var string: text is "";
    var integer: version is 0;
    var array integer: lineStart is 1 times 1;
    var string: mask is "";
  end struct;

# The token under an LSP position. line1/column1 are 1-based and measured from the start
# of the line, but they are CHARACTER columns -- they do NOT follow the analyzer's
# byte-valued convention -- so a feature hands them straight to lspRange/lspRangePair.
# Only columns taken from parseError.columnNumber go through lspRangeBytes; routing a
# character column there would shift every range on a non-ASCII line.
# An empty word means "no token here".
const type: wordRef is new struct
    var string: word is "";
    var integer: line1 is 0;
    var integer: column1 is 0;
    var integer: character1 is 0;      # 0-based column in UTF-16 units, like every LSP one
    var integer: width is 0;
  end struct;

const func array integer: lineStarts (in string: text) is func
  result
    var array integer: starts is 1 times 1;
  local
    var integer: i is 0;
  begin
    starts := 1 times 1;
    for i range 1 to length(text) do
      if text[i] = '\n' then
        if i = 1 or text[pred(i)] <> '\r' then
          starts &:= succ(i);
        end if;
      elsif text[i] = '\r' then
        if i < length(text) and text[succ(i)] = '\n' then
          starts &:= succ(succ(i));
        else
          starts &:= succ(i);
        end if;
      end if;
    end for;
  end func;

const func integer: lineWidth (in string: text, in integer: start) is func
  result
    var integer: n is 0;
  local
    var integer: i is 0;
  begin
    i := start;
    while i <= length(text) and text[i] <> '\n' and text[i] <> '\r' do
      i +:= 1;
      n +:= 1;
    end while;
  end func;

# The same walk in UTF-16 units. lspRangeUnits needs the line's unit width to clamp to, and
# doing it here is the difference between O(line) and O(document): `utf16Before' counts from
# the START of the text, so the width that used to be `utf16Before(start + lineWidth) -
# utf16Before(start)' cost one pass over every character ahead of the line. Measured on a probe of
# exactly that shape -- the capped references answer's range count and document size, 2 001 line
# starts in a 22 000-character ASCII body, `s7c -p -O2 -l src': 1 791 629 µs for the old form's two
# `utf16Before' calls (4 002 calls), against 17 586 µs for 40 020 `lineUnits' calls over those same
# starts twenty times over. Both rows are observed; any quotient between them is arithmetic, not a
# measurement -- and it is the document over the line that is the real ratio here, which IS the
# O(document)-vs-O(line) claim. The 7.9 s that used to sit here is deleted: no honest run of that
# shape reproduces it, and a number no command produces is worse than none. No other feature asks
# for more than two ranges per response, which is why it was never felt before this one.
const func integer: lineUnits (in string: text, in integer: start) is func
  result
    var integer: units is 0;
  local
    var integer: i is 0;
  begin
    i := start;
    while i <= length(text) and text[i] <> '\n' and text[i] <> '\r' do
      units +:= utf16CharLength(text[i]);
      i +:= 1;
    end while;
  end func;

# The mask is rebuilt on every didChange. Before the &:= rewrite this was ~22.6 s over 375 352 chars;
# after it is ~30 ms (s7c -p -O2 -l src /tmp/mask_cost.sd7 over ~/seed7/lib/shiftjis.s7i, profile_out;
# the shipped server is interpreted, so it pays more per call, but the ratio holds). The rewrite is
# what makes didChange cheap; the lazy fill the ponytail note promised is no longer needed.
const proc: setVersion (inout lsDoc: doc, in string: text, in integer: version) is func
  begin
    doc.text := text;
    doc.version := version;
    doc.lineStart := lineStarts(text);
    doc.mask := maskOf(text);
  end func;

const func integer: lineCount (in lsDoc: doc) is
  return length(doc.lineStart);

# The 1-based number of the first line that holds a character, or 1 when every line is blank.
# A range anchored on an EMPTY line has no width: `lspRangeBytes' clamps both bounds to 0, because
# `charColumnForBytes' returns column 1 without entering its loop. Every real library is like that
# on line 1 -- `find ~/seed7/lib -name '*.s7i' -exec sh -c 'head -1 "$1" | wc -c' _ {} \; | sort -u'
# prints only `1' (a bare newline) for all 265 of them -- so a diagnostic pinned to line 1 of a
# library carries an empty range, and `Diagnostic.range' IS the range a message applies to: an
# anchor over no characters names nothing the disclosure is about. (What a client *draws* for an
# empty range was not measured -- no client exists in this environment.) The
# walk is one `lineWidth' per leading blank line, so it costs O(the blank prefix) and never
# O(document) (invariant 8).
const func integer: firstNonEmptyLine (in lsDoc: doc) is func
  result
    var integer: line1 is 1;
  local
    var integer: i is 0;
  begin
    i := 1;
    while i <= lineCount(doc) and lineWidth(doc.text, doc.lineStart[i]) = 0 do
      i +:= 1;
    end while;
    if i <= lineCount(doc) then
      line1 := i;
    end if;
  end func;

# The line index for a 1-based line number, clamped. Written once because lspRange and
# lspRangeBytes both start from an analyzer-supplied line that can be past the buffer.
# It sits above lspRange because Seed7 cannot call a function defined later in the file.
const func integer: lineIndexOf (in lsDoc: doc, in integer: line1) is func
  result
    var integer: lineIdx is 1;
  begin
    lineIdx := line1;
    if lineIdx < 1 then
      lineIdx := 1;
    elsif lineIdx > lineCount(doc) then
      lineIdx := lineCount(doc);
    end if;
  end func;

# The UTF-16 units carried by the first `count' characters of the line that begins at index
# `start', stopping at a line break or the end of the text. This is the `lineUnits' shape this
# file already has, bounded by `count' as well -- not a new idea, the second half of one: M4 spec
# §4.4 promised random access is "bounded by line length", and that held for `charIndexOf' and
# `charColumnForBytes' and for `lineUnits' itself, while `lspRange' still asked `utf16Before' twice
# (start + ch, then start) and subtracted, which walks from index 1 -- O(document) per range. The
# probe is 100 diagnostics through `diagnosticsJson' five times, `s7c -p -O2 -l src', rows read
# from profile_out. On lib/shiftjis.s7i (375 354 chars, 3 635 lines): 14 821 089 µs for the five
# publishes, of which 14 813 248 µs in 2 000 `utf16Before' calls; 3 532 µs for the same five now,
# 328 µs in 1 000 `unitsOfPrefix' calls. On a synthetic 2 004-line / 113 119-char document with
# those 100 diagnostics on its first hundred lines: 209 664 µs against 3 732 µs. The published
# bodies are byte-identical across the two builds (`cmp', 14 194 and 13 831 bytes), so the ratio
# buys nothing the client had to give up. Every figure is a row of profile_out; a per-publish
# figure would be a quotient of these, not a measurement.
const func integer: unitsOfPrefix (in string: text, in integer: start,
                                   in integer: count) is func
  result
    var integer: units is 0;
  local
    var integer: i is 0;
    var integer: n is 0;
  begin
    i := start;
    n := 0;
    while n < count and i <= length(text) and text[i] <> '\n' and text[i] <> '\r' do
      units +:= utf16CharLength(text[i]);
      i +:= 1;
      n +:= 1;
    end while;
  end func;

const func string: lspRange (in lsDoc: doc, in integer: line1, in integer: column1) is func
  result
    var string: out is "";
  local
    var integer: lineIdx is 0;
    var integer: start is 1;
    var integer: ch is 0;
    var integer: width is 0;
  begin
    lineIdx := lineIndexOf(doc, line1);
    start := doc.lineStart[lineIdx];
    width := lineWidth(doc.text, start);
    ch := column1 - 1;
    if ch < 0 then
      ch := 0;
    elsif ch > width then
      ch := width;
    end if;
    out := "{\"line\":" <& lineIdx - 1 <& ",\"character\":" <&
           unitsOfPrefix(doc.text, start, ch) <& "}";
  end func;

# The range for a token, from the (line0, col16, width16) the scanner measured. col16 is
# ALREADY a UTF-16 column, so nothing here converts it -- lspRange would treat it as a
# character column and convert, which is the double conversion that made selectionRange
# report the wrong range on any line with multi-byte text before the token. Clamped to the
# line's UTF-16 width, the way lspRange clamps an absurd character column.
const func string: lspRangeUnits (in lsDoc: doc, in integer: line0, in integer: col16,
                                  in integer: width16) is func
  result
    var string: out is "";
  local
    var integer: lineIdx is 0;
    var integer: start is 1;
    var integer: units is 0;
    var integer: first is 0;
    var integer: last is 0;
  begin
    lineIdx := lineIndexOf(doc, succ(line0));
    start := doc.lineStart[lineIdx];
    units := lineUnits(doc.text, start);
    first := col16;
    if first < 0 then
      first := 0;
    elsif first > units then
      first := units;
    end if;
    last := first + width16;
    if last > units then
      last := units;
    end if;
    out := "{\"start\":{\"line\":" <& lineIdx - 1 <& ",\"character\":" <& first <&
           "},\"end\":{\"line\":" <& lineIdx - 1 <& ",\"character\":" <& last <& "}}";
  end func;

# The 1-based character column that holds the 1-based UTF-8 byte offset `byteCol`.
# A byte in the middle of a multi-byte character names that character, and a byte past
# the line's end names the character just after it, which lspRange clamps to the line
# length -- the same way it already clamps an absurd character column.
const func integer: charColumnForBytes (in string: text, in integer: start,
                                        in integer: byteCol) is func
  result
    var integer: ch is 1;
  local
    var integer: i is 0;
    var integer: cum is 0;
    var boolean: found is FALSE;
  begin
    i := start;
    ch := 1;
    cum := 0;
    found := FALSE;
    while i <= length(text) and text[i] <> '\n' and text[i] <> '\r' and not found do
      if cum + utf8CharLength(text[i]) >= byteCol then
        found := TRUE;
      else
        cum +:= utf8CharLength(text[i]);
        i +:= 1;
        ch +:= 1;
      end if;
    end while;
  end func;

# lspRange for a column that arrives from the analyzer, which counts bytes. Every other
# caller of lspRange hands it a character column it computed itself.
const func string: lspRangeBytes (in lsDoc: doc, in integer: line1,
                                  in integer: byteCol) is func
  result
    var string: out is "";
  local
    var integer: lineIdx is 0;
  begin
    lineIdx := lineIndexOf(doc, line1);
    out := lspRange(doc, lineIdx, charColumnForBytes(doc.text, doc.lineStart[lineIdx],
                                                     byteCol));
  end func;

const func boolean: isAlpha (in char: ch) is
  return (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z');

const func boolean: isDigit (in char: ch) is
  return ch >= '0' and ch <= '9';

const func boolean: nameChar (in char: ch) is
  return ch = '_' or isAlpha(ch) or isDigit(ch);

const set of char: OP_CHARS is {'+', '-', '*', '/', '<', '>', '=', ',', ':', ';',
                                '&', '%', '^', '|', '~', '!', '?', '@'};

const func boolean: opChar (in char: ch) is
  return ch in OP_CHARS;

# Every non-code character replaced by a space: string literals, char literals,
# (* *) comments (nesting aware) and # line comments. Newlines are kept and the length is
# unchanged, so an offset into the result is the same offset into the document.
# The mask is built eagerly in setVersion by scan.sd7's maskOf; this function returns it.
const func string: codeText (in lsDoc: doc) is func
  result
    var string: out is "";
  begin
    out := doc.mask;
  end func;

# The character AT an LSP position -- positions sit between characters, so this is
# the character to the RIGHT of the cursor. A position at or past the end of its
# line yields the index of that line's terminator; an out-of-range line yields one
# past the text, which callers treat as "no character here".
const func integer: charIndexOf (in lsDoc: doc, in integer: line0,
                                 in integer: character0) is func
  result
    var integer: idx is 0;
  local
    var integer: lineIdx is 0;
    var integer: start is 1;
    var integer: i is 1;
    var integer: units is 0;
  begin
    idx := length(doc.text) + 1;
    lineIdx := line0 + 1;
    if lineIdx >= 1 and lineIdx <= lineCount(doc) then
      start := doc.lineStart[lineIdx];
      i := start;
      units := 0;
      while i <= length(doc.text) and units < character0 and
            doc.text[i] <> '\n' and doc.text[i] <> '\r' do
        units +:= utf16CharLength(doc.text[i]);
        i +:= 1;
      end while;
      idx := i;
    end if;
  end func;

# The token under an LSP position, as the shape the symbol features have always taken.
# The column is a CHARACTER column and the width counts characters, so completion's
# prefixOf and hover's range need no change. The token comes from the scanner, not a
# character run, which is what closes the a<b and 16#beef defects.
#
# Two suppressions preserve what the deleted character-run machine answered:
# - TK_ILLEGAL: a non-ASCII character under the cursor is one illegal token in the
#   scanner, but the old machine returned nothing for it. Hovering a control character
#   should not offer a one-character word.
# - Operators whose first character is not in OP_CHARS: `.`, `$`, `` ` `` and `\` are special
#   characters per manual/tokens.htm 10.2.2 and the scanner recognizes them as tokens,
#   but the old machine's OP_CHARS excluded them. `.` is a declared operator with 79
#   overloads in the base program, so this suppression is a known loss, not a rule about
#   Seed7. The filter is a preserved defect from the character-run era, recorded so a
#   follow-up spec can reopen it.
const func wordRef: wordAt (in lsDoc: doc, in integer: line0,
                            in integer: character0) is func
  result
    var wordRef: out is wordRef.value;
  local
    var integer: lineIdx is 0;
    var integer: start is 1;
    var integer: idx is 1;
    var tok: tk is tok.value;
  begin
    lineIdx := line0 + 1;
    if lineIdx >= 1 and lineIdx <= lineCount(doc) then
      start := doc.lineStart[lineIdx];
      idx := charIndexOf(doc, line0, character0);
      tk := tokenAt(doc.text, idx);
      if tk.start > 0 and not hiddenKind(tk.kind) and tk.kind <> TK_ILLEGAL then
        if tk.kind = TK_OP and not opChar(doc.text[tk.start]) then
          (* `.`, `$`, `` ` ``, `\`: suppressed per the comment above *)
        else
          out.word := doc.text[tk.start .. tk.stop];
          out.line1 := succ(tk.line0);
          out.column1 := tk.start - start + 1;
          out.character1 := tk.col16;
          out.width := tk.stop - tk.start + 1;
        end if;
      end if;
    end if;
  end func;

const func string: lspRangePair (in lsDoc: doc, in integer: line1, in integer: column1,
                                 in integer: width) is func
  result
    var string: out is "";
  begin
    out := "{\"start\":" <& lspRange(doc, line1, column1) <& ",\"end\":" &
           lspRange(doc, line1, column1 + width) <& "}";
  end func;

const func string: lspWholeLine (in integer: line1) is func
  result
    var string: out is "";
  begin
    out := "{\"start\":{\"line\":" <& line1 - 1 <& ",\"character\":0}," <&
           "\"end\":{\"line\":" <& line1 <& ",\"character\":0}}";
  end func;
