# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# s7c takes no -o, so a compiled build lands beside its source: `make build' and
# `make build-debug' produce src/main. Ignored so a build cannot leave the tree dirty.
/src/main
# build-debug adds -g-debug_c, whose debug information refers to the generated C, so s7c keeps
# that 5 MB temporary file instead of cleaning it up.
/src/tmp_*.c

# Local git worktrees
.worktrees

# SDD scratch (ledger, briefs, review packages)
.superpowers

# pi harness per-project state (its todo store, session scratch) -- machine-local, and it
# regenerates on demand, so it is scratch in the same sense as the block above.
.pi/

# Python bytecode from the transcript harness
__pycache__/
*.pyc
