$ include "seed7_05.s7i";
  include "lsp_tst.sd7";
  include "doc_store.sd7";
  include "analysis.sd7";
  include "features/semantic_tokens.sd7";

const func lsDoc: docOf (in string: text) is func
  result
    var lsDoc: out is lsDoc.value;
  begin
    setVersion(out, text, 1);
  end func;

const func array symRec: oneWriteln is func
  result
    var array symRec: out is 0 times symRec.value;
  local
    var symRec: rec is symRec.value;
  begin
    rec.name := "writeln";
    rec.cat := "BLOCKOBJECT";
    rec.ty := "proc";
    rec.file := "/home/username/seed7/lib/stdio.s7i";
    rec.line1 := 2;
    rec.sign := "const proc: writeln";
    out &:= rec;
  end func;

const func array symRec: twoWriteln is func
  result
    var array symRec: out is 0 times symRec.value;
  local
    var symRec: first is symRec.value;
    var symRec: second is symRec.value;
  begin
    first.name := "writeln";
    first.cat := "TYPEOBJECT";
    first.file := BUFFER_FILE;
    first.line1 := 1;
    out &:= first;
    second.name := "writeln";
    second.cat := "BLOCKOBJECT";
    second.ty := "proc";
    second.file := BUFFER_FILE;
    second.line1 := 9;
    out &:= second;
  end func;

# The order globalObjects really yields: the library's record first, the buffer's own last.
# The own declaration is a data name, so the tokenType itself must move, not only the
# modifiers. A Seed7 routine name and a data name live in different overload spaces
# (features/rename.sd7), so a func and a var both named length is a legal fixture.
const func array symRec: libThenOwn is func
  result
    var array symRec: out is 0 times symRec.value;
  local
    var symRec: rec is symRec.value;
  begin
    rec.name := "length";
    rec.cat := "ACTOBJECT"; rec.ty := "func integer";
    rec.file := "/home/user/seed7/lib/string.s7i"; rec.line1 := 336;
    out &:= rec;
    rec.cat := "VAROBJECT"; rec.ty := "integer";
    rec.file := BUFFER_FILE; rec.line1 := 1;
    out &:= rec;
  end func;

# The same set for a buffer whose own declarations arrive with the document's path instead of
# BUFFER_FILE, which is what an open .s7i produces (lsp_server drives it with a synthetic main).
const func array symRec: pathThenOwn is func
  result
    var array symRec: out is 0 times symRec.value;
  local
    var symRec: rec is symRec.value;
  begin
    rec.name := "length";
    rec.cat := "ACTOBJECT"; rec.ty := "func integer";
    rec.file := "/home/user/seed7/lib/string.s7i"; rec.line1 := 336;
    out &:= rec;
    rec.cat := "VAROBJECT"; rec.ty := "integer";
    rec.file := "/p/a.sd7"; rec.line1 := 1;
    out &:= rec;
  end func;

const proc: main is func
  begin
    check("the legend is the seven types and two modifiers, in index order",
          semanticTokensLegend,
          "{\"tokenTypes\":[\"comment\",\"string\",\"number\",\"function\",\"type\"," &
          "\"variable\",\"enumMember\"]," &
          "\"tokenModifiers\":[\"declaration\",\"defaultLibrary\"]}");
    check("an empty document answers an empty data array",
          tokensIn(docOf(""), 0 times symRec.value, "/p/a.sd7", 0, 0),
          "{\"data\":[]}");
    check("a comment and a number emit, and an unknown name does not",
          tokensIn(docOf("(* note *) 42 q"), 0 times symRec.value, "/p/a.sd7", 0, 0),
          "{\"data\":[0,0,10,0,0,0,11,2,2,0]}");
    check("punctuation emits nothing, but a number literal does",
          tokensIn(docOf("a := (b) + c[1]"), 0 times symRec.value, "/p/a.sd7", 0, 0),
          "{\"data\":[0,13,1,2,0]}");
    check("modifiers and the cross-line delta rule, in one array",
          tokensIn(docOf("writeln\nwriteln"), oneWriteln, "/p/a.sd7", 0, 1),
          "{\"data\":[0,0,7,3,2,1,0,7,3,3]}");
    check("a range request rebases its first delta",
          tokensIn(docOf("writeln\nwriteln"), oneWriteln, "/p/a.sd7", 1, 1),
          "{\"data\":[1,0,7,3,3]}");
    check("a name declared twice takes the first declaration's class",
          tokensIn(docOf("writeln\n"), twoWriteln, "/p/a.sd7", 0, 0),
          "{\"data\":[0,0,7,4,1]}");
    check("an own declaration of a library name keeps its own class and marker",
          tokensIn(docOf("length"), libThenOwn, "/p/a.sd7", 0, 0),
          "{\"data\":[0,0,6,5,1]}");
    check("an .s7i buffer's own declaration wins the class tables too",
          tokensIn(docOf("length"), pathThenOwn, "/p/a.sd7", 0, 0),
          "{\"data\":[0,0,6,5,1]}");
    # The fixture is the test: x is undeclared so it is not emitted, which starts the first
    # emitted token at column 2. In a fixture whose first token is at column 0, prevCol is 0
    # and the delta is relative to nothing, so the subtraction cannot be observed.
    check("same-line delta is relative to the previous token's column",
          tokensIn(docOf("x 42 99"), 0 times symRec.value, "/p/a.sd7", 0, 0),
          "{\"data\":[0,2,2,2,0,0,3,2,2,0]}");
    report("semantic_tokens");
  end func;
