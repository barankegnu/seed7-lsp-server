$ include "seed7_05.s7i";
  include "stdio.s7i";
  include "filesys.s7i";
  include "osfiles.s7i";
  include "lsp_tst.sd7";
  include "analysis.sd7";


const type: lineSeen is hash [string] integer;

# the sign of a symbol, for assertions that a marker never reaches it
const func string: signatureOfText (in string: sign) is
  return sign;

const func string: readAll (in string: path) is func
  result
    var string: out is "";
  local
    var file: f is STD_NULL;
    var string: one is "";
  begin
    block
      f := open(path, "r");
      while not eof(f) do
        readln(f, one);
        out &:= one <& "\n";
      end while;
      close(f);
    exception
      catch FILE_ERROR:
        out := "";
    end block;
  end func;

const func array symRec: symsNamed (in array symRec: syms, in string: nm) is func
  result
    var array symRec: out is 0 times symRec.value;
  local
    var integer: i is 0;
  begin
    for i range 1 to length(syms) do
      if syms[i].name = nm then
        out &:= syms[i];
      end if;
    end for;
  end func;

const func string: allFiles (in array symRec: syms) is func
  result
    var string: out is "";
  local
    var integer: i is 0;
  begin
    for i range 1 to length(syms) do
      out &:= syms[i].file;
    end for;
  end func;

const func integer: countNameFile (in array symRec: syms, in string: nm,
                                   in string: fname) is func
  result
    var integer: out is 0;
  local
    var integer: i is 0;
  begin
    for i range 1 to length(syms) do
      if syms[i].name = nm and syms[i].file = fname then
        out +:= 1;
      end if;
    end for;
  end func;

const func integer: countDistinctLines (in array symRec: syms, in string: nm,
                                        in string: fname) is func
  result
    var integer: out is 0;
  local
    var lineSeen: seen is lineSeen.EMPTY_HASH;
    var string: keyStr is "";
    var integer: i is 0;
  begin
    for i range 1 to length(syms) do
      if syms[i].name = nm and syms[i].file = fname then
        keyStr := str(syms[i].line1);
        if keyStr not in seen then
          seen @:= [keyStr] 1;
          out +:= 1;
        end if;
      end if;
    end for;
  end func;

const proc: main is func
  local
    var analysisResult: a is analysisResult.value;
    var array string: dirs is 0 times "";
    var string: libPath is "/tmp/seed7_lsp_probe.s7i";
    var array symRec: syms is 0 times symRec.value;
    var array symRec: wlist is 0 times symRec.value;
    var string: fixPath is "tests/programs/symbols.sd7";
    var file: out is STD_NULL;
  begin
    # Empty libraryDirs is enough: the interpreter resolves its own stdlib,
    # so the test does not depend on where Seed7 happens to be installed.
    a := analyzeText("$ include \"seed7_05.s7i\";\nconst proc: main is func\n  begin\n    writeln(1 + \"a\");\n  end func;\n", dirs);
    check("semantic error count", str(length(a.diags)), "2");
    check("first error has no column", str(a.diags[1].column1), "0");
    check("not flagged as EOF", str(a.diags[1].atEof), "FALSE");
    a := analyzeText("$ include \"seed7_05.s7i\";\nconst proc: main is func\n  begin\n", dirs);
    check("truncated file has EOF class", str(a.diags[length(a.diags)].atEof), "TRUE");
    # The EOF class cannot be keyed on errorType: it also surfaces inside the
    # message of EXPECTED_SYMBOL. "no main yet" does have its own member though,
    # and an empty buffer -- the first state of a new file -- really reports it.
    a := analyzeText("", dirs);
    checkTrue("empty buffer is not silent", length(a.diags) <> 0);
    check("main-missing kind survives into the result",
          str(a.diags[length(a.diags)].errKind), "SYSTEM_MAIN_MISSING");
    a := analyzeText("$ include \"seed7_05.s7i\";\nconst proc: main is func\n  begin\n    writeln(\"ok\");\n  end func;\n", dirs);
    check("valid file is clean", str(length(a.diags)), "0");
    checkTrue("driver wraps a library", pos(driverFor(libPath), "include \"/tmp/seed7_lsp_probe.s7i\";") <> 0);

    # A library file is not analysable alone -- prove the synthetic driver works
    # against a real .s7i rather than only checking the text of the wrapper.  The
    # probe file lives under /tmp and is truncated by "w" on every run.
    out := open(libPath, "w");
    write(out, "const func integer: probeDouble (in integer: n) is\n  return n * 2;\n");
    close(out);
    a := analyzeText(driverFor(libPath), dirs);
    check("driver analyses a real .s7i cleanly", str(length(a.diags)), "0");
    a := analyzeText(driverFor("/tmp/seed7_lsp_missing.s7i"), dirs);
    checkTrue("missing include is reported", length(a.diags) <> 0);
    syms := analyzeSymbols(readAll(fixPath), dirs);
    checkTrue("fixture yields symbols", length(syms) <> 0);
    check("own struct is listed", symsNamed(syms, "Widget")[1].cat, "TYPEOBJECT");
    check("a buffer's own declarations carry the STRING file",
          symsNamed(syms, "Widget")[1].file, BUFFER_FILE);
    check("declaration line is 1-based", str(symsNamed(syms, "reportWidget")[1].line1), "19");
    checkTrue("signature shows a parameter type and name",
              pos(symsNamed(syms, "reportWidget")[1].sign, "integer: counter") <> 0);
    checkTrue("signature of a func names its result type",
              pos(symsNamed(syms, "totalSize")[1].sign, "func integer") <> 0);
    checkTrue("params are recorded without the self entry",
              str(length(symsNamed(syms, "totalSize")[1].params)) = "2");
    checkTrue("stdlib writeln is listed with an absolute path",
              startsWith(symsNamed(syms, "writeln")[1].file, "/"));
    checkTrue("nothing keeps the ? file", pos(allFiles(syms), "?") = 0);
    # Every `set of char' in the stdlib reports its type as a compiler marker rather than
    # a name; buildSign must not paste that marker into text the user reads.
    syms := analyzeSymbols("$ include \"seed7_05.s7i\";\n" <&
                             "const set of char: letters is {'a'};" <& chr(10), dirs);
    checkTrue("a marker type is not printed as a signature",
              pos(symsNamed(syms, "letters")[1].sign, "*") = 0);
    check("and the name still stands alone", symsNamed(syms, "letters")[1].sign, "letters");
    # the guard has to reach parameters too: `pos' takes a generic whose type reports a
    # marker rather than "set of char", and that text lands in every hover of it.
    # a generic parameter is what reports the marker -- `pos' takes a set whose type is
    # anonymous -- so the parameter has to be a set for this to reach the guard at all.
    syms := analyzeSymbols("$ include \"seed7_05.s7i\";\n" &
                           "const func integer: countSet (in set of char: chSet) is func\n" &
                           "  result\n    var integer: n is 0;\n  begin\n" &
                           "  end func;\n", dirs);
    checkTrue("a marker type on a parameter is not printed either",
              pos(symsNamed(syms, "countSet")[1].sign, "*") = 0);
    checkTrue("and the parameter is still named",
              pos(symsNamed(syms, "countSet")[1].sign, "chSet") <> 0);
    wlist := symsNamed(syms, "writeln");
    check("dedupe collapses identical (name,file,line) entries",
          str(countNameFile(syms, "writeln", wlist[1].file)),
          str(countDistinctLines(syms, "writeln", wlist[1].file)));
    # The reproduction for the rule AGENTS.md and spec §4.4 state. Two documents whose
    # character positions differ report the SAME column, because both escape sequences end
    # at the same byte: columnNumber is a count of UTF-8 bytes from the line start.
    a := analyzeText("$ include \"seed7_05.s7i\";\nconst string: s is \"ππ\\z\";\nconst proc: main is func begin noop; end func;\n", dirs);
    check("escape after two 2-byte chars reports byte column 26",
          str(a.diags[1].column1), "26");
    a := analyzeText("$ include \"seed7_05.s7i\";\nconst string: s is \"\128169;\\z\";\nconst proc: main is func begin noop; end func;\n", dirs);
    check("escape after one 4-byte char reports that same column at a different character",
          str(a.diags[1].column1), "26");
    a := analyzeText("$ include \"seed7_05.s7i\";\nconst proc: main is func\n" &
                     "  begin\n    writeln(1) writeln(2);\n  end func;\n", dirs);
    check("a token-level error names the byte after its token, not a character",
          str(a.diags[1].column1) <& "@line" <& str(a.diags[1].line1), "23@line4");
    check("an unanalysable buffer yields nothing",
          str(length(analyzeSymbols("", dirs))), "0");
    report("analysis");
  end func;
