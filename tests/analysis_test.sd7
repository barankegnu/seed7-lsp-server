$ include "seed7_05.s7i";
  include "stdio.s7i";
  include "filesys.s7i";
  include "osfiles.s7i";
  include "lsp_tst.sd7";
  include "analysis.sd7";


const type: lineSeen is hash [string] integer;

# the sign of a symbol, for assertions that a marker never reaches it
const func string: signatureOfText (in string: sign) is
  return sign;

const func string: readAll (in string: path) is func
  result
    var string: out is "";
  local
    var file: f is STD_NULL;
    var string: one is "";
  begin
    block
      f := open(path, "r");
      while not eof(f) do
        readln(f, one);
        out &:= one <& "\n";
      end while;
      close(f);
    exception
      catch FILE_ERROR:
        out := "";
    end block;
  end func;

const func array symRec: symsNamed (in array symRec: syms, in string: nm) is func
  result
    var array symRec: out is 0 times symRec.value;
  local
    var integer: i is 0;
  begin
    for i range 1 to length(syms) do
      if syms[i].name = nm then
        out &:= syms[i];
      end if;
    end for;
  end func;

const func string: allFiles (in array symRec: syms) is func
  result
    var string: out is "";
  local
    var integer: i is 0;
  begin
    for i range 1 to length(syms) do
      out &:= syms[i].file;
    end for;
  end func;

const func integer: countNameFile (in array symRec: syms, in string: nm,
                                   in string: fname) is func
  result
    var integer: out is 0;
  local
    var integer: i is 0;
  begin
    for i range 1 to length(syms) do
      if syms[i].name = nm and syms[i].file = fname then
        out +:= 1;
      end if;
    end for;
  end func;

const func integer: countDistinctLines (in array symRec: syms, in string: nm,
                                        in string: fname) is func
  result
    var integer: out is 0;
  local
    var lineSeen: seen is lineSeen.EMPTY_HASH;
    var string: keyStr is "";
    var integer: i is 0;
  begin
    for i range 1 to length(syms) do
      if syms[i].name = nm and syms[i].file = fname then
        keyStr := str(syms[i].line1);
        if keyStr not in seen then
          seen @:= [keyStr] 1;
          out +:= 1;
        end if;
      end if;
    end for;
  end func;

# Test-only. The analyzer’s error records are a third-party shape these checks characterise,
# so a release that stops reporting them reads as a FAIL, not an uncaught index. The
# string carries the raw error count, column, kind, line and message together, so one
# assertion covers a fixture and every dimension of it is visible in the diff.
const func string: diagPin (in analysisResult: a, in integer: i) is func
  result
    var string: out is "";
  begin
    if i >= 1 and length(a.diags) >= i then
      out := str(length(a.diags)) <& "|" <& str(a.diags[i].column1) <& "@" <&
             str(a.diags[i].errKind) <& "@line" <& str(a.diags[i].line1) <& "|" <&
             a.diags[i].message;
    else
      out := str(length(a.diags)) <& "|no diagnostic " <& str(i) <& " of " <&
             str(length(a.diags));
    end if;
  end func;

# Test-only narrowing. analyzeAll is production's only analysis entry point, so these checks
# characterise IT; reading one half of its result is a convenience for the assertions, not a
# second path the server can take. Each call costs one parseStri -- which is what analyzeText and
# analyzeSymbols used to cost between them, two.
const func analysisResult: parsedOf (in string: text, in array string: libraryDirs) is func
  result
    var analysisResult: out is analysisResult.value;
  local
    var docAnalysis: d is docAnalysis.value;
  begin
    d := analyzeAll(text, libraryDirs, "");
    out := d.parsed;
  end func;

const func array symRec: symsOf (in string: text, in array string: libraryDirs,
                                in string: docPath) is func
  result
    var array symRec: out is 0 times symRec.value;
  local
    var docAnalysis: d is docAnalysis.value;
  begin
    d := analyzeAll(text, libraryDirs, docPath);
    out := d.syms;
  end func;

# Test-only: one scope entry as a single string -- name, category and declaration line
# together, so a failing pin shows all three dimensions at once (the diagPin idiom).
const func string: scopePin (in array symRec: syms, in string: routineName,
                             in integer: i) is func
  result
    var string: out is "";
  local
    var array symRec: hits is 0 times symRec.value;
    var integer: n is 0;
  begin
    hits := symsNamed(syms, routineName);
    if length(hits) = 0 then
      out := "no symbol " <& routineName;
    else
      n := length(hits[1].locals);
      if i < 1 or i > n then
        out := "no entry " <& str(i) <& " of " <& str(n);
      else
        out := hits[1].locals[i].name <& "|" <& hits[1].locals[i].cat <& "|" <&
               str(hits[1].locals[i].line1);
      end if;
    end if;
  end func;

# Test-only: the first record of `nm' that reflection reports as a routine body. `writeln'
# is also listed as an ACTOBJECT, whose scope accessors raise, so only a BLOCKOBJECT can
# tell "the buffer-only guard is on" apart from "localsOf never fills anything".
const func symRec: libBlockNamed (in array symRec: syms, in string: nm) is func
  result
    var symRec: out is symRec.value;
  local
    var integer: i is 0;
    var boolean: found is FALSE;
  begin
    for i range 1 to length(syms) do
      if not found and syms[i].name = nm and syms[i].cat = "BLOCKOBJECT" then
        out := syms[i];
        found := TRUE;
      end if;
    end for;
  end func;

# Test-only: the scope invariant as ONE aggregate string, "filled|leaked". `filled' counts
# every record that carries a scope and `leaked' counts the records whose file is neither
# BUFFER_FILE nor the analysed document. The pair is the proof: a nonzero `filled' says the
# scope really was filled in this run, so the 0 in `leaked' is not an accident of a fixture
# that filled nothing. Aggregated over all records rather than pinned to one named record
# because a single library record's category or list order can make such an assertion pass
# for a reason unrelated to the rule.
const func string: scopeLeak (in array symRec: syms, in string: docPath) is func
  result
    var string: out is "";
  local
    var integer: filled is 0;
    var integer: leaked is 0;
    var integer: i is 0;
  begin
    for i range 1 to length(syms) do
      if length(syms[i].locals) <> 0 then
        filled +:= 1;
        if syms[i].file <> BUFFER_FILE and syms[i].file <> docPath then
          leaked +:= 1;
        end if;
      end if;
    end for;
    out := str(filled) <& "|" <& str(leaked);
  end func;

const proc: main is func
  local
    var analysisResult: a is analysisResult.value;
    var array string: dirs is 0 times "";
    var string: libPath is "/tmp/seed7_lsp_probe.s7i";
    var string: latePath is "/tmp/seed7_lsp_late.s7i";
    var string: lateFix is "";
    var array symRec: syms is 0 times symRec.value;
    var array symRec: wlist is 0 times symRec.value;
    var string: fixPath is "tests/programs/symbols.sd7";
    var string: scopeFix is "";
    var symRec: lib is symRec.value;
    var file: out is STD_NULL;
  begin
    # Empty libraryDirs is enough: the interpreter resolves its own stdlib,
    # so the test does not depend on where Seed7 happens to be installed.
    a := parsedOf("$ include \"seed7_05.s7i\";\nconst proc: main is func\n  begin\n    writeln(1 + \"a\");\n  end func;\n", dirs);
    check("semantic error count", str(length(a.diags)), "2");
    check("first error has no column", str(a.diags[1].column1), "0");
    check("not flagged as EOF", str(a.diags[1].atEof), "FALSE");
    a := parsedOf("$ include \"seed7_05.s7i\";\nconst proc: main is func\n  begin\n", dirs);
    check("truncated file has EOF class", str(a.diags[length(a.diags)].atEof), "TRUE");
    # The EOF class cannot be keyed on errorType: it also surfaces inside the
    # message of EXPECTED_SYMBOL. "no main yet" does have its own member though,
    # and an empty buffer -- the first state of a new file -- really reports it.
    a := parsedOf("", dirs);
    checkTrue("empty buffer is not silent", length(a.diags) <> 0);
    check("main-missing kind survives into the result",
          str(a.diags[length(a.diags)].errKind), "SYSTEM_MAIN_MISSING");
    a := parsedOf("$ include \"seed7_05.s7i\";\nconst proc: main is func\n  begin\n    writeln(\"ok\");\n  end func;\n", dirs);
    check("valid file is clean", str(length(a.diags)), "0");
    checkTrue("driver wraps a library", pos(driverFor(libPath), "include \"/tmp/seed7_lsp_probe.s7i\";") <> 0);

    # A library file is not analysable alone -- prove the synthetic driver works
    # against a real .s7i rather than only checking the text of the wrapper.  The
    # probe file lives under /tmp and is truncated by "w" on every run.
    out := open(libPath, "w");
    write(out, "const func integer: probeDouble (in integer: n) is\n  return n * 2;\n");
    close(out);
    a := parsedOf(driverFor(libPath), dirs);
    check("driver analyses a real .s7i cleanly", str(length(a.diags)), "0");
    a := parsedOf(driverFor("/tmp/seed7_lsp_missing.s7i"), dirs);
    checkTrue("missing include is reported", length(a.diags) <> 0);
    syms := symsOf(readAll(fixPath), dirs, "");
    checkTrue("fixture yields symbols", length(syms) <> 0);
    check("own struct is listed", symsNamed(syms, "Widget")[1].cat, "TYPEOBJECT");
    check("a buffer's own declarations carry the STRING file",
          symsNamed(syms, "Widget")[1].file, BUFFER_FILE);
    check("declaration line is 1-based", str(symsNamed(syms, "reportWidget")[1].line1), "19");
    checkTrue("signature shows a parameter type and name",
              pos(symsNamed(syms, "reportWidget")[1].sign, "integer: counter") <> 0);
    checkTrue("signature of a func names its result type",
              pos(symsNamed(syms, "totalSize")[1].sign, "func integer") <> 0);
    checkTrue("params are recorded without the self entry",
              str(length(symsNamed(syms, "totalSize")[1].params)) = "2");
    checkTrue("stdlib writeln is listed with an absolute path",
              startsWith(symsNamed(syms, "writeln")[1].file, "/"));
    # The buffer-only guard's two witnesses. A struct type has no scope at all -- its
    # accessors raise -- and a library routine body does have parameters, so this pair
    # shows `locals' is empty because of the guard and not because there was nothing to
    # fill. Deleting the guard makes the second check read 1, not 0.
    check("a TYPEOBJECT has no scope",
          str(length(symsNamed(syms, "Widget")[1].locals)), "0");
    lib := libBlockNamed(syms, "writeln");
    checkTrue("the library routine body has parameters to fill",
              length(lib.params) <> 0);
    check("a library routine's locals are not filled",
          str(length(lib.locals)), "0");
    checkTrue("nothing keeps the ? file", pos(allFiles(syms), "?") = 0);
    # Every `set of char' in the stdlib reports its type as a compiler marker rather than
    # a name; buildSign must not paste that marker into text the user reads.
    syms := symsOf("$ include \"seed7_05.s7i\";\n" <&
                             "const set of char: letters is {'a'};" <& chr(10), dirs, "");
    checkTrue("a marker type is not printed as a signature",
              pos(symsNamed(syms, "letters")[1].sign, "*") = 0);
    check("and the name still stands alone", symsNamed(syms, "letters")[1].sign, "letters");
    # the guard has to reach parameters too: `pos' takes a generic whose type reports a
    # marker rather than "set of char", and that text lands in every hover of it.
    # a generic parameter is what reports the marker -- `pos' takes a set whose type is
    # anonymous -- so the parameter has to be a set for this to reach the guard at all.
    syms := symsOf("$ include \"seed7_05.s7i\";\n" &
                           "const func integer: countSet (in set of char: chSet) is func\n" &
                           "  result\n    var integer: n is 0;\n  begin\n" &
                           "  end func;\n", dirs, "");
    checkTrue("a marker type on a parameter is not printed either",
              pos(symsNamed(syms, "countSet")[1].sign, "*") = 0);
    checkTrue("and the parameter is still named",
              pos(symsNamed(syms, "countSet")[1].sign, "chSet") <> 0);
    wlist := symsNamed(syms, "writeln");
    check("dedupe collapses identical (name,file,line) entries",
          str(countNameFile(syms, "writeln", wlist[1].file)),
          str(countDistinctLines(syms, "writeln", wlist[1].file)));
    # ---- M5 Task 2: the names inside a routine's scope -------------------------
    # The categories are the measured ones (s7 5.4.10), stored verbatim: a `const local'
    # reports the category of its VALUE -- INTOBJECT, STRIOBJECT -- and only a `var local'
    # answers LOCALVOBJECT. The total length is what proves all four lists are read: two
    # parameters, two local constants, one local variable, one result variable.
    scopeFix := "$ include \"seed7_05.s7i\";\n" &
        "const func integer: scopeProbe (in integer: p, in string: s) is func\n" &
        "  result\n    var integer: res is 0;\n" &
        "  local\n    const integer: ci is 1;\n    const string: cs is \"x\";\n" &
        "    var string: vs is \"\";\n" &
        "  begin\n    res := ci;\n  end func;\n" &
        "const proc: main is func\n" &
        "  local\n    var integer: count is 0;\n" &
        "  begin\n    writeln(count);\n  end func;\n";
    # Fixture hygiene: a buffer that fails to analyse makes the accessors raise for a
    # reason unrelated to the rule being pinned, so prove the fixture clean first.
    a := parsedOf(scopeFix, dirs);
    check("the scope fixture analyses clean", str(length(a.diags)), "0");
    syms := symsOf(scopeFix, dirs, "");
    check("main is listed once", str(length(symsNamed(syms, "main"))), "1");
    check("the scope is params, consts, vars, result",
          str(length(symsNamed(syms, "scopeProbe")[1].locals)), "6");
    check("scope 1: a value parameter names itself",
          scopePin(syms, "scopeProbe", 1), "p|VALUEPARAMOBJECT|2");
    check("scope 2: a ref parameter keeps its own category",
          scopePin(syms, "scopeProbe", 2), "s|REFPARAMOBJECT|2");
    check("scope 3: a const local is its value's category",
          scopePin(syms, "scopeProbe", 3), "ci|INTOBJECT|6");
    check("scope 4: a string const local likewise",
          scopePin(syms, "scopeProbe", 4), "cs|STRIOBJECT|7");
    check("scope 5: a var local is LOCALVOBJECT",
          scopePin(syms, "scopeProbe", 5), "vs|LOCALVOBJECT|8");
    check("scope 6: the result variable is RESULTOBJECT",
          scopePin(syms, "scopeProbe", 6), "res|RESULTOBJECT|4");
    # A proc has no result variable: resultVar answers the null reference, whose line() and
    # category() raise. Reading it anyway empties the whole scope through the guard.
    check("a proc lists only its own local",
          str(length(symsNamed(syms, "main")[1].locals)), "1");
    check("the local shadows the library name and carries its own line",
          scopePin(syms, "main", 1), "count|LOCALVOBJECT|14");
    # An .s7i document is analysed through the synthetic driver, so its declarations report
    # the FILE path rather than BUFFER_FILE. docPath is what fills their scope.
    syms := symsOf(driverFor(libPath), dirs, libPath);
    check("the document's own path fills the scope",
          scopePin(syms, "probeDouble", 1), "n|VALUEPARAMOBJECT|1");
    syms := symsOf(driverFor(libPath), dirs, "");
    check("without docPath those same declarations stay unfilled",
          str(length(symsNamed(syms, "probeDouble")[1].locals)), "0");
    # `rec' in collectSyms is loop-carried, so a library record that follows a filled
    # buffer record inherits that routine's scope unless the non-buffer path resets the
    # field. The witness is a LATE-LOADED include placed after a buffer declaration: the
    # order matters -- a library resolved before any buffer declaration leaks nothing, and
    # so does one seed7_05.s7i has already loaded. The late library file is written here
    # rather than taken from the stdlib, because which stdlib files are pre-loaded is an
    # interpreter detail that would turn this witness into a silent vacuous pass.
    out := open(latePath, "w");
    write(out, "$ include \"seed7_05.s7i\";\n" &
               "const proc: lateShow is func\n" &
               "  local\n" &
               "    var integer: lateLocal is 0;\n" &
               "  begin\n" &
               "    writeln(lateLocal);\n" &
               "  end func;\n");
    close(out);
    lateFix := "$ include \"seed7_05.s7i\";\n" &
               "const proc: bufferShow is func\n" &
               "  local\n" &
               "    var integer: phantomName is 0;\n" &
               "  begin\n" &
               "    writeln(phantomName);\n" &
               "  end func;\n" &
               "  $ include " <& literal(latePath) <& ";\n" &
               "const proc: main is func\n" &
               "  begin\n" &
               "    writeln(1);\n" &
               "  end func;\n";
    a := parsedOf(lateFix, dirs);
    check("the late-include fixture analyses clean", str(length(a.diags)), "0");
    syms := symsOf(lateFix, dirs, "");
    # filled 1 is `bufferShow' alone -- `main' declares no scope -- and no foreign record
    # may carry one. Reverting the reset in the non-buffer path reads 2|1.
    check("a late-loaded library record inherits no buffer scope",
          scopeLeak(syms, ""), "1|0");
    # The reproduction for the rule AGENTS.md and spec §4.4 state. Two documents whose
    # character positions differ report the SAME column, because both escape sequences end
    # at the same byte: columnNumber is a count of UTF-8 bytes from the line start.
    a := parsedOf("$ include \"seed7_05.s7i\";\nconst string: s is \"ππ\\z\";\nconst proc: main is func begin noop; end func;\n", dirs);
    check("escape after two 2-byte chars: one diagnostic at byte column 26",
          diagPin(a, 1), "1|26@ILLEGAL_STRING_ESCAPE@line2|Illegal string escape \"\\z\"");
    a := parsedOf("$ include \"seed7_05.s7i\";\nconst string: s is \"\128169;\\z\";\nconst proc: main is func begin noop; end func;\n", dirs);
    check("escape after one 4-byte char: same column at a different character",
          diagPin(a, 1), "1|26@ILLEGAL_STRING_ESCAPE@line2|Illegal string escape \"\\z\"");
    a := parsedOf("$ include \"seed7_05.s7i\";\nconst proc: main is func\n" &
                     "  begin\n    writeln(1) writeln(2);\n  end func;\n", dirs);
    check("a token-level error names the position just after its token",
          diagPin(a, 1),
          "7|23@EXPECTED_SYMBOL@line4|\"end\" expected found \"writeln\"");
    check("an unanalysable buffer yields nothing",
          str(length(symsOf("", dirs, ""))), "0");
    report("analysis");
  end func;
