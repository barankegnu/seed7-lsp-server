$ include "seed7_05.s7i";
  include "lsp_tst.sd7";
  include "uris.sd7";

const proc: main is func
  begin
    check("space decoded",  pathOf("file:///tmp/my%20dir/a.sd7"), "/tmp/my dir/a.sd7");
    check("plain uri kept", pathOf("/tmp/a.sd7"), "/tmp/a.sd7");
    check("uriFor escapes what would break a uri",
          uriFor("/tmp/a b/c#d.sd7"), "file:///tmp/a%20b/c%23d.sd7");
    check("uriFor leaves an ordinary path verbatim",
          uriFor("/home/user/seed7/lib/console.s7i"),
          "file:///home/user/seed7/lib/console.s7i");
    check("uriFor round-trips through pathOf",
          pathOf(uriFor("/tmp/a b/x.sd7")), "/tmp/a b/x.sd7");
    check("uriFor round-trips non-ascii",
          pathOf(uriFor("/tmp/日本/x.sd7")), "/tmp/日本/x.sd7");
    check("a child of a declared root is under it",
          str(underRoot("/tmp/root/a/b.sd7", []("/tmp/root"))), "TRUE");
    check("the root itself is under it",
          str(underRoot("/tmp/root", []("/tmp/root"))), "TRUE");
    check("a trailing slash on the root changes nothing",
          str(underRoot("/tmp/root/a.sd7", []("/tmp/root/"))), "TRUE");
    check("a sibling whose name starts with the root is NOT under it",
          str(underRoot("/tmp/root2/a.sd7", []("/tmp/root"))), "FALSE");
    check("no roots means nothing is contained",
          str(underRoot("/tmp/root/a.sd7", 0 times "")), "FALSE");
    check("decoded path matches decoded root",
          str(underRoot(pathOf("file:///tmp/my%20dir/a.sd7"), []("/tmp/my dir"))), "TRUE");
    report("uris");
  end func;
