$ include "seed7_05.s7i";
  include "lsp_tst.sd7";
  include "scan.sd7";

const func string: kindName (in integer: kind) is func
  result
    var string: out is "?";
  begin
    if kind = TK_NAME then
      out := "name";
    elsif kind = TK_OP then
      out := "op";
    elsif kind = TK_BRACKET then
      out := "bracket";
    elsif kind = TK_NUMBER then
      out := "number";
    elsif kind = TK_STRING then
      out := "string";
    elsif kind = TK_CHAR then
      out := "char";
    elsif kind = TK_COMMENT then
      out := "comment";
    elsif kind = TK_LINE_COMMENT then
      out := "lineComment";
    else
      out := "illegal";
    end if;
  end func;

# ASCII-only views of a scan, for the fixtures that involve non-ASCII characters. A check whose
# got or expected string contains an astral character raises RANGE_ERROR in writeln and the suite
# dies without a graded line -- which reads as a broken rule rather than a broken print.
const func integer: firstKindOf (in string: text) is func
  result
    var integer: out is -1;
  local
    var scanCursor: cur is scanCursor.value;
    var tok: tk is tok.value;
  begin
    skipWhitespace(text, cur);
    if cur.offset <= length(text) then
      tk := nextToken(text, cur);
      out := tk.kind;
    end if;
  end func;

const func integer: firstWidthOf (in string: text) is func
  result
    var integer: out is -1;
  local
    var scanCursor: cur is scanCursor.value;
    var tok: tk is tok.value;
  begin
    skipWhitespace(text, cur);
    if cur.offset <= length(text) then
      tk := nextToken(text, cur);
      out := tk.width16;
    end if;
  end func;

# The column of the token covering UTF-16 unit `col16` of line 0, or -1. Linear: a test helper
# does not need tokenAt, which only arrives with Task 8.
const func integer: tokenColOf (in string: text, in integer: col16) is func
  result
    var integer: out is -1;
  local
    var scanCursor: cur is scanCursor.value;
    var tok: tk is tok.value;
    var boolean: more is TRUE;
  begin
    while more and cur.offset <= length(text) do
      skipWhitespace(text, cur);
      if cur.offset > length(text) then
        more := FALSE;
      else
        tk := nextToken(text, cur);
        if tk.col16 <= col16 and col16 <= tk.col16 + tk.width16 then
          out := tk.col16;
          more := FALSE;
        end if;
      end if;
    end while;
  end func;

# "line0:col16" for every token, joined by " ". The three line-ending fixtures below hold the
# same five tokens and differ only in how their lines end, so their strings must be equal.
const func string: positionsOf (in string: text) is func
  result
    var string: out is "";
  local
    var scanCursor: cur is scanCursor.value;
    var tok: tk is tok.value;
  begin
    while cur.offset <= length(text) do
      skipWhitespace(text, cur);
      if cur.offset > length(text) then
      else
        tk := nextToken(text, cur);
        if out <> "" then
          out := out & " ";
        end if;
        out := out & str(tk.line0) & ":" & str(tk.col16);
      end if;
    end while;
  end func;

# "kind line:col:width [text]" joined by " | " -- the shape every check below pins.
const func string: kindsOf (in string: text) is func
  result
    var string: out is "";
  local
    var scanCursor: cur is scanCursor.value;
    var tok: tk is tok.value;
    var string: piece is "";
  begin
    while cur.offset <= length(text) do
      skipWhitespace(text, cur);
      if cur.offset > length(text) then
      else
        tk := nextToken(text, cur);
        piece := kindName(tk.kind) & " " & str(tk.line0) & ":" & str(tk.col16) & ":" &
                 str(tk.width16) & " [" & text[tk.start .. tk.stop] & "]";
        if out <> "" then
          out := out & " | ";
        end if;
        out := out & piece;
      end if;
    end while;
  end func;

const proc: main is func
  begin
    check("name, op, bracket",
          kindsOf("a := (b)"),
          "name 0:0:1 [a] | op 0:2:2 [:=] | bracket 0:5:1 [(] | name 0:6:1 [b] " &
          "| bracket 0:7:1 [)]");
    check("an operator run is maximal, brackets cut it",
          kindsOf("c<&d[e]"),
          "name 0:0:1 [c] | op 0:1:2 [<&] | name 0:3:1 [d] | bracket 0:4:1 [[] " &
          "| name 0:5:1 [e] | bracket 0:6:1 []]");
    check("a '<' does not absorb the name after it",
          kindsOf("if a<b then"),
          "name 0:0:2 [if] | name 0:3:1 [a] | op 0:4:1 [<] | name 0:5:1 [b] " &
          "| name 0:7:4 [then]");
    check("a name may start with an underscore",
          kindsOf("_end x5"),
          "name 0:0:4 [_end] | name 0:5:2 [x5]");
    # An astral character must never reach a check's expected or got string: lsp_tst prints with
    # writeln on plain stdout, which raises RANGE_ERROR on non-ASCII. Assert the numbers instead
    # -- that is all "counts UTF-16 units, not characters" actually claims.
    check("an astral character is one illegal token two units wide",
          str(firstKindOf("\128169;")) & "/" & str(firstWidthOf("\128169;")),
          str(TK_ILLEGAL) & "/2");
    # The old expectation here asked for unit 2, but the space occupies unit 2: the astral
    # character covers units 0-1 and the name sits at 3. Querying 2 resolves to the illegal token
    # that ENDS there -- the left-of-character rule doc_store.wordAt uses -- so 3 is the unit that
    # names the token after it. If the astral character counted as one unit, 'a' would sit at 2.
    check("the name after an astral character and a space sits at unit 3",
          str(tokenColOf("\128169; a", 3)), "3");
    check("a newline resets line and column",
          kindsOf("a\n  b"),
          "name 0:0:1 [a] | name 1:2:1 [b]");
    check("an unknown character is one illegal token and advances",
          kindsOf("a " & "\8;" & " b"),
          "name 0:0:1 [a] | illegal 0:2:1 [" & "\8;" & "] | name 0:4:1 [b]");
    # a control character prints nothing, so the check above cannot be reviewed by eye; this one
    # asserts the shape that matters -- that exactly one token was produced and it advanced.
    checkTrue("an illegal token is one character wide",
              length(kindsOf("\8;\8;")) > 0 and
              kindsOf("\8;\8;") = "illegal 0:0:1 [\8;] | illegal 0:1:1 [\8;]");
    # The line-ending trio. doc_store.lineStarts counts '\n', a lone '\r' and a '\r\n' pair each
    # as ONE break, so all three fixtures below have line starts at 1, at the 'c' and at the ' '
    # before 'd' -- which puts a/:=/b on line 0 at columns 0/2/5, c on line 1 at column 0 and d on
    # line 2 at column 1. Each fixture names its own mutation: the LF one the '\n' arm, the CR one
    # a missing '\r' arm (with '\r' merely blank, 'c' lands at 0:7), the CRLF one a '\r\n' counted
    # as two breaks (with the lookahead gone, 'c' lands at 2:0). The CR fixture ends in a lone
    # '\r', which is what reaches the 'cur.offset < length(text)' bound guard: without it the
    # lookahead indexes past the end and the suite dies without a graded line.
    check("an LF document puts its tokens on lines 0, 1 and 2",
          positionsOf("a := b\nc\n d"), "0:0 0:2 0:5 1:0 2:1");
    check("a CRLF document gives the same lines and columns",
          positionsOf("a := b\r\nc\r\n d"), "0:0 0:2 0:5 1:0 2:1");
    check("a lone-CR document gives the same lines and columns",
          positionsOf("a := b\rc\r d\r"), "0:0 0:2 0:5 1:0 2:1");
    check("integer, bigInteger, based, float, exponent",
          kindsOf("12345 12345_ 16#beef 2#0001_ 12.3e-4 1e+3"),
          "number 0:0:5 [12345] | number 0:6:6 [12345_] | number 0:13:7 [16#beef] " &
          "| number 0:21:7 [2#0001_] | number 0:29:7 [12.3e-4] | number 0:37:4 [1e+3]");
    check("a range is number, op, number",
          kindsOf("1 .. 5"),
          "number 0:0:1 [1] | op 0:2:2 [..] | number 0:5:1 [5]");
    # The same range with no spaces at all, which is the different path through pastNumber that
    # the fixture above cannot reach: there the '.' is never the character a digit-run stops at.
    # Deleting the 'a digit must follow the dot' test would make this one number, not three.
    check("a range glued to its dots is number, op, number",
          kindsOf("1..5"),
          "number 0:0:1 [1] | op 0:1:2 [..] | number 0:3:1 [5]");
    # 37#0 is rejected by the ANALYZER for its base; the scanner still owes it one number token,
    # because lit_number's shape is not the scanner's business and semanticTokens colours it.
    check("an invalid base is still one number token",
          kindsOf("37#0"),
          "number 0:0:4 [37#0]");
    # The dots sit against the digits on purpose. With a space on either side -- "1 . 5" -- the
    # float arm is never reached, so no change to its 'a digit must follow' test could fail this
    # check. ".5" holds the other half of the rule: a dot with no digit BEFORE it is an operator,
    # because the number arm only opens on a digit.
    check("a dot needs a digit on each side to be a float",
          kindsOf("1. 5 .5"),
          "number 0:0:1 [1] | op 0:1:1 [.] | number 0:3:1 [5] | op 0:5:1 [.] | number 0:6:1 [5]");
    # The hash rule, pinned as a width rather than through kindsOf: '#' becomes a lineComment
    # token only in Task 6, and "16#" is the bound guard (a hash at EOF). The '# has to touch the
    # digits for any of this to discriminate -- pastNumber stops scanning at the space in "5 # x",
    # so a separated hash could not tell the extDigit test from its absence.
    check("a hash extends a number only when an extended digit follows it",
          str(firstWidthOf("5# x")) & "/" & str(firstWidthOf("16#")) & "/" &
          str(firstWidthOf("2#0f")) & "/" & str(firstWidthOf("2#0_")),
          "1/2/4/4");
    check("an e that starts no exponent ends the number",
          kindsOf("1e; 2"),
          "number 0:0:1 [1] | name 0:1:1 [e] | op 0:2:1 [;] | number 0:4:1 [2]");
    # ---- strings ---------------------------------------------------------------
    # The fixture holds real backslashes: Seed7 reads '\\' as one backslash, so the scanned text
    # is the nine characters " a \ n \ 9 ; b " -- an escape pair and a numeric escape that must
    # not end the string, which is what the name says.
    check("escapes do not end a string",
          kindsOf("\"a\\n\\9;b\""),
          "string 0:0:9 [\"a\\n\\9;b\"]");
    check("a based numeric escape is one token",
          kindsOf("\"\\16#ff;\""),
          "string 0:0:9 [\"\\16#ff;\"]");
    # Two quantities, deliberately different. width16 is 4 because that is what the token occupies
    # on the line it STARTS on: '"', 'a', 'b' and the continuation's opening backslash. The ';' is
    # at line 1 column 12 because the cursor keeps counting every line of the span even though the
    # width stopped: eight spaces (0-7), the closing backslash (8), 'c' (9), 'd' (10), the
    # terminating '"' (11). A ';' measured at 3 is a cursor that stopped counting with the width.
    check("a continuation crosses the newline and stays one token",
          kindsOf("\"ab\\\n        \\cd\";"),
          "string 0:0:4 [\"ab\\\n        \\cd\"] | op 1:12:1 [;]");
    check("an unterminated string ends at EOF and raises nothing",
          kindsOf("const string: s is \"abc"),
          "name 0:0:5 [const] | name 0:6:6 [string] | op 0:12:1 [:] | name 0:14:1 [s] " &
          "| name 0:16:2 [is] | string 0:19:4 [\"abc]");
    # same reason as Task 2's astral checks: the character stays out of the printed strings
    check("an astral character inside a string counts two units",
          str(firstWidthOf("\"x\128169;y\"")), "6");
    # A bare break is STRING_EXCEEDS for the analyzer, so the token ends at its line and the
    # newline is left for the caller's skipWhitespace: 'cd' is code again, which is the only way
    # the rest of a typed-out document keeps honest columns.
    check("a bare newline ends the string token on its own line",
          kindsOf("\"ab\ncd\""),
          "string 0:0:3 [\"ab] | name 1:0:2 [cd] | string 1:2:1 [\"]");
    # The line model of a span is doc_store.lineStarts', the one skipWhitespace uses: '\n', a lone
    # '\r' and a '\r\n' pair each count as ONE break, so all three fixtures put ';' on line 1 at
    # column 12. The CR and CRLF cases name the two mutations of the break arm separately: a
    # missing '\r' arm leaves ';' on line 0, a missing lookahead puts it on line 2.
    check("a continuation gives the same positions under LF, CRLF and CR",
          positionsOf("\"ab\\\n        \\cd\";") & "/" &
          positionsOf("\"ab\\\r\n        \\cd\";") & "/" &
          positionsOf("\"ab\\\r        \\cd\";"),
          "0:0 1:12/0:0 1:12/0:0 1:12");
    # manual/tokens.htm 10.3.4 lets a '#'-comment sit between the two backslashes, and its text
    # may hold a double quote -- which is why the ignored region cannot simply run to the next
    # quote.
    check("a '#'-comment inside the continuation region does not end the string",
          kindsOf("\"ab\\ # says \"x\"\n   \\cd\";"),
          "string 0:0:15 [\"ab\\ # says \"x\"\n   \\cd\"] | op 1:7:1 [;]");
    # skip_lines runs over ANY number of blank lines, so the span can be three lines long -- and
    # each break resets cur.col16 the same way, so ';' lands at line 2 column 7 (3 spaces 0-2, the
    # closing backslash 3, 'c' 4, 'd' 5, the terminating '"' 6).
    check("two blank lines inside the continuation still leave one token",
          kindsOf("\"ab\\\n\n   \\cd\";"),
          "string 0:0:4 [\"ab\\\n\n   \\cd\"] | op 2:7:1 [;]");
    # Two strings on one line is what a document actually looks like, and it is the case the body
    # loop's stop-at-the-closing-quote test earns its keep for: drop that test and the quote is
    # consumed as a body character, taking the rest of the line with it.
    check("a quote ends its string, so the next one starts a new token",
          kindsOf("\"a\" & \"b\""),
          "string 0:0:3 [\"a\"] | op 0:4:1 [&] | string 0:6:3 [\"b\"]");
    # pastEscape's contract, pinned directly. Inside a string body the ';' of a numeric escape is
    # just another body character, so NO kindsOf fixture can tell whether pastEscape swallowed it --
    # the widths come out the same either way. What the function owes its callers is the index, and
    # the char-literal arm that follows needs exactly that. The last term is the deleted branch: a
    # continuation now leaves pastEscape at its own one-character arm, so it stops AT the closing
    # backslash (3) instead of running the region (4) -- which is the duplication this check keeps
    # from creeping back, and the region's real rules are asserted by the checks above.
    check("pastEscape lands just past the escape body",
          str(pastEscape("\\9;x", 1)) & "/" & str(pastEscape("\\16#ff;", 1)) & "/" &
          str(pastEscape("\\nx", 1)) & "/" & str(pastEscape("\\ \\", 1)),
          "4/8/3/3");
    # Minor #1: the hand-off across MORE than one break, with content on the lines in between.
    # width16 stays 4 ('"', 'a', 'b', the opening backslash); each break restarts cur.col16 from
    # 0 - units, so the two comment lines -- 8 columns each, counted on their own line and then
    # abandoned -- cannot leak into line 3, where 3 spaces (0-2), the closing backslash (3), 'c' (4),
    # 'd' (5) and the terminating '"' (6) put ';' at 7. Get the reset wrong (carry the old column
    # instead of starting from 0 - units) and this is the check that says so.
    check("two commented lines inside the continuation still put ';' at the derived column",
          kindsOf("\"ab\\\n   # one\n   # two\n   \\cd\";"),
          "string 0:0:4 [\"ab\\\n   # one\n   # two\n   \\cd\"] | op 3:7:1 [;]");
    # ---- char literals -------------------------------------------------------
    check("the five char spellings and their widths",
          kindsOf("'a' ''' '\\n' '\\9;' '\\16#ff;'"),
          "char 0:0:3 ['a'] | char 0:4:3 ['''] | char 0:8:4 ['\\n'] " &
          "| char 0:13:5 ['\\9;'] | char 0:19:9 ['\\16#ff;']");
    check("a double quote is ordinary char-literal content",
          kindsOf("'\"'"),
          "char 0:0:3 ['\"']");
    check("the name after a numeric-escape char literal is still code",
          kindsOf("const char: q is '\\9;'; const integer: afterThis is 1;"),
          "name 0:0:5 [const] | name 0:6:4 [char] | op 0:10:1 [:] | name 0:12:1 [q] " &
          "| name 0:14:2 [is] | char 0:17:5 ['\\9;'] | op 0:22:1 [;] " &
          "| name 0:24:5 [const] | name 0:30:7 [integer] | op 0:37:1 [:] " &
          "| name 0:39:9 [afterThis] | name 0:49:2 [is] | number 0:52:1 [1] | op 0:53:1 [;]");
    # The hole README describes is about what follows the closing quote, and a char literal that
    # never gets one is the same case while typing. lit_char refuses a line break as its element
    # AND as its closing quote (CHAR_EXCEEDS, "Character literal exceeds source line"), so the
    # token ends AT its line and skipWhitespace takes the break. Follow the break instead and every
    # later token of the document reports line 0 -- which is what these two checks measure: the
    # line of the name that FOLLOWS, not just the width of the literal.
    check("a bare newline ends an unterminated char literal on its own line",
          kindsOf("x := '\nwriteln(1);"),
          "name 0:0:1 [x] | op 0:2:2 [:=] | char 0:5:1 ['] | name 1:0:7 [writeln] " &
          "| bracket 1:7:1 [(] | number 1:8:1 [1] | bracket 1:9:1 [)] | op 1:10:1 [;]");
    # The backslash form reaches pastEscape, whose one-character arm would otherwise read the
    # newline as the escape's body and land the closing-quote test on the NEXT line.
    check("a lone backslash at the end of a line does not take the line with it",
          kindsOf("x := '\\\nwriteln(1);"),
          "name 0:0:1 [x] | op 0:2:2 [:=] | char 0:5:2 ['\\] | name 1:0:7 [writeln] " &
          "| bracket 1:7:1 [(] | number 1:8:1 [1] | bracket 1:9:1 [)] | op 1:10:1 [;]");
    # The bound term of the escape arm's condition. '\\' at the very end of the buffer is what a
    # user has typed before the second backslash of a continuation arrives, and indexing past the
    # end there would raise RANGE_ERROR inside the suite (no graded line) rather than print a FAIL.
    check("a lone backslash at end of buffer is one char token and raises nothing",
          kindsOf("x := '\\"),
          "name 0:0:1 [x] | op 0:2:2 [:=] | char 0:5:2 ['\\]");
    # ---- comments ----------------------------------------------------------
    check("comments nest",
          kindsOf("(* a (* b *) c *)"),
          "comment 0:0:17 [(* a (* b *) c *)]");
    # The token ends at the OUTER '*)' and the text after it is code again. 'comments nest' cannot
    # see this: its comment runs to the end of the fixture either way, so without this check a close
    # that never decrements is invisible.
    check("the outer '*)' ends the comment, and what follows is code",
          kindsOf("(* a (* b *) *) writeln(1);"),
          "comment 0:0:15 [(* a (* b *) *)] | name 0:16:7 [writeln] | bracket 0:23:1 [(] " &
          "| number 0:24:1 [1] | bracket 0:25:1 [)] | op 0:26:1 [;]");
    check("a multi-line comment reports its first line only",
          kindsOf("(* one\n   two *)"),
          "comment 0:0:6 [(* one\n   two *)]");
    check("the line comment starts at the hash and stops before the newline",
          kindsOf("x := 1; # trailing\ny := 2;"),
          "name 0:0:1 [x] | op 0:2:2 [:=] | number 0:5:1 [1] | op 0:6:1 [;] " &
          "| lineComment 0:8:10 [# trailing] | name 1:0:1 [y] | op 1:2:2 [:=] " &
          "| number 1:5:1 [2] | op 1:6:1 [;]");
    check("an unclosed comment ends at EOF and raises nothing",
          kindsOf("(* unclosed\nmore;"),
          "comment 0:0:11 [(* unclosed\nmore;]");
    # The width, not kindsOf, so the '\r' never reaches a printed string. Three units is "# c": a
    # lone CR ends the comment because lineEnd -- not '\n' alone -- is this server's line model
    # (doc_store.lineStarts), the same one the line-ending trio above holds every other arm to.
    # A '\n'-only test reports four, having taken the CR into the comment.
    check("a lone CR ends a line comment",
          str(firstWidthOf("# c\r\ny")), "3");
    check("a comment cannot open inside a string",
          kindsOf("\"(* not a comment *)\" writeln(1);"),
          "string 0:0:21 [\"(* not a comment *)\"] | name 0:22:7 [writeln] " &
          "| bracket 0:29:1 [(] | number 0:30:1 [1] | bracket 0:31:1 [)] | op 0:32:1 [;]");
    # The astral fixtures print numbers only, for the same reason as the ones above: a printed
    # astral character kills the suite in writeln before the total line.
    check("an astral character inside a comment counts two units",
          str(firstWidthOf("(* \128169; *)")), "8");
    # Two quantities at once: width16 is the four units of line 0, while the cursor is at unit 6
    # for 'x' -- the astral character (0-1), a space (2), '*)' (3-4) and a space (5).
    check("a multi-line comment with an astral character on its second line leaves an honest column",
          positionsOf("(* a\n\128169; *) x"), "0:0 1:6");
    # The two pair tests' bound guards, and both fixtures are typing states. Without the guard on
    # the close, a '*' as the last character of the buffer indexes past the end; without the guard
    # on the opener, a lone '(' does. Either RANGE_ERROR would reach stdout, which corrupts the
    # protocol channel and leaves the suite without a graded line -- so these are the only proof
    # those two terms can have, as Task 5 established for the char arm's guard.
    check("a comment whose last character is its own '*' is unclosed, not a raise",
          kindsOf("(* note *"),
          "comment 0:0:9 [(* note *]");
    check("a lone '(' at end of buffer is one bracket token and raises nothing",
          kindsOf("x : ("),
          "name 0:0:1 [x] | op 0:2:1 [:] | bracket 0:4:1 [(]");
    # ---- mask ---------------------------------------------------------------
    # The mask is a projection of the scan: same length as the text, newlines preserved,
    # every non-code character a space. These fixtures pin the exact output of maskOf so
    # that doc_store's codeText contract -- and the three holes the old machine had --
    # are enforced from the scanner side.
    # measured: len 22/22  a_:=______;_________b$NL
    check("the mask keeps length and newlines and blanks the literals",
          maskOf("a := \"x\ty\"; (* c *) b\n"),
          "a :=      ;         b\n");
    # the literal '\9;' is FIVE characters; the old fixed-count machine masked seven, which is
    # the hole README records. measured: len 54/54
    #   const_char:_q_is______;_const_integer:_afterThis_is_1;
    check("a numeric-escape char literal masks exactly itself",
          maskOf("const char: q is '\\9;'; const integer: afterThis is 1;"),
          "const char: q is      ; const integer: afterThis is 1;");
    # a based literal is code and survives; only the comment goes.
    # measured: len 43/43  const_integer:_c_is_16#beef;_______$NLx_:=_1;
    check("a based literal is code, its comment tail is not",
          maskOf("const integer: c is 16#beef; # tail\nx := 1;"),
          "const integer: c is 16#beef;       \nx := 1;");
    check("length never changes",
          str(length(maskOf("s := \"a\\\"b\"; # c\n"))),
          "17");
    # The three ordering fixtures: a projection is where the scanner's token ordering
    # becomes load-bearing for the mask. Each names the mutation that would break it.
    # A ')' after '*' inside a line comment must not close a block comment that was
    # never opened; dropping the 'line comment wins over block-comment close' rule
    # would leave the '\n' and 'x' masked.
    check("'*)' inside a line comment does not open or close a block comment",
          maskOf("# *)\nx"),
          "    \nx");
    # A '#' inside a block comment is just comment text; without the 'block comment
    # wins over line comment' rule the scanner would end the comment at the newline
    # and the '*)' would be code.
    check("'#' inside a block comment is just comment text",
          maskOf("(* # *)\nx"),
          "       \nx");
    # A bare '(*' at EOF is one unclosed comment token whose stop is length(text);
    # without the 'unclosed runs to EOF' rule the mask would leave the '(' visible.
    check("a bare '(*' at EOF masks to the end of the buffer",
          maskOf("x (*"),
          "x   ");
    # All four hidden kinds in one document: a nested comment, a string, a char literal with a
    # numeric escape and a line comment. Only the three spaces between them and the final
    # newline survive, so this is the check that goes red if any one kind stops being hidden.
    # The plan's table counts this fixture 33/33; measured it is 32 characters.
    # measured: len 32/32  _______________________________$NL
    check("every hidden kind at once, and only they are blanked",
          maskOf("(* a (* b *) c *) \"x\" '\\9;' # c\n"),
          "                               \n");
    # A truncated buffer is the normal state while typing and the mask runs on every request
    # path, so an unterminated string, char literal or comment must end at EOF: no raise -- one
    # reaching stdout corrupts the protocol channel -- and no loop that never terminates.
    # measured: s_:=_____ (9/9), x_:=___ (7/7), _______________ (15/15)
    check("an unterminated construct at EOF masks to the end and raises nothing",
          maskOf("s := \"abc") & "/" & maskOf("x := 'a") & "/" & maskOf("(* never closed"),
          "s :=     /x :=   /               ");
    # maskOf's own bounds. skipWhitespace may walk the cursor PAST the end of the text and
    # nextToken is only defined with a character under the cursor: delete the guard after
    # skipWhitespace and this fixture dies with INDEX_ERROR -- no graded line, which is how a
    # raise shows up here -- rather than printing a FAIL. The empty document is the while bound.
    check("a buffer of nothing but whitespace masks to itself",
          maskOf("   ") & "/" & str(length(maskOf(""))), "   /0");
    # The tail append, which is what keeps a line break that no token covers: drop the copy of
    # text[copied .. length(text)] and the mask loses the newline, which shifts every later line
    # of a document that has one.
    # measured: len 8/8  x_:=_1;$NL
    check("a document that is pure code masks to itself, trailing newline included",
          maskOf("x := 1;\n"),
          "x := 1;\n");

    report("scan");
  end func;
