$ include "seed7_05.s7i";
  include "lsp_tst.sd7";
  include "features/document_symbol.sd7";
  include "features/definition.sd7";
  include "features/hover.sd7";
  include "features/completion.sd7";
  include "features/signature_help.sd7";
  include "occurrences.sd7";
  include "features/references.sd7";
  include "features/prepare_rename.sd7";
  include "features/rename.sd7";

const func string: calleeAt (inout lsDoc: d, in string: text, in integer: character0,
                             inout integer: active) is func
  result
    var string: out is "";
  begin
    setVersion(d, text, 1);
    out := callContextOf(d, 0, character0, active);
  end func;

const func array symRec: ownLastSyms is func
  result
    var array symRec: out is 0 times symRec.value;
  local
    var symRec: rec is symRec.value;
    var integer: k is 0;
  begin
    # 200 library symbols first (globalObjects order), the document's own last:
    # a cap of 100 must not decide that the user's names are invisible.
    rec.cat := "TYPEOBJECT"; rec.ty := "type";
    for k range 1 to 200 do
      rec.name := "lib" <& str(k);
      rec.file := "/home/user/seed7/lib/stdlib.s7i";
      rec.line1 := k;
      rec.sign := "const type: " <& rec.name;
      out &:= rec;
    end for;
    rec.name := "myOwnName"; rec.cat := "STRUCTOBJECT"; rec.ty := "Widget";
    rec.file := BUFFER_FILE; rec.line1 := 3; rec.sign := "const Widget: myOwnName";
    out &:= rec;
    rec.name := "."; rec.cat := "TYPEOBJECT"; rec.ty := "type";
    rec.file := BUFFER_FILE; rec.line1 := 4; rec.sign := ".";
    out &:= rec;
  end func;

const func wordRef: exact (in string: nm) is func
  result
    var wordRef: out is wordRef.value;
  begin
    out.word := nm;
    out.line1 := 1;
    out.column1 := 1;
    out.width := length(nm);
  end func;

# referencesAnswer keys on `word.word' and `word.line1' ONLY, so this carrier takes no column:
# position granularity is not under test here and a reader must not believe it is. A real
# request's wordRef comes from wordAt, which fills column1/character1/width -- the checks that
# need a real column call wordAt on the fixture instead of fabricating one.
const func wordRef: atLine (in string: nm, in integer: ln1) is func
  result
    var wordRef: out is wordRef.value;
  begin
    out.word := nm;
    out.line1 := ln1;
    out.width := length(nm);
  end func;

# The text of `howMany' occurrences of one name, for the cap checks: one statement per line,
# so line0 IS the occurrence index and the cap is countable from the text.
const func string: capLines (in integer: howMany) is func
  result
    var string: out is "";
  local
    var integer: k is 0;
  begin
    for k range 1 to howMany do
      out &:= "count := 1;\n";
    end for;
  end func;

# "end":{"line": is what lspRangeUnits emits and lspRange does not, so endCount = uriCount is
# the statement that every location carries a range with both bounds.
const func integer: endCount (in string: jsonText) is func
  result
    var integer: out is 0;
  local
    var string: rest is "";
    var integer: at is 0;
  begin
    rest := jsonText;
    at := pos(rest, "\"end\":{\"line\":");
    while at <> 0 do
      out +:= 1;
      if at + 14 > length(rest) then
        rest := "";
      else
        rest := rest[at + 14 ..];
      end if;
      at := pos(rest, "\"end\":{\"line\":");
    end while;
  end func;

# The references fixture. It analyses with 0 diagnostics (pinned below), and every line number in
# the checks below is a line of `refsText' -- no count is stated here because a stated count is one
# edit away from being wrong, while the pins are not. Edit the fixture and the checks move with it: a global `counter', a routine that shadows it
# with its own local, a TWO-LINE header whose first parameter is declared above the body region
# (spec 11.9 -- the case includeDeclaration has something to add), a struct field (no
# declaration source at all, spec 11.10), and one line whose string literal holds an astral
# character before the code, which is what makes the columns of lspRangeUnits observable.
const func string: refsText is func
  result
    var string: out is "";
  begin
    out := "$ include \"seed7_05.s7i\";\n" <&
           "  include \"console.s7i\";\n" <&
           "\n" <&
           "const type: Widget is new struct\n" <&
           "    var integer: pix is 0;\n" <&
           "  end struct;\n" <&
           "\n" <&
           "var integer: counter is 0;\n" <&
           "\n" <&
           "const proc: show (in integer: left,\n" <&
           "                  in integer: right) is func\n" <&
           "  local\n" <&
           "    var integer: counter is 0;\n" <&
           "  begin\n" <&
           "    counter := left + right;\n" <&
           "    writeln(counter);\n" <&
           "  end func;\n" <&
           "\n" <&
           "const proc: main is func\n" <&
           "  local\n" <&
           "    var Widget: box is Widget.value;\n" <&
           "  begin\n" <&
           "    box.pix := 1;\n" <&
           "    show(2, 3);\n" <&
           "    writeln(\"\128512;\"); counter := box.pix;\n" <&
           "  end func;\n" <&
           "\n" <&
           "const func integer: type (in integer: n) is func\n" <&
           "  result\n" <&
           "    var integer: doubled is 0;\n" <&
           "  begin\n" <&
           "    doubled := n * 2;\n" <&
           "  end func;\n";
  end func;

# The R51 fixture: a routine that shares its name with one of its parameters, in the one-line
# header shape and in a two-line header shape, plus a control parameter that shares nothing. Seed7
# accepts `const proc: show (in integer: show)' -- measured: no analysis error, and running it
# prints 3 -- and reflection reports the routine and that parameter at the SAME line1, which is
# what makes a write that locates a declaration by line unsafe. Pinned at errorCount 0 below, so
# every column of the expected json is a line of this text.
const func string: ambigText is func
  result
    var string: out is "";
  begin
    out := "$ include \"seed7_05.s7i\";\n" <&
           "  include \"console.s7i\";\n" <&
           "\n" <&
           "const proc: show (in integer: show) is func\n" <&
           "  begin\n" <&
           "    writeln(show);\n" <&
           "  end func;\n" <&
           "\n" <&
           "const proc: tally (in integer: tally,\n" <&
           "                    in integer: delta) is func\n" <&
           "  begin\n" <&
           "    writeln(tally + delta);\n" <&
           "  end func;\n" <&
           "\n" <&
           "const proc: main is func\n" <&
           "  begin\n" <&
           "    show(3);\n" <&
           "    tally(1, 2);\n" <&
           "  end func;\n";
  end func;

# The second cause of the same refusal, with NO routine and NO parameter in the file: two
# records of `x' on the line that declares it, because a second statement shares the line.
# Spec 11.12 measured this exact text on `/tmp/r9probe.sd7' and found the refusal sentence false
# for it -- it claimed "the shape a parameter takes when it is named after its routine". Pinned
# at diags 0; every column below was read from a probe, not derived.
const func string: sameLineText is func
  result
    var string: out is "";
  begin
    out := "$ include \"seed7_05.s7i\";\n" <&
           "const integer: x is 1; const integer: y is x;\n" <&
           "\n" <&
           "const proc: main is func\n" <&
           "  begin\n" <&
           "    writeln(x);\n" <&
           "  end func;\n";
  end func;

# The field-clash fixture: `counter' is BOTH a routine's local and a struct's field, and the
# routine reads `box.counter'. This is spec 12.2's case -- `w.pix is pervasive in real Seed7' --
# and the shape the write path must refuse: the local's scope window holds the field ACCESS but
# not the field's declaration, so an edit list built from the spelling alone rewrites two
# different symbols. Pinned at diags 0, so every column in the expectations below is a line of
# this text.
const func string: fieldClashText is func
  result
    var string: out is "";
  begin
    out := "$ include \"seed7_05.s7i\";\n" <&
           "\n" <&
           "const type: Widget is new struct\n" <&
           "    var integer: counter is 0;\n" <&
           "    var integer: total is 0;\n" <&
           "  end struct;\n" <&
           "\n" <&
           "var integer: total is 0;\n" <&
           "\n" <&
           "const proc: show (in Widget: box) is func\n" <&
           "  local\n" <&
           "    var integer: counter is 0;\n" <&
           "  begin\n" <&
           "    counter := box.counter + 1;\n" <&
           "    counter := counter + box.counter;\n" <&
           "  end func;\n" <&
           "\n" <&
           "const proc: tally (in integer: n) is func\n" <&
           "  local\n" <&
           "    var integer: counter is 0;\n" <&
           "  begin\n" <&
           "    counter := n + 1;\n" <&
           "    counter := counter + n;\n" <&
           "  end func;\n" <&
           "\n" <&
           "const proc: main is func\n" <&
           "  local\n" <&
           "    var Widget: b is Widget.value;\n" <&
           "  begin\n" <&
           "    b.counter := 1;\n" <&
           "    b.total := total;\n" <&
           "    show(b);\n" <&
           "    tally(b.counter);\n" <&
           "  end func;\n";
  end func;

# The two-struct fixture spec 9 asked for and never had: `pix' is a field of TWO structs in one
# file, the global `pix' is one of four symbols of the same spelling, and one routine declares `pix'
# as its own local. This is spec 12.2's permanent row-4 case -- `field names repeat across structs,
# and w.pix is pervasive in real Seed7' -- and there is no machine here that separates the two
# fields, so both spellings stay one symbol. The bodies only assign: analysis runs what it reads.
const func string: twoStructText is func
  result
    var string: out is "";
  begin
    out := "$ include \"seed7_05.s7i\";\n" <&
           "\n" <&
           "const type: Alpha is new struct\n" <&
           "    var integer: pix is 0;\n" <&
           "  end struct;\n" <&
           "\n" <&
           "const type: Beta is new struct\n" <&
           "    var integer: pix is 0;\n" <&
           "  end struct;\n" <&
           "\n" <&
           "var integer: pix is 0;\n" <&
           "\n" <&
           "const proc: show (in Alpha: a, in Beta: b) is func\n" <&
           "  local\n" <&
           "    var integer: pix is 0;\n" <&
           "  begin\n" <&
           "    pix := a.pix + b.pix;\n" <&
           "  end func;\n" <&
           "\n" <&
           "const proc: main is func\n" <&
           "  local\n" <&
           "    var Alpha: x is Alpha.value;\n" <&
           "    var Beta: y is Beta.value;\n" <&
           "  begin\n" <&
           "    x.pix := 1;\n" <&
           "    y.pix := 2;\n" <&
           "    pix := 3;\n" <&
           "    show(x, y);\n" <&
           "  end func;\n";
  end func;

# The operator-declaring fixture: a buffer that declares its OWN operator, the shape §6's
# refusal had no witness for. Seed7 will not parse a new operator symbol until a syntax rule
# gives it a priority -- measured: without the `$ syntax' line the analyzer answers
# "is" expected found "<+" at that token, so the file opens with the rule, which is also the
# third occurrence of the spelling. The bodies only assign: analysis is not a dry parse here, it
# runs what it reads, so a fixture keeps its output silent.
const func string: opDeclText is func
  result
    var string: out is "";
  begin
    out := "$ include \"seed7_05.s7i\";\n" <&
           "\n" <&
           "$ syntax expr: .(). <+ .() is -> 7;\n" <&
           "\n" <&
           "const func integer: (in integer: x) <+ (in integer: y) is func\n" <&
           "  result\n" <&
           "    var integer: doubled is 0;\n" <&
           "  begin\n" <&
           "    doubled := x + y;\n" <&
           "  end func;\n" <&
           "\n" <&
           "const proc: main is func\n" <&
           "  local\n" <&
           "    var integer: total is 0;\n" <&
           "  begin\n" <&
           "    total := 2 <+ 3;\n" <&
           "  end func;\n";
  end func;

# The field refusal's tail, spelled once for the same reason as DECL_AMBIG_TAIL: the two rename
# methods prefix their own method name and nothing else differs.
const string: FIELD_TAIL is
    " appears after a `.' inside its own scope, so the edit list would rewrite a record field of"
    <& " the same name as well as the symbol the cursor named, and the field's declaration is not"
    <& " in that list";

# The refusal sentence's tail, spelled once because the word under the cursor is the only part
# that differs: prepareRename prefixes one method name, rename the other, and each of the three
# measured reaches names its own symbol.
const string: DECL_AMBIG_TAIL is
    " shares its declaration line with another record of the same name, and a declaration found"
    <& " by line cannot choose between them, so a rename could rewrite a record the cursor did"
    <& " not name";

# A buffer declaration named `count', with no scope entries. Enough for resolveBinding's global
# row, and the only way to reach the occurrence cap with a BINDING -- 2 000 lines of
# `count := 1;' is not a program, and the cap is a property of the pass. `declLine1' is the line
# the declaration sits on, so the capped answer can be asked with its declaration placed past
# the cut.
const func array symRec: countGlobalSyms (in integer: declLine1) is func
  result
    var array symRec: out is 0 times symRec.value;
  local
    var symRec: rec is symRec.value;
  begin
    rec.name := "count"; rec.cat := "INTOBJECT"; rec.ty := "integer";
    rec.file := BUFFER_FILE; rec.line1 := declLine1; rec.sign := "var integer: count";
    out &:= rec;
  end func;

const func array symRec: capSyms is func
  result
    var array symRec: out is 0 times symRec.value;
  local
    var symRec: rec is symRec.value;
    var integer: k is 0;
  begin
    rec.cat := "BLOCKOBJECT"; rec.ty := "proc"; rec.file := "/p/big.sd7";
    for k range 1 to 120 do
      rec.name := "pf" <& str(k);
      rec.line1 := k;
      rec.sign := "const proc: " <& rec.name;
      out &:= rec;
    end for;
  end func;

const func integer: labelCount (in string: jsonText) is func
  result
    var integer: out is 0;
  local
    var string: rest is "";
    var integer: at is 0;
  begin
    rest := jsonText;
    at := pos(rest, chr(34) <& "label" <& chr(34) <& ":");
    while at <> 0 do
      out +:= 1;
      if at + 8 > length(rest) then
        rest := "";
      else
        rest := rest[at + 8 ..];
      end if;
      at := pos(rest, chr(34) <& "label" <& chr(34) <& ":");
    end while;
  end func;

const func integer: uriCount (in string: jsonText) is func
  result
    var integer: out is 0;
  local
    var string: rest is "";
    var integer: at is 0;
  begin
    rest := jsonText;
    at := pos(rest, "{\"uri\":");
    while at <> 0 do
      out +:= 1;
      if at + 7 > length(rest) then
        rest := "";
      else
        rest := rest[at + 7 ..];
      end if;
      at := pos(rest, "{\"uri\":");
    end while;
  end func;

# A rename edit is `{"range":{ ... ,"newText":', so editCount is the number of TextEdit entries
# and endCount = editCount is the statement that each of them carries both bounds.
const func integer: editCount (in string: jsonText) is func
  result
    var integer: out is 0;
  local
    var string: rest is "";
    var integer: at is 0;
  begin
    rest := jsonText;
    at := pos(rest, "{\"range\":{");
    while at <> 0 do
      out +:= 1;
      if at + 10 > length(rest) then
        rest := "";
      else
        rest := rest[at + 10 ..];
      end if;
      at := pos(rest, "{\"range\":{");
    end while;
  end func;

# One document entry of a WorkspaceEdit is its uri key followed by its edit array, so `":[` is
# the marker. `uriCount' cannot be reused: it keys on `{\"uri\":', which is references' Location
# shape and never appears in a WorkspaceEdit.
const func integer: docCount (in string: jsonText) is func
  result
    var integer: out is 0;
  local
    var string: rest is "";
    var integer: at is 0;
  begin
    rest := jsonText;
    at := pos(rest, "\":[");
    while at <> 0 do
      out +:= 1;
      if at + 3 > length(rest) then
        rest := "";
      else
        rest := rest[at + 3 ..];
      end if;
      at := pos(rest, "\":[");
    end while;
  end func;

const proc: main is func
  local
    var symRec: one is symRec.value;
    var symRec: two is symRec.value;
    var symRec: other is symRec.value;
    var symRec: buf is symRec.value;
    var symRec: ea is symRec.value;
    var symRec: eb is symRec.value;
    var symRec: dup is symRec.value;
    var symRec: own is symRec.value;
    var array symRec: ownsyms is 0 times symRec.value;
    var array symRec: wsyms is 0 times symRec.value;
    var array symRec: many is 0 times symRec.value;
    var wordRef: word is wordRef.value;
    var array symRec: apsyms is 0 times symRec.value;
    var symRec: ap is symRec.value;
    var symRec: h1 is symRec.value;
    var symRec: h2 is symRec.value;
    var array symRec: hsyms is 0 times symRec.value;
    var integer: active is 0;
    var lsDoc: sig is lsDoc.value;
    var lsDoc: astral is lsDoc.value;
    var wordRef: aw is wordRef.value;
    var string: got is "";
    var lsDoc: hov is lsDoc.value;
    var integer: k is 0;
    var array symRec: syms is 0 times symRec.value;
    var lsDoc: rdoc is lsDoc.value;
    var string: rtext is "";
    var string: refPath is "/tmp/tt_refs.sd7";
    var string: refUri is "file:///tmp/tt_refs.sd7";
    var docAnalysis: rd is docAnalysis.value;
    var array symRec: rsyms is 0 times symRec.value;
    var array string: noDirs is 0 times "";
    var refsAnswer: ra is refsAnswer.value;
    var refsAnswer: fb is refsAnswer.value;
    var refsAnswer: capAns is refsAnswer.value;
    var wordRef: realWord is wordRef.value;
    var binding: rb is binding.value;
    var array occurrence: ocOne is 1 times occurrence.value;
    var array occurrence: ocWide is 0 times occurrence.value;
    var lsDoc: capDoc is lsDoc.value;
    var string: capText is "";
    var string: capUri is "file:///tmp/tt_cap.sd7";
    var prepareAnswer: pc is prepareAnswer.value;
    var wordRef: capWord is wordRef.value;
    var renameAnswer: rn is renameAnswer.value;
    var lsDoc: ndoc is lsDoc.value;
    var lsDoc: capDoc2 is lsDoc.value;
    var array symRec: nsyms is 0 times symRec.value;
    var symRec: nrec is symRec.value;
    var string: renameUri is "file:///tmp/tt_rename.sd7";
    var lsDoc: adoc is lsDoc.value;
    var array symRec: asyms is 0 times symRec.value;
    var docAnalysis: ad is docAnalysis.value;
    var wordRef: aword is wordRef.value;
    var string: ambigPath is "/tmp/tt_ambig.sd7";
    var string: ambigUri is "file:///tmp/tt_ambig.sd7";
    var lsDoc: fdoc is lsDoc.value;
    var array symRec: fsyms is 0 times symRec.value;
    var docAnalysis: fd is docAnalysis.value;
    var string: fPath is "/tmp/tt_field.sd7";
    var string: fUri is "file:///tmp/tt_field.sd7";
    var lsDoc: sdoc is lsDoc.value;
    var array symRec: ssyms is 0 times symRec.value;
    var docAnalysis: sd is docAnalysis.value;
    var string: sPath is "/tmp/tt_same.sd7";
    var string: sUri is "file:///tmp/tt_same.sd7";
    var lsDoc: opDoc is lsDoc.value;
    var array symRec: opSyms is 0 times symRec.value;
    var docAnalysis: opAn is docAnalysis.value;
    var string: opPath is "/tmp/tt_opdecl.sd7";
    var string: opUri is "file:///tmp/tt_opdecl.sd7";
    var wordRef: opWord is wordRef.value;
    var lsDoc: pdoc is lsDoc.value;
    var array symRec: psyms is 0 times symRec.value;
    var docAnalysis: pd is docAnalysis.value;
    var string: pPath is "/tmp/tt_two.sd7";
    var string: pUri is "file:///tmp/tt_two.sd7";
    var wordRef: pixWord is wordRef.value;
    var renameCheck: dec is renameCheck.value;
  begin
    one.name := "Widget"; one.cat := "TYPEOBJECT"; one.ty := "type";
    one.file := "/p/a.sd7"; one.line1 := 4; one.sign := "const type: Widget";
    two.name := "go"; two.cat := "BLOCKOBJECT"; two.ty := "proc";
    two.file := "/p/a.sd7"; two.line1 := 9; two.sign := "const proc: go (string: s)";
    other.name := "far"; other.cat := "BLOCKOBJECT"; other.ty := "proc";
    other.file := "/p/b.sd7"; other.line1 := 2; other.sign := "const proc: far";
    syms &:= one;
    syms &:= two;
    syms &:= other;
    check("documentSymbol json", documentSymbolResult(syms, "/p/a.sd7"),
          "[{\"name\":\"Widget\",\"detail\":\"const type: Widget\",\"kind\":5,\"range\":" &
          "{\"start\":{\"line\":3,\"character\":0},\"end\":{\"line\":4,\"character\":0}}," &
          "\"selectionRange\":{\"start\":{\"line\":3,\"character\":0}," &
          "\"end\":{\"line\":4,\"character\":0}}}," &
          "{\"name\":\"go\",\"detail\":\"const proc: go (string: s)\",\"kind\":12,\"range\":" &
          "{\"start\":{\"line\":8,\"character\":0},\"end\":{\"line\":9,\"character\":0}}," &
          "\"selectionRange\":{\"start\":{\"line\":8,\"character\":0}," &
          "\"end\":{\"line\":9,\"character\":0}}}]");
    buf.name := "fromBuffer"; buf.cat := "BLOCKOBJECT"; buf.ty := "proc";
    buf.file := "STRING"; buf.line1 := 2; buf.sign := "const proc: fromBuffer";
    syms &:= buf;
    checkTrue("a buffer's own declaration is listed under its real uri",
              pos(documentSymbolResult(syms, "/p/a.sd7"),
                  "\"name\":\"fromBuffer\"") <> 0);
    check("a document with nothing in it is an empty array",
          documentSymbolResult(0 times symRec.value, "/p/nowhere.sd7"), "[]");
    check("no symbols at all is an empty array",
          documentSymbolResult(0 times symRec.value, "/p/a.sd7"), "[]");
    check("a var declaration is a Variable", str(symbolKindOf("REFOBJECT", "integer")), "13");
    check("a stdlib action is a Function", str(symbolKindOf("ACTOBJECT", "proc")), "12");
    # the type-based branch is tried first, so this is what keeps the category branch
    # load-bearing: a callable whose type raises or reports a marker is still a Function.
    check("a callable with no usable type is still a Function",
          str(symbolKindOf("ACTOBJECT", "")), "12");
    check("an enum literal is an EnumMember", str(symbolKindOf("ENUMLITERALOBJECT", "color")), "22");
    checkTrue("the same judgement drives completion kinds",
              completionKindOf("TYPEOBJECT", "type") = 7 and
              completionKindOf("BLOCKOBJECT", "proc") = 3 and
              completionKindOf("STRUCTOBJECT", "Widget") = 21);
    ea.name := "writeln"; ea.cat := "BLOCKOBJECT"; ea.ty := "proc";
    ea.file := "/tmp/a.sd7"; ea.line1 := 13; ea.sign := "const proc: writeln";
    eb.name := "writeln"; eb.cat := "ACTOBJECT"; eb.ty := "proc";
    eb.file := "/tmp/b c.s7i"; eb.line1 := 1; eb.sign := "const proc: writeln (string: s)";
    dup.name := "writeln"; dup.cat := "BLOCKOBJECT"; dup.ty := "proc";
    dup.file := "/tmp/a.sd7"; dup.line1 := 13; dup.sign := "const proc: writeln";
    wsyms &:= ea;
    wsyms &:= eb;
    wsyms &:= dup;
    check("no token means null", definitionResult(wsyms, wordRef.value, "file:///x.sd7"),
          "null");
    word.word := "nosuchname";
    check("unknown token is the empty array", definitionResult(wsyms, word, "file:///x.sd7"),
          "[]");
    word.word := "writeln";
    check("locations dedupe and percent-encode",
          definitionResult(wsyms, word, "file:///x.sd7"),
          "[{\"uri\":\"file:///tmp/a.sd7\",\"range\":" &
          "{\"start\":{\"line\":12,\"character\":0},\"end\":{\"line\":13," &
          "\"character\":0}}},{\"uri\":\"file:///tmp/b%20c.s7i\",\"range\":" &
          "{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":1," &
          "\"character\":0}}}]");
    own.name := "writeln"; own.cat := "BLOCKOBJECT"; own.ty := "proc";
    own.file := BUFFER_FILE; own.line1 := 19; own.sign := "const proc: writeln";
    ownsyms &:= own;
    check("a declaration from the buffer itself resolves to the buffer's uri",
          definitionResult(ownsyms, word, "file:///tmp/tt_syms.sd7"),
          "[{\"uri\":\"file:///tmp/tt_syms.sd7\",\"range\":" &
          "{\"start\":{\"line\":18,\"character\":0},\"end\":{\"line\":19," &
          "\"character\":0}}}]");
    dup.name := "writeln"; dup.cat := "BLOCKOBJECT"; dup.ty := "proc";
    dup.sign := "const proc: writeln";
    for k range 1 to 25 do
      dup.file := "/tmp/c.sd7";
      dup.line1 := k;
      many &:= dup;
    end for;
    word.word := "own";
    word.line1 := 5; word.column1 := 14; word.width := 3;
    setVersion(hov, "  const integer: n is 1;\n(**\n *  From the buffer.\n *)\nconst proc: own is func\n  begin\n  end func;\n", 1);
    own.name := "own"; own.cat := "BLOCKOBJECT"; own.ty := "proc";
    own.file := BUFFER_FILE; own.line1 := 5; own.sign := "const proc: own";
    ownsyms := 0 times symRec.value;
    ownsyms &:= own;
    check("hover of a buffer symbol carries its signature and its own prose",
          hoverResult(hov, ownsyms, word),
          "{\"contents\":{\"kind\":\"markdown\",\"value\":" &
          "\"```seed7\\nconst proc: own\\n```\\n\\nFrom the buffer.\"}," &
          "\"range\":{\"start\":{\"line\":4,\"character\":13}," &
          "\"end\":{\"line\":4,\"character\":16}}}");
    word.word := "nosuch";
    check("hover of an unknown word is null", hoverResult(hov, ownsyms, word), "null");
    word.word := "writeln";
    check("hover lists each distinct signature once",
          hoverText(wsyms, word, hov),
          "```seed7\nconst proc: writeln\nconst proc: writeln (string: s)\n```");
    check("an empty word has nothing to say",
          hoverText(wsyms, wordRef.value, hov), "");
    check("locations are capped at MAX_LOCATIONS",
          str(uriCount(definitionResult(many, word, "file:///x.sd7"))), "20");
    word.word := "writeln";
    word.word := "tot"; word.line1 := 5; word.column1 := 12; word.character1 := 11;
    word.width := 3;
    check("prefix is the part left of the cursor", prefixOf(word, 13), "to");
    check("prefix at the end of the word is the whole word", prefixOf(word, 15), "tot");
    check("cursor before the word gives an empty prefix", prefixOf(word, 10), "");
    # Same token, same cursor, but the line holds two BMP characters and two astral ones
    # (four UTF-16 units in six characters) before it. Seed7 has no \u escapes, so the text
    # is built with chr(): counting characters against units would make the prefix wrong
    # by two here, which is what wordRef.character1 exists to prevent.
    setVersion(astral, "" <& chr(26085) <& chr(26412) <& chr(66688) <& chr(66688) <&
                      " tot", 1);
    aw := wordAt(astral, 0, 19);
    check("the token after astral text is still found", aw.word, "tot");
    check("its UTF-16 column counts units, not characters", str(aw.character1), "7");
    check("and the prefix is still the two typed units", prefixOf(aw, 9), "to");
    ap.name := "apple"; ap.cat := "BLOCKOBJECT"; ap.ty := "proc";
    ap.file := "/p/a.sd7"; ap.line1 := 2; ap.sign := "const proc: apple";
    apsyms &:= ap;
    ap.name := "apply"; ap.line1 := 4; ap.sign := "const proc: apply";
    apsyms &:= ap;
    ap.name := "ape"; ap.line1 := 6; ap.sign := "const proc: ape";
    apsyms &:= ap;
    word.word := "ap"; word.line1 := 1; word.column1 := 1; word.character1 := 0;
    word.width := 2;
    check("completions are the prefix matches in order, exact word excluded",
          completionResult(apsyms, word, 3, "/p/a.sd7"),
          "[{\"label\":\"apple\",\"kind\":3,\"detail\":\"const proc: apple\",\"sortText\":\"0apple\"}," &
          "{\"label\":\"apply\",\"kind\":3,\"detail\":\"const proc: apply\",\"sortText\":\"0apply\"}," &
          "{\"label\":\"ape\",\"kind\":3,\"detail\":\"const proc: ape\",\"sortText\":\"0ape\"}]");
    checkTrue("the exact word is never offered back",
              pos(completionResult(apsyms, exact("ape"), 6, "/p/a.sd7"), "\"ape\"") = 0);
    word.word := "co"; word.line1 := 1; word.column1 := 1; word.character1 := 0;
    word.width := 2;
    checkTrue("keywords complete too",
              pos(completionResult(0 times symRec.value, word, 3, "/p/a.sd7"),
                  "\"label\":\"const\",\"kind\":14,\"sortText\":\"1const\"") <> 0);
    checkTrue("a capped list becomes a CompletionList",
              startsWith(completionResult(capSyms(), exact("pf"), 5, "/p/a.sd7"),
                         "{\"isIncomplete\":true,\"items\":[") and
              labelCount(completionResult(capSyms(), exact("pf"), 5, "/p/a.sd7")) = 100);
    checkTrue("own-file symbols win the cap",
              pos(completionResult(ownLastSyms(), exact(""), 1, "/p/a.sd7"),
                  "\"label\":\"myOwnName\"") <> 0);
    # "." is declared in the file itself, so it is in the first pass and well inside the
    # cap: the filter is what removes it here, not the cut-off.
    checkTrue("a name that cannot be typed is never offered",
              pos(completionResult(ownLastSyms(), exact(""), 1, "/p/a.sd7"),
                  "\"label\":\".\"") = 0);
    checkTrue("an empty prefix still offers the keywords (ctrl-space)",
              startsWith(completionResult(0 times symRec.value, exact(""), 1, "/p/a.sd7"), "[{") and
              pos(completionResult(0 times symRec.value, exact(""), 1, "/p/a.sd7"),
                  "\"label\":\"const\"") <> 0);
    got := calleeAt(sig, "go(x", 5, active);
    check("callee is the name before the owning paren", got, "go");
    check("no comma yet", str(active), "0");
    got := calleeAt(sig, "reportWidget(x, hits", 20, active);
    check("a longer callee still resolves", got, "reportWidget");
    check("second argument is active", str(active), "1");
    got := calleeAt(sig, "f(a, (b, c", 12, active);
    check("a grouping paren has no callee", got, "");
    check("so signatureHelp reports nothing at all", signatureHelpResult(hsyms, got, active),
          "null");
    got := calleeAt(sig, "writeln done", 12, active);
    check("no unclosed paren to the left", got, "");
    check("and no stale count leaks out", str(active), "0");
    got := calleeAt(sig, "go(\"a, b\", x", 13, active);
    check("a comma inside a string literal is not an argument separator", got, "go");
    check("one real comma", str(active), "1");
    got := calleeAt(sig, "go(\"a, b", 8, active);
    check("a cursor inside a string argument still names the enclosing call", got, "go");
    check("and it is the first argument", str(active), "0");
    got := calleeAt(sig, "(*  go(a, b", 11, active);
    check("a cursor inside a comment gets none either", got, "");
    got := calleeAt(sig, "# go(a, b", 9, active);
    check("nor one inside a line comment", got, "");
    got := calleeAt(sig, "outer(inner(a, b), ", 19, active);
    check("the innermost UNCLOSED call wins", got, "outer");
    check("the outer argument index is counted", str(active), "1");
    setVersion(sig, "go(\"multi\nline\", x", 1);
    # A bare newline in a string is STRING_EXCEEDS: the scanner ends the token there,
    # so `line` is code and the comma is inside a second unterminated string `", x`.
    # The old codeText machine incorrectly continued the string across the newline.
    # The call still resolves to `go` because the `(` is before the string, but the
    # comma is masked, so active is 0 (still in the first argument).
    check("a call after a string that spans lines still resolves",
          callContextOf(sig, 1, 7, active), "go");
    check("the comma is inside a second string and does not count", str(active), "0");
    got := calleeAt(sig, "go(x, y)  # tail", 9, active);
    check("a closed call offers nothing", got, "");
    setVersion(sig, "  const integer: q is 1;\nreportWidget(\"a\", ", 1);
    check("the walk is not confined to one line",
          callContextOf(sig, 1, 17, active), "reportWidget");
    check("the argument index survives the line break", str(active), "1");
    h1.name := "writeln"; h1.cat := "BLOCKOBJECT"; h1.ty := "proc";
    h1.file := "/tmp/a.sd7"; h1.line1 := 3;
    h1.sign := "const proc: writeln (string: s)";
    h1.params := []("string: s");
    h2.name := "writeln"; h2.cat := "DECLAREDOBJECT"; h2.ty := "func integer";
    h2.file := "/tmp/a.sd7"; h2.line1 := 7;
    h2.sign := "const func integer: writeln (integer: n)";
    h2.params := []("integer: n");
    hsyms &:= h1;
    hsyms &:= h2;
    setVersion(sig, "go(\"a, b\", x);\nconst integer: q is 1;\n", 1);
    active := 0;
    check("no callee means null", signatureHelpResult(hsyms, "", 0), "null");
    check("one signature per overload, active parameter reported",
          signatureHelpResult(hsyms, "writeln", 1),
          "{\"signatures\":[{\"label\":\"const proc: writeln (string: s)\"," &
          "\"parameters\":[{\"label\":\"string: s\"}]}," &
          "{\"label\":\"const func integer: writeln (integer: n)\"," &
          "\"parameters\":[{\"label\":\"integer: n\"}]}]," &
          "\"activeSignature\":0,\"activeParameter\":1}");
    checkTrue("an active parameter past the last one is reported, not dropped",
              pos(signatureHelpResult(hsyms, "writeln", 9), "\"activeParameter\":9") <> 0);
    check("a callee with no declarations is null",
          signatureHelpResult(hsyms, "nosuch", 0), "null");
    # ---- textDocument/references -------------------------------------------------
    rtext := refsText();
    setVersion(rdoc, rtext, 1);
    rd := analyzeAll(rtext, noDirs, refPath);
    rsyms := rd.syms;
    check("the references fixture analyses clean", str(length(rd.parsed.diags)), "0");
    # A local: only its own routine's region. Broken value if the global row answered instead
    # is 2 (the two lines outside show), and if nothing bound at all it is 5 (every `counter').
    ra := referencesAnswer(rdoc, rsyms, atLine("counter", 15), refUri, FALSE);
    check("a local's references are its own region only", str(uriCount(ra.json)), "3");
    check("every location carries an exact character range", str(endCount(ra.json)), "3");
    check("a bound symbol is not reported unresolved", str(ra.unresolved), "FALSE");
    check("a bound symbol has nothing to log", ra.why, "");
    # includeDeclaration on the local adds nothing: its declaration line is already one of the
    # occurrences above, published with an exact column. Broken value is 4 -- two locations for
    # one line, one of them the worse whole-line range.
    ra := referencesAnswer(rdoc, rsyms, atLine("counter", 15), refUri, TRUE);
    check("a declaration already in the list is not published twice", str(uriCount(ra.json)), "3");
    # The global, at the cursor on the astral line. The whole answer is pinned because this is
    # the first feature whose ranges are not line-based: `counter' sits at UTF-16 column 19
    # there, and routing the location through lspRange (which converts a CHARACTER column)
    # would report 20-27.
    ra := referencesAnswer(rdoc, rsyms, atLine("counter", 25), refUri, FALSE);
    check("the global loses the shadowing routine's occurrences, with exact columns",
          ra.json,
          "[{\"uri\":\"file:///tmp/tt_refs.sd7\",\"range\":"
          & "{\"start\":{\"line\":7,\"character\":13},\"end\":{\"line\":7,\"character\":20}}},"
          & "{\"uri\":\"file:///tmp/tt_refs.sd7\",\"range\":"
          & "{\"start\":{\"line\":24,\"character\":19},\"end\":{\"line\":24,\"character\":26}}}]");
    # The two-line header: reflection reports `left' at line 10 while show's body region opens
    # at line0 10, so the declaration is NOT among the published occurrences and
    # includeDeclaration is the only thing that puts it in the answer. FALSE must be 1.
    ra := referencesAnswer(rdoc, rsyms, atLine("left", 15), refUri, FALSE);
    check("without includeDeclaration the declaration above the region stays out",
          str(uriCount(ra.json)), "1");
    ra := referencesAnswer(rdoc, rsyms, atLine("left", 15), refUri, TRUE);
    check("includeDeclaration adds it as a whole line, because reflection has no column",
          ra.json,
          "[{\"uri\":\"file:///tmp/tt_refs.sd7\",\"range\":"
          & "{\"start\":{\"line\":9,\"character\":0},\"end\":{\"line\":10,\"character\":0}}},"
          & "{\"uri\":\"file:///tmp/tt_refs.sd7\",\"range\":"
          & "{\"start\":{\"line\":14,\"character\":15},\"end\":{\"line\":14,\"character\":19}}}]");
    # A struct field: no declaration source exists (spec 11.10), so the binding is unproved and
    # the answer is every same-named token plus the log line (spec 2's over-inclusive read).
    ra := referencesAnswer(rdoc, rsyms, atLine("pix", 23), refUri, FALSE);
    check("a field answers every same-named token", str(uriCount(ra.json)), "3");
    check("a field says the binding was unresolved", str(ra.unresolved), "TRUE");
    check("the log line names the reason", ra.why,
          "references: pix does not bind to a declaration of this file," <&
          " so every occurrence of it is listed");
    # The same name on its OWN declaration line is not dot-selected, so resolveBinding answers
    # owner "" there and owner "field" here. R40: the feature branches on `resolved', so the two
    # answers must be identical -- a check that reddens any special case built on owner.
    fb := referencesAnswer(rdoc, rsyms, atLine("pix", 5), refUri, FALSE);
    check("an unbound name and a field get the same answer", str(ra.json = fb.json), "TRUE");
    # A library symbol is resolved, so it does not log; and its declarations live in files the
    # client never opened, so declLine1 0 must not become a whole-line location at line -1.
    ra := referencesAnswer(rdoc, rsyms, atLine("writeln", 25), refUri, TRUE);
    check("a library symbol answers this file's occurrences, and no library declaration",
          str(uriCount(ra.json)), "2");
    check("a library symbol is resolved, so it has nothing to log",
          str(ra.unresolved), "FALSE");
    # The gate is the measured 63-word set the interpreter refuses as a declared name, NOT
    # completion's 48-word vocabulary, and it runs after rows 1-2 (R28 as refined by R36).
    # `type' is in that vocabulary and is a legal name -- this file declares one, and its two
    # occurrences are also the `const type:' of Widget -- so references must answer them. A
    # feature that gated on keywordList before resolving would answer null here: the feature-level
    # witness for the ordering occurrences.sd7 pins in its own suite.
    ra := referencesAnswer(rdoc, rsyms, atLine("type", 28), refUri, FALSE);
    check("a declared name that is also a vocabulary word still gets its references",
          str(uriCount(ra.json)), "2");
    # The null answers. A keyword binds to nothing by the gate and an empty word is no token at
    # all; both answer null rather than [], which would read "unused".
    ra := referencesAnswer(rdoc, rsyms, atLine("begin", 22), refUri, FALSE);
    check("a keyword answers null, not an empty list", ra.json, "null");
    check("a keyword is not unresolved either", str(ra.unresolved), "FALSE");
    # The empty word, from real input rather than a hand-built record: a line's LEADING
    # indentation is the state most Seed7 source answers (every indented line), and wordAt has
    # no token to its left there. doc_store_test pins the same rule for `two'; this is the
    # references-side witness that the guard above is reached by an ordinary cursor.
    realWord := wordAt(rdoc, 14, 1);
    check("leading indentation reaches the feature as the empty word", realWord.word, "");
    ra := referencesAnswer(rdoc, rsyms, realWord, refUri, FALSE);
    check("a position with no token answers null", ra.json, "null");
    # A number and a bracket ARE words to wordAt -- the client sends the cursor there -- but the
    # index holds neither, so searching for the literal text would answer [] instead of null.
    realWord := wordAt(rdoc, 23, 10);
    check("a cursor inside a number reaches the feature as that number", realWord.word, "2");
    ra := referencesAnswer(rdoc, rsyms, realWord, refUri, FALSE);
    check("a number token answers null, not an empty list", ra.json, "null");
    ra := referencesAnswer(rdoc, rsyms, wordAt(rdoc, 23, 9), refUri, FALSE);
    check("a bracket token answers null, not an empty list", ra.json, "null");
    # An OPERATOR run is TK_OP, which IS indexable, so it is neither gated nor empty: the answer
    # is a real list of every occurrence in the file. Measured: the analyzer's table carries `+',
    # so resolveBinding's library row RESOLVES it and `unresolved' is FALSE. That is the seam
    # Task 8 inherits -- rename must refuse this cursor on the binding's owner, not on
    # `unresolved', because an operator can be both answered and resolved here.
    ra := referencesAnswer(rdoc, rsyms, wordAt(rdoc, 14, 20), refUri, FALSE);
    check("an operator cursor answers its occurrences, not null", ra.json,
          "[{\"uri\":\"file:///tmp/tt_refs.sd7\",\"range\":"
          & "{\"start\":{\"line\":14,\"character\":20},\"end\":{\"line\":14,\"character\":21}}}]");
    check("and a TK_OP can be resolved, so rename cannot key its refusal on unresolved",
          str(ra.unresolved), "FALSE");
    # ---- the occurrence cap, and whose length `capped' reads (R39) ---------------
    for k range 1 to MAX_OCCURRENCES do
      capText &:= "count := 1;\n";
    end for;
    setVersion(capDoc, capText, 1);
    capAns := referencesAnswer(capDoc, countGlobalSyms(1), atLine("count", 1), capUri, FALSE);
    check("exactly MAX_OCCURRENCES locations is not a truncated answer",
          str(capAns.unresolved), "FALSE");
    check("and all of them are published", str(uriCount(capAns.json)), "2000");
    capText &:= "count := 1;\n";
    setVersion(capDoc, capText, 1);
    check("the capped text really holds one occurrence more than the cap",
          str(length(occurrencesOf(capText, "count"))), str(MAX_OCCURRENCES + 1));
    capAns := referencesAnswer(capDoc, countGlobalSyms(1), atLine("count", 1), capUri, FALSE);
    check("one more occurrence truncates the list, and says so", str(capAns.unresolved), "TRUE");
    check("the 2001st record is the sentinel, not a location to publish",
          str(uriCount(capAns.json)), "2000");
    check("the truncated answer names the truncation", capAns.why,
          "references: count has more occurrences than this server lists," <&
          " so the result is truncated");
    # Both disclosures at once, from real input. The `else' arm that composes the two sentences
    # needs `not b.resolved' AND `b.capped' together, and every capped check above passes a
    # RESOLVED global, so without this line that arm is reachable only from a mutation. An
    # undeclared name with more occurrences than the cap is what separates them: no symbols at
    # all, so nothing binds `count', while the same 2 001-line document is still truncated.
    capAns := referencesAnswer(capDoc, 0 times symRec.value, atLine("count", 1), capUri, FALSE);
    check("an undeclared name past the cap names both reasons", capAns.why,
          "references: count does not bind to a declaration of this file, so every occurrence" <&
          " of it is listed, and the list is truncated at 2000");
    # The declaration is the 2001st occurrence, the record the publish loop stops before. The
    # dedupe test must be bounded by `emitted' as the loop is, or that line is in neither list:
    # neither published as an occurrence nor added as a whole line. With both bounds it is added
    # -- and the answer carries MAX_OCCURRENCES + 1 locations, because the cap counts occurrence
    # RECORDS, not locations.
    capAns := referencesAnswer(capDoc, countGlobalSyms(2001), atLine("count", 1), capUri, TRUE);
    check("a capped answer still publishes the declaration past the cut",
          str(uriCount(capAns.json)), "2001");
    # R39: `capped' is a fact about the ARRAY the caller hands resolveBinding -- which is the
    # list it publishes. The text above has MAX_OCCURRENCES + 1 occurrences, so a resolveBinding
    # that measured the text instead of its parameter would report a truncated document as
    # complete. That is the exact partial result spec 2 refuses, and these two checks are what
    # a caller swapping in a filtered or recomputed list would have to survive.
    rb := resolveBinding(capText, rsyms, ocOne, "count", 0, MAX_OCCURRENCES, refPath, 0);
    check("capped follows the array handed in, not the text", str(rb.capped), "FALSE");
    for k range 1 to MAX_OCCURRENCES + 1 do
      ocWide &:= occurrence.value;
    end for;
    rb := resolveBinding("count := 1;\n", rsyms, ocWide, "count", 0, 0, refPath, 0);
    check("and a long array caps even when the text is short", str(rb.capped), "TRUE");
    # ---- R47: the cap must refuse a WRITE whose cursor IS in the truncated list ----------
    # capDoc now holds MAX_OCCURRENCES + 1 statements and the cursor is on the FIRST of them, so
    # `slot' is found, a range exists, and every other arm of renameDecision is silent. Note what
    # this fixture does and does not hold: the pass keeps MAX_OCCURRENCES + 1 records, so all 2 001
    # occurrences of THIS document are listed and the refusal is conservative by exactly one
    # record. The genuinely-partial shape -- a record past the last one kept, invisible to whoever
    # edits next -- is the 2 002-occurrence document, which is what tests/lsp_server_test.sd7's cap
    # section and the wire run's CAP_TEXT build. Before the `capped' arm these two checks were the
    # accept they should never have been: prepareRename offered this cursor and rename would have
    # edited a truncated list. Deleting the arm reddens BOTH.
    capWord := wordAt(capDoc, 0, 5);
    check("the cursor on the first of a capped document is on the name", capWord.word, "count");
    pc := prepareRenameAnswer(capDoc, countGlobalSyms(1), capWord, capUri, TRUE);
    check("a capped document is refused even when the cursor is listed", str(pc.refused), "TRUE");
    check("and the reason says an edit would be incomplete, not that the token is unlisted",
          pc.why, "prepareRename: count has more occurrences than this server lists" <&
          " (more than 2000), so a rename could not rewrite all of them");
    # ---- textDocument/rename ---------------------------------------------------
    # The local `counter' inside show (refsText lines 13, 15, 16): every edit is one occurrence
    # inScope returns, carrying the same measured range references publishes for it.
    rn := renameResult(rdoc, rsyms, wordAt(rdoc, 14, 10), refUri, "total", TRUE);
    check("a clean rename edits every occurrence in scope", str(editCount(rn.json)), "3");
    check("a rename touches exactly one document", str(docCount(rn.json)), "1");
    check("and every edit carries both bounds", str(endCount(rn.json)), "3");
    check("the edits are those three ranges, each with the new name", rn.json,
          "{\"changes\":{\"file:///tmp/tt_refs.sd7\":[{\"range\":{\"start\":{\"line\":12,\"character\":17},\"end\":{\"line\":12,\"character\":24}},\"newText\":\"total\"},{\"range\":{\"start\":{\"line\":14,\"character\":4},\"end\":{\"line\":14,\"character\":11}},\"newText\":\"total\"},{\"range\":{\"start\":{\"line\":15,\"character\":12},\"end\":{\"line\":15,\"character\":19}},\"newText\":\"total\"}]}}");
    check("a successful rename is not a rejection", rn.error, "");
    check("and a successful rename has nothing to log", rn.why, "");
    # The global, from the cursor on the astral line -- the edit that would have written two
    # columns LEFT had the range come from lspRange, which converts a character column and is
    # given a UTF-16 one. lspRangeUnits back to lspRange reddens this on 19 against 20.
    check("the cursor after the astral character is on the global",
          wordAt(rdoc, 24, 21).word, "counter");
    rn := renameResult(rdoc, rsyms, wordAt(rdoc, 24, 21), refUri, "total", TRUE);
    check("the declaration is edited too, at the measured UTF-16 columns", rn.json,
          "{\"changes\":{\"file:///tmp/tt_refs.sd7\":[{\"range\":{\"start\":{\"line\":7,\"character\":13},\"end\":{\"line\":7,\"character\":20}},\"newText\":\"total\"},{\"range\":{\"start\":{\"line\":24,\"character\":19},\"end\":{\"line\":24,\"character\":26}},\"newText\":\"total\"}]}}");
    # spec 11.9's multi-line header: reflection reports `left' on line 10, ABOVE show's body
    # region, so the scope window does not hold the declaration and an edit list built from
    # inScope alone renames the use and leaves the parameter behind -- a program that no longer
    # compiles. references answers the same gap with a whole-LINE location, and a whole-line edit
    # would delete the line instead of renaming one word in it.
    check("the cursor is on the use of left, not its declaration",
          wordAt(rdoc, 14, 17).word, "left");
    rn := renameResult(rdoc, rsyms, wordAt(rdoc, 14, 17), refUri, "total", TRUE);
    check("a parameter of a multi-line header is renamed at its declaration as well",
          str(editCount(rn.json)), "2");
    check("with the header token's own columns", rn.json,
          "{\"changes\":{\"file:///tmp/tt_refs.sd7\":[{\"range\":{\"start\":{\"line\":9,\"character\":30},\"end\":{\"line\":9,\"character\":34}},\"newText\":\"total\"},{\"range\":{\"start\":{\"line\":14,\"character\":15},\"end\":{\"line\":14,\"character\":19}},\"newText\":\"total\"}]}}");
    # Two occurrences of ONE name on one line. A dedupe that keeps one entry per line -- the
    # shape references' declPublished guard has -- would answer 2 here and leave the second `n',
    # the one to the right of `:=', under the old name.
    setVersion(ndoc, "var integer: n is 0;\nn := n + 1;\n", 1);
    nrec.name := "n"; nrec.cat := "INTOBJECT"; nrec.ty := "integer";
    nrec.file := BUFFER_FILE; nrec.line1 := 1; nrec.sign := "var integer: n";
    nsyms := 0 times symRec.value;
    nsyms &:= nrec;
    rn := renameResult(ndoc, nsyms, wordAt(ndoc, 1, 1), renameUri, "m", TRUE);
    check("both occurrences on one line get their own edit", str(editCount(rn.json)), "3");
    check("and they are the three measured ranges", rn.json,
          "{\"changes\":{\"file:///tmp/tt_rename.sd7\":[{\"range\":{\"start\":{\"line\":0,\"character\":13},\"end\":{\"line\":0,\"character\":14}},\"newText\":\"m\"},{\"range\":{\"start\":{\"line\":1,\"character\":0},\"end\":{\"line\":1,\"character\":1}},\"newText\":\"m\"},{\"range\":{\"start\":{\"line\":1,\"character\":5},\"end\":{\"line\":1,\"character\":6}},\"newText\":\"m\"}]}}");
    # The refusals are the SHARED predicate's, reached through rename: null, with `error' empty,
    # and the same sentence prepareRename gives under the other method's name. An arm list copied
    # here instead of called would drift, and each of these names the arm it came from.
    rn := renameResult(rdoc, rsyms, wordAt(rdoc, 14, 10), refUri, "total", FALSE);
    check("the capability arm reaches rename as null, not as an error",
          str(rn.error = "") <& " " <& rn.json, "TRUE null");
    check("and the reason is the predicate's own", rn.why,
          "rename: the client did not declare workspace.applyEdit, so it cannot apply a" <&
          " WorkspaceEdit");
    rn := renameResult(rdoc, rsyms, wordAt(rdoc, 24, 6), refUri, "total", TRUE);
    check("a library symbol refuses rename too -- M5 renames one file", rn.why,
          "rename: writeln is declared outside this buffer, and M5 renames only one file");
    rn := renameResult(rdoc, rsyms, wordAt(rdoc, 14, 10),
                       "file:///tmp/tt_rename.s7i", "total", TRUE);
    check("and a .s7i buffer refuses while R-F10 stands", rn.why,
          "rename: /tmp/tt_rename.s7i is a library buffer whose symbols come from disk while" <&
          " R-F10 stands, so an edit could land on the wrong line");
    # ---- R51: two name records on the declaration line ------------------------------------
    # A WRITE finds a declaration by LINE: `declOccurrence' takes the first occurrence record on
    # it and `inScope' filters line-granularly, so when the routine and one of its parameters
    # share a name -- legal Seed7, measured, and reflection reports BOTH at the same line1 -- the
    # line holds two candidates and the edit cannot be proved. Three reaches, each measured on
    # this fixture at errorCount 0 BEFORE the arm existed: the cursor on the parameter `show'
    # answered 3 edits including the ROUTINE's own name and left `show(3);' at line 16 under the
    # old name (no add-back was involved -- the declaration line IS the line the body region opens
    # on, so inScope kept both records); the cursor on a body use of `tally' answered 2 edits, the
    # routine's name and the use, leaving the parameter's declaration and the call site; the cursor
    # on `tally(1, 2);' answered 3 edits INCLUDING the unrelated parameter, which spec 6's
    # "and nothing else" forbids. All three answer null now, and `delta' is the control: the same
    # two-line header, one record on its declaration line, renamed completely.
    setVersion(adoc, ambigText(), 1);
    ad := analyzeAll(adoc.text, noDirs, ambigPath);
    asyms := ad.syms;
    check("the shared-name fixture analyses clean", str(length(ad.parsed.diags)), "0");
    aword := wordAt(adoc, 3, 31);
    check("the cursor is on the parameter, not the routine name beside it",
          aword.word <& ":" <& str(aword.character1), "show:30");
    pc := prepareRenameAnswer(adoc, asyms, aword, ambigUri, TRUE);
    check("an ambiguous declaration line refuses prepareRename", str(pc.refused), "TRUE");
    check("and names the shape it cannot tell apart", pc.why, "prepareRename: show" <&
          DECL_AMBIG_TAIL);
    rn := renameResult(adoc, asyms, aword, ambigUri, "amount", TRUE);
    check("rename refuses the identical cursor rather than renaming the routine",
          str(rn.error = "") <& " " <& rn.json, "TRUE null");
    check("with the predicate's own sentence under this method's name", rn.why,
          "rename: show" <& DECL_AMBIG_TAIL);
    rn := renameResult(adoc, asyms, wordAt(adoc, 11, 13), ambigUri, "amount", TRUE);
    check("so does the body use, whose add-back has two candidates, with no result frame",
          str(rn.json = "null") <& " " <& rn.why,
          "TRUE rename: tally" <& DECL_AMBIG_TAIL);
    rn := renameResult(adoc, asyms, wordAt(adoc, 17, 5), ambigUri, "amount", TRUE);
    check("and so does the call site, where the cursor is on the routine itself",
          str(rn.json = "null") <& " " <& rn.why,
          "TRUE rename: tally" <& DECL_AMBIG_TAIL);
    rn := renameResult(adoc, asyms, wordAt(adoc, 11, 21), ambigUri, "amount", TRUE);
    check("the other parameter of the same header is renamed, both its records", rn.json,
          "{\"changes\":{\"file:///tmp/tt_ambig.sd7\":[{\"range\":{\"start\":{\"line\":9,"
          <& "\"character\":32},\"end\":{\"line\":9,\"character\":37}},\"newText\":\"amount\"},"
          <& "{\"range\":{\"start\":{\"line\":11,\"character\":20},\"end\":{\"line\":11,"
          <& "\"character\":25}},\"newText\":\"amount\"}]}}");

    # ---- the refusal sentence must describe the line, not a parameter (spec 11.12) ----------
    # The R51 arm's trigger is `more than one record of the name on the declaration line'. The
    # sentence it ships claimed the parameter shape, which spec 11.12 measured FALSE for this
    # input -- a file with no routine sharing a name with a parameter -- and left as one of "two
    # consequences still owed", batched for a whole-branch review that never ran. Measured here
    # before this block existed: refused=TRUE (so the REFUSAL checks below are green on sight --
    # they exist so that narrowing the arm back to parameters reddens them), and why was
    # "x shares its declaration line with another occurrence of it, the shape a parameter takes
    # when it is named after its routine, ...". Only the sentence is red until the arm speaks.
    setVersion(sdoc, sameLineText(), 1);
    sd := analyzeAll(sdoc.text, noDirs, sPath);
    ssyms := sd.syms;
    check("the same-line fixture analyses clean", str(length(sd.parsed.diags)), "0");
    check("the cursor is on the use in main, not on either record on the declaration line",
          wordAt(sdoc, 5, 13).word <& ":" <& str(wordAt(sdoc, 5, 13).character1), "x:12");
    pc := prepareRenameAnswer(sdoc, ssyms, wordAt(sdoc, 5, 13), sUri, TRUE);
    check("the second statement on the declaration line still refuses prepareRename",
          str(pc.refused), "TRUE");
    # The two assertions that make this a test rather than a transcription. A check that compared
    # `why' against a constant spelled in this same file would have passed for the wrong reason --
    # it would have moved with production and never asked whether the words are TRUE of this
    # input. What is askable here is absence: this file contains no routine and no parameter, so
    # a refusal sentence that names one is describing something it did not see. Both are red
    # against the shipped sentence, which reads "...the shape a parameter takes when it is named
    # after its routine...".
    checkTrue("the refusal names no parameter, because this file has none",
              pos(pc.why, "parameter") = 0);
    checkTrue("and no routine, for the same reason", pos(pc.why, "routine") = 0);
    check("so it states only what the arm counted: two records of the name on one line",
          pc.why, "prepareRename: x" <& DECL_AMBIG_TAIL);
    rn := renameResult(sdoc, ssyms, wordAt(sdoc, 5, 13), sUri, "amount", TRUE);
    check("rename refuses the same cursor with the same words",
          str(rn.error = "") <& " " <& rn.why, "TRUE rename: x" <& DECL_AMBIG_TAIL);

    # ---- a field access inside the symbol's own scope (spec 12.2) --------------------------
    # Measured on this fixture BEFORE the refusal arm existed (the run is in this branch's first
    # commit message): prepareRename accepted the cursor and rename answered SIX edits -- line 11
    # character 17 (the local's own declaration), line 13 characters 4 and 19, line 14 characters
    # 4, 15 and 29 -- of which line 13 character 19 and line 14 character 29 are `box.counter'.
    # The field's declaration is at line 3, OUTSIDE the window (10..15), so applying those edits
    # renames the field's USES and leaves the field: analysing the renamed text raises
    # `Match for {box . amount }' and `Declaration of "show (ref Widget: box)" failed'. A write
    # refuses rather than guessing. The target is `amount', not `total' -- `total' is a global in
    # this file, and a rename onto a declared name is the collision arm, not this one.
    setVersion(fdoc, fieldClashText(), 1);
    fd := analyzeAll(fdoc.text, noDirs, fPath);
    fsyms := fd.syms;
    check("the field-clash fixture analyses clean", str(length(fd.parsed.diags)), "0");
    check("the cursor is on show's local, not on the field access beside it",
          wordAt(fdoc, 13, 6).word <& ":" <& str(wordAt(fdoc, 13, 6).character1), "counter:4");
    pc := prepareRenameAnswer(fdoc, fsyms, wordAt(fdoc, 13, 6), fUri, TRUE);
    check("a field access inside the scope refuses prepareRename", str(pc.refused), "TRUE");
    check("and names the field as the reason", pc.why, "prepareRename: counter" <& FIELD_TAIL);
    rn := renameResult(fdoc, fsyms, wordAt(fdoc, 13, 6), fUri, "amount", TRUE);
    check("rename refuses the identical cursor rather than rewriting the field",
          str(rn.error = "") <& " " <& rn.json, "TRUE null");
    check("with the predicate's own sentence under this method's name", rn.why,
          "rename: counter" <& FIELD_TAIL);
    # The read keeps spec 12.2's over-inclusive list, and that is the decision -- but the list was
    # SILENT. Measured before the disclosure: the same cursor answered its six locations with
    # unresolved FALSE and no log line, and a resolved answer is what a client reads as "these are
    # the symbol's uses". So what is new here is the disclosure, not the width.
    ra := referencesAnswer(fdoc, fsyms, wordAt(fdoc, 13, 6), fUri, FALSE);
    check("references still lists every token of this spelling", str(uriCount(ra.json)), "6");
    check("but says the list also holds a name written after a dot", str(ra.unresolved), "TRUE");
    check("in its own sentence", ra.why,
          "references: counter is bound, but the list also holds a name written after a" <&
          " `.', which may be a record field of the same name");
    # The positive control, same document, same spelling, no field access in ITS scope: tally's
    # local still renames all four records. True today and true after the arm, and that is what
    # makes it a control -- what it would catch is an arm keyed on the document or on the type
    # instead of on scope, which is why it is one of the two checks the no-scope mutant reddens.
    pc := prepareRenameAnswer(fdoc, fsyms, wordAt(fdoc, 21, 6), fUri, TRUE);
    check("a local with no field access in its scope is still renamable",
          str(pc.refused), "FALSE");
    rn := renameResult(fdoc, fsyms, wordAt(fdoc, 21, 6), fUri, "amount", TRUE);
    check("and all four of its records are edited", str(editCount(rn.json)), "4");
    ra := referencesAnswer(fdoc, fsyms, wordAt(fdoc, 21, 6), fUri, FALSE);
    check("and its references stay silent, because there is nothing to disclose",
          str(ra.unresolved) <& " " <& str(uriCount(ra.json)), "FALSE 4");
    # The scope cost, measured rather than inferred. A global's window is the whole document, so
    # the same arm refuses the GLOBAL `total' for `b.total' at line 31 -- the refusal is correct
    # (renaming `total' would rewrite a field whose declaration the window also holds, at line 4,
    # under a name the struct never had) but it is an over-refusal for the case where the field
    # and the global are separable by column, which this index has no column for. Spec 12.2's
    # listed cost, stated plainly: the fix is the token-level index over `const type ... end
    # struct', not a narrower test here.
    # `character1' is the 0-based UTF-16 column -- the same unit occurrence.col16 carries, which
    # is why occurrenceAt can compare them directly. `column1' beside it is 1-based.
    check("the cursor is on the global's own declaration",
          wordAt(fdoc, 7, 15).word <& ":" <& str(wordAt(fdoc, 7, 15).character1), "total:13");
    pc := prepareRenameAnswer(fdoc, fsyms, wordAt(fdoc, 7, 15), fUri, TRUE);
    check("a global refuses on a field access anywhere in its window", str(pc.refused), "TRUE");
    check("naming the same reason", pc.why, "prepareRename: total" <& FIELD_TAIL);
    rn := renameResult(fdoc, fsyms, wordAt(fdoc, 7, 15), fUri, "amount", TRUE);
    check("and rename will not half-rewrite it", str(rn.error = "") <& " " <& rn.json,
          "TRUE null");

    # ---- `pix' in TWO structs (spec 9, answered by spec 12.2) -------------------------------
    # The cursor is on `x.pix' -- a field access -- in a file where `pix' is also Alpha's field, a
    # global and another routine's local. Expected BEFORE running it, from 12.2's answer: the read
    # over-includes and says so; the write refuses. Measured, and the two structs' field
    # DECLARATIONS are in the list (lines 4 and 8, 1-based), which is the whole point -- nothing in
    # this machine knows which struct a field belongs to, so a cursor on Alpha's field answers a
    # list that also holds Beta's. The global row binds the spelling first, so `resolveBinding'
    # never reaches its field row for this cursor and the answer is `resolved' with the field
    # disclosure rather than the unresolved one the single-struct field gets.
    setVersion(pdoc, twoStructText(), 1);
    pd := analyzeAll(pdoc.text, noDirs, pPath);
    psyms := pd.syms;
    check("the two-struct fixture analyses clean", str(length(pd.parsed.diags)), "0");
    pixWord := wordAt(pdoc, 24, 7);
    check("the cursor is on main's field access, at the column wordAt answers",
          pixWord.word <& ":" <& str(pixWord.line1) <& ":" <& str(pixWord.character1),
          "pix:25:6");
    ra := referencesAnswer(pdoc, psyms, pixWord, pUri, FALSE);
    check("references over-includes across both structs, and lists them in document order",
          ra.json,
          "[{\"uri\":\"file:///tmp/tt_two.sd7\",\"range\":" <&
          "{\"start\":{\"line\":3,\"character\":17},\"end\":{\"line\":3,\"character\":20}}}," <&
          "{\"uri\":\"file:///tmp/tt_two.sd7\",\"range\":" <&
          "{\"start\":{\"line\":7,\"character\":17},\"end\":{\"line\":7,\"character\":20}}}," <&
          "{\"uri\":\"file:///tmp/tt_two.sd7\",\"range\":" <&
          "{\"start\":{\"line\":10,\"character\":13},\"end\":{\"line\":10,\"character\":16}}}," <&
          "{\"uri\":\"file:///tmp/tt_two.sd7\",\"range\":" <&
          "{\"start\":{\"line\":24,\"character\":6},\"end\":{\"line\":24,\"character\":9}}}," <&
          "{\"uri\":\"file:///tmp/tt_two.sd7\",\"range\":" <&
          "{\"start\":{\"line\":25,\"character\":6},\"end\":{\"line\":25,\"character\":9}}}," <&
          "{\"uri\":\"file:///tmp/tt_two.sd7\",\"range\":" <&
          "{\"start\":{\"line\":26,\"character\":4},\"end\":{\"line\":26,\"character\":7}}}]");
    check("and it says the list holds both structs' fields", str(ra.unresolved), "TRUE");
    check("in the field sentence, not the unresolved one", ra.why,
          "references: pix is bound, but the list also holds a name written after a" <&
          " `.', which may be a record field of the same name");
    pc := prepareRenameAnswer(pdoc, psyms, pixWord, pUri, TRUE);
    check("prepareRename refuses a field access inside the symbol's window", str(pc.refused),
          "TRUE");
    rn := renameResult(pdoc, psyms, pixWord, pUri, "amount", TRUE);
    check("and rename answers null with no error, refusing to half-rewrite two structs",
          str(rn.error = "") <& " " <& rn.json, "TRUE null");
    # The same spelling under the routine that declares it as its OWN local: the window is show's
    # region, and it holds both `a.pix' and `b.pix' -- two different symbols' fields, one per
    # struct -- so the read is over-inclusive inside the window and the write refuses for the same
    # reason. Measured as four records: the local's declaration line and the three names on the
    # assignment line.
    ra := referencesAnswer(pdoc, psyms, wordAt(pdoc, 16, 15), pUri, FALSE);
    check("the field access inside a local of the same name answers its own window only",
          str(uriCount(ra.json)) <& " " <& str(endCount(ra.json)), "4 4");
    # The disclosure fires for this cursor too -- references.sd7 asks `scopeHasFieldAccess' of the
    # binding, and show's window holds one field of EACH struct -- so it is asserted here rather
    # than left inferred from the count above, which would pass silently if the sentence vanished.
    check("and it says so, with the field sentence for its own window",
          str(ra.unresolved) <& " " <& ra.why,
          "TRUE references: pix is bound, but the list also holds a name written after a" <&
          " `.', which may be a record field of the same name");
    pc := prepareRenameAnswer(pdoc, psyms, wordAt(pdoc, 16, 15), pUri, TRUE);
    check("and it is refused too, because both fields sit in that window",
          str(pc.refused) <& " " <& pc.why, "TRUE prepareRename: pix" <& FIELD_TAIL);

    # R47 through rename: capDoc holds MAX_OCCURRENCES + 1 statements and the cursor is on the
    # FIRST of them, so the record the range would take IS in the truncated list -- the gap that
    # made prepareRename accept a document rename can only half-edit.
    rn := renameResult(capDoc, countGlobalSyms(1), capWord, capUri, "total", TRUE);
    check("a capped document is refused rather than half-edited",
          str(rn.error = "") <& " " <& rn.json, "TRUE null");
    check("and the reason says the edit would miss what the list does not hold", rn.why,
          "rename: count has more occurrences than this server lists (more than 2000), so a" <&
          " rename could not rewrite all of them");
    # The positive control: the arm keys on the cap, not on how big the document is. One line
    # fewer and the same cursor edits all 2 000 records, which the refusal above must not do.
    setVersion(capDoc2, capLines(MAX_OCCURRENCES), 1);
    rn := renameResult(capDoc2, countGlobalSyms(1), wordAt(capDoc2, 0, 5), capUri, "total", TRUE);
    check("at exactly the cap the list is complete, so all 2000 are edited",
          str(editCount(rn.json)), "2000");
    check("and at exactly the cap nothing is refused",
          str(rn.error = "" and rn.json <> "null"), "TRUE");
    # ---- an operator is referenceable, and not renameable in either direction ----------------
    # The pass indexes TK_OP, so the `+' on refsText line 14 IS published by references (pinned
    # above, with its range) and its binding DOES resolve, through the library row -- owner
    # "library", resolved TRUE, declLine1 0, measured here -- yet occurrenceAt requires TK_NAME,
    # so the cursor leaves `slot' at 0 and renameDecision answers from the slot-0 arm.
    # lsp_server_test.sd7 already refuses `:=' on that same arm; what was unwitnessed here is the
    # refusal on an operator references has just published and resolved, which is the shape a
    # comment in occurrences_test.sd7 used to call renameable, and the other direction -- an
    # operator handed in as `newName', rejected by newNameProblem before any document is read.
    pc := prepareRenameAnswer(rdoc, rsyms, wordAt(rdoc, 14, 20), refUri, TRUE);
    check("an operator cursor is refused by prepareRename, and a refusal is null not an error",
          str(pc.refused) <& " " <& pc.json, "TRUE null");
    check("and the reason is the not-a-name arm, which speaks truly now",
          pc.why, "prepareRename: + is not a name");
    rn := renameResult(rdoc, rsyms, wordAt(rdoc, 14, 10), refUri, "<+>", TRUE);
    check("an operator NEW name is a rejection, not a refusal", rn.error, "invalid");
    # The sibling pin, because `error' alone says nothing about WHICH rejection: `<' fails
    # `startsName' and `+' / `>' fail `allNameChars', and the two arms emit the identical sentence
    # -- measured, `"1bad"' answers the same words -- so the sentence is the strongest statement
    # this input can make, and it is the one §6 quotes.
    check("and the rejection names the identifier rule beside the spelling", rn.why,
          "rename: <+> is not a Seed7 identifier");
    # A BUFFER-DECLARED operator is the other half of the claim, and the half no check reached:
    # row 2 of resolveBinding matches `syms[i].name = name' for ANY spelling, so `<+' declared in
    # the buffer gets a declaration record. Measured on this fixture before these checks existed:
    # reflection carries `const func integer: <+ (integer: x, integer: y)' at line1 5, the binding
    # answers owner "global", resolved TRUE, declLine1 5, scopeUncertain FALSE, the list holds 3
    # records -- the arms that speak for a bound name are all silent for it -- and
    # `slot' is STILL 0, because occurrenceAt gates on the token kind. So the refusal here comes
    # from the kind gate and nowhere else, which is the fact §6 has to state. The mutant that
    # proves it: drop `kind = TK_NAME' in occurrences.sd7's occurrenceAt and the refusal does not
    # move to another arm, it DISAPPEARS -- `slot' becomes 3, prepareRename answers a range for
    # `<+', and rename answers three edits, one of them inside the `$ syntax' rule. It used to
    # land one arm later, on `scopeHasFieldAccess' (the `$ syntax' rule writes `.(). <+ .()', so
    # record 1 is dot-preceded), and that arm is closed to an operator now that the predicate
    # counts NAMES only. Re-measured after that conjunction: the three expectations below are
    # reddened -- the slot pin by the new number, the two method pins by an ACCEPT -- which is the
    # stronger proof of the gate, because nothing else refuses an operator cursor. The library `+'
    # cursor, under the same mutant, is refused one arm later, by the library arm.
    setVersion(opDoc, opDeclText(), 1);
    opAn := analyzeAll(opDoc.text, noDirs, opPath);
    opSyms := opAn.syms;
    check("the operator-declaring fixture analyses clean", str(length(opAn.parsed.diags)), "0");
    opWord := wordAt(opDoc, 15, 15);
    check("the cursor is on the declared operator, not on the number beside it",
          opWord.word <& ":" <& str(opWord.character1), "<+:15");
    dec := renameDecision(opDoc, opSyms, opWord, opUri, TRUE);
    check("row 2 does bind it, so the refusal is the kind gate: slot 0 beside a real declaration",
          str(dec.slot) <& " " <& dec.b.owner <& " " <& str(dec.b.declLine1), "0 global 5");
    pc := prepareRenameAnswer(opDoc, opSyms, opWord, opUri, TRUE);
    check("a buffer-declared operator is refused, null, on the not-a-name arm",
          str(pc.refused) <& " " <& pc.json <& " " <& pc.why,
          "TRUE null prepareRename: <+ is not a name");
    rn := renameResult(opDoc, opSyms, opWord, opUri, "amount", TRUE);
    check("and rename refuses the identical cursor with the identical sentence",
          str(rn.error = "") <& " " <& rn.json <& " " <& rn.why,
          "TRUE null rename: <+ is not a name");
    # The READ on the same spelling, and here the refusal arms cannot speak, because references
    # publishes the list rather than declining it. What a `$ syntax' rule costs: Seed7 will not
    # parse a new operator symbol without one, and the rule is written `.(). <+ .()', so the token
    # immediately before the `<+' ON THAT LINE is a `.'. Measured: of the three `<+' records the
    # pass finds -- line 3 (the rule), line 5 (the header), line 16 (the use) -- only record 1
    # carries dotPrev, and all three are TK_OP. So scopeHasFieldAccess, which asked only whether a
    # record was dot-preceded and inside the window, answered TRUE for an operator, and an operator
    # is never a record field: the §12.2 disclosure claimed a possible field for a spelling that
    # cannot be one. Measured on this cursor before the kind test existed: three locations,
    # unresolved TRUE, and the field sentence. The `|' separates the two segments so an empty `why'
    # is visible as empty.
    ra := referencesAnswer(opDoc, opSyms, opWord, opUri, FALSE);
    check("the field disclosure speaks of names, so a declared operator discloses nothing",
          str(ra.unresolved) <& "|" <& ra.why, "FALSE|");
    # The rejections. `error' = "invalid" is what the dispatcher sends as -32602 InvalidParams,
    # and json stays "null" because no result goes out beside an error frame.
    rn := renameResult(rdoc, rsyms, wordAt(rdoc, 14, 10), refUri, "", TRUE);
    check("an empty name is rejected", rn.error, "invalid");
    check("and the line says so", rn.why, "rename: the new name is empty");
    rn := renameResult(rdoc, rsyms, wordAt(rdoc, 14, 10), refUri, "1bad", TRUE);
    check("a name that is not an identifier is rejected", rn.error, "invalid");
    check("naming the name and the rule", rn.why, "rename: 1bad is not a Seed7 identifier");
    rn := renameResult(rdoc, rsyms, wordAt(rdoc, 14, 10), refUri, "two words", TRUE);
    check("a space is not a name character either", rn.why,
          "rename: two words is not a Seed7 identifier");
    rn := renameResult(rdoc, rsyms, wordAt(rdoc, 14, 10), refUri, "begin", TRUE);
    check("a keyword is rejected as a new name", rn.error, "invalid");
    check("and is named as syntax, not as a word that happens to be unbound", rn.why,
          "rename: begin is a Seed7 keyword, so it would rewrite syntax");
    # The gate is the 63 words the INTERPRETER refuses, not completion's vocabulary: `type' is in
    # that vocabulary and is a legal name, so renaming onto it must be allowed. A LOCAL's collision
    # set is its own routine's scope entries plus the routine's name (rename.sd7's `collides'), so
    # this cursor never consults the buffer's routine records -- what it exercises is the gate.
    rn := renameResult(rdoc, rsyms, wordAt(rdoc, 14, 10), refUri, "type", TRUE);
    check("renaming a local onto a word only completion's vocabulary knows is allowed",
          str(rn.error = "") <& " " <& str(editCount(rn.json)), "TRUE 3");
    # Validation runs BEFORE the predicate, so a cursor that would be refused anyway still gets
    # -32602 for a name that could never be written. Swap the two and this answers null.
    rn := renameResult(rdoc, rsyms, wordAt(rdoc, 24, 6), refUri, "1bad", TRUE);
    check("a bad newName is rejected before the document is read",
          str(rn.json = "null") <& " " <& rn.error, "TRUE invalid");
    # The collision set is the symbol's OWN scope (spec 6), so one target name is a collision for
    # one cursor and free for another. `Widget' is a buffer TYPE -- two `var integer: Widget' raise
    # REDECLARATION, measured; `show' is a buffer ROUTINE -- `var integer: show' beside
    # `const proc: show' analyses CLEAN, measured, which is why a same-named routine must not
    # block the rename; `writeln' is the library's and is out of both sets.
    rn := renameResult(rdoc, rsyms, wordAt(rdoc, 7, 15), refUri, "Widget", TRUE);
    check("a global cannot take a type this buffer declares", rn.error, "invalid");
    check("and the line names the scope it collides in", rn.why,
          "rename: Widget is already declared in the scope of counter, so the rename would" <&
          " not compile");
    rn := renameResult(rdoc, rsyms, wordAt(rdoc, 7, 15), refUri, "show", TRUE);
    check("a same-named routine elsewhere in the file is not a collision",
          str(rn.error = "") <& " " <& str(editCount(rn.json)), "TRUE 2");
    rn := renameResult(rdoc, rsyms, wordAt(rdoc, 14, 10), refUri, "left", TRUE);
    check("a local collides with its own routine's parameter", rn.error, "invalid");
    rn := renameResult(rdoc, rsyms, wordAt(rdoc, 14, 10), refUri, "show", TRUE);
    check("a local collides with its own routine's name", rn.error, "invalid");
    rn := renameResult(rdoc, rsyms, wordAt(rdoc, 14, 10), refUri, "writeln", TRUE);
    check("a stdlib name is not a collision",
          str(rn.error = "") <& " " <& str(editCount(rn.json)), "TRUE 3");
    report("features");
  end func;
