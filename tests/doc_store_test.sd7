$ include "seed7_05.s7i";
  include "lsp_tst.sd7";
  include "doc_store.sd7";


# A document whose first line is a char literal written one of Seed7's ways, followed by a
# declaration that must still be findable. `content` is the literal's inner text as real file
# bytes: chr(39) is a quote, chr(92) a backslash -- assembled with chr() so no
const proc: charForm (in string: title, in string: content) is func
  local
    var lsDoc: d is lsDoc.value;
    var string: text is "";
  begin
    text := "const set of char: c is {" <& chr(39) <& content <& chr(39) <& "};" <&
            chr(10) <& "const integer: afterIt is 1;" <& chr(10);
    setVersion(d, text, 1);
    check(title, wordAt(d, 1, 20).word, "afterIt");
  end func;

const func integer: countChars (in string: text, in char: ch) is func
  result
    var integer: out is 0;
  local
    var integer: i is 0;
  begin
    for i range 1 to length(text) do
      if text[i] = ch then
        out +:= 1;
      end if;
    end for;
  end func;

# Every column/width pair on one line, counted where the UTF-16-unit entry point and the
# character-column pair builder DISAGREE. On an ASCII line the two bases are the same
# numbers, so the count must be 0; on the astral line it must not be, which is what makes
# that 0 a claim about the rule instead of a tautology (a check that passes whichever way
# the conversion goes is the defect class this suite keeps tripping over).
const func integer: unitDisagreements (in lsDoc: doc, in integer: line0,
                                       in integer: lastCol) is func
  result
    var integer: out is 0;
  local
    var integer: col is 0;
    var integer: wide is 0;
  begin
    out := 0;
    for col range 0 to lastCol do
      for wide range 1 to 5 do
        if lspRangeUnits(doc, line0, col, wide) <>
           lspRangePair(doc, succ(line0), succ(col), wide) then
          out +:= 1;
        end if;
      end for;
    end for;
  end func;

const proc: main is func
  local
    var lsDoc: doc is lsDoc.value;
    var lsDoc: crlf is lsDoc.value;
    var lsDoc: two is lsDoc.value;
    var lsDoc: op is lsDoc.value;
    var lsDoc: masked is lsDoc.value;
    var lsDoc: astral is lsDoc.value;
    var wordRef: w is wordRef.value;
    var string: bLine is "";
  begin
    check("lineStarts count", str(length(lineStarts("a\nbb\r\nccc"))), "3");
    check("lineStarts third", str(lineStarts("a\nbb\r\nccc")[3]), "7");
    setVersion(doc, "abc\nä€ 日本\nx", 1);
    check("line1 char0",   lspRange(doc, 1, 1), "{\"line\":0,\"character\":0}");
    check("line2 col1",    lspRange(doc, 2, 1), "{\"line\":1,\"character\":0}");
    check("line2 after 3 chars", lspRange(doc, 2, 4), "{\"line\":1,\"character\":3}");
    check("col past eol clamps", lspRange(doc, 1, 99), "{\"line\":0,\"character\":3}");
    check("line past eof clamps", lspRange(doc, 99, 1), "{\"line\":2,\"character\":0}");
    check("column 0 keeps lspRange total", lspRange(doc, 0, 0), "{\"line\":0,\"character\":0}");
    setVersion(crlf, "ab\r\ncd", 1);
    check("crlf second line start", lspRange(crlf, 2, 1), "{\"line\":1,\"character\":0}");
    # (was) utf16Before's two astral checks, re-aimed at the line-local helper.
    check("astral counts twice", str(unitsOfPrefix("a\128512;b", 1, 2)), "3");
    check("trailing b counted", str(unitsOfPrefix("a\128512;b", 1, 3)), "4");
    # The guard the caller's clamp cannot reach: the walk stops at its own line break.
    check("count stops at the newline",  str(unitsOfPrefix("ab\ncd", 1, 4)), "2");
    check("count stops at a CR",         str(unitsOfPrefix("a\r\nb", 1, 4)), "1");
    # Equivalence pins through the product function, on a line holding an astral
    # character ahead of the column, and the past-the-end clamp of the same line.
    setVersion(astral, "u := " <& chr(34) <& chr(128512) <& chr(34) <&
                       "; v := 1;" <& chr(10), 1);
    check("lspRange before the astral", lspRange(astral, 1, 7),
          "{\"line\":0,\"character\":6}");
    check("lspRange past the astral",   lspRange(astral, 1, 8),
          "{\"line\":0,\"character\":8}");
    check("lspRange past eol on an astral line", lspRange(astral, 1, 99),
          "{\"line\":0,\"character\":18}");
    check("version stored", str(crlf.version), "1");
    setVersion(two, "  const proc: main is func\n    writeln(x);\n", 1);
    w := wordAt(two, 1, 6);
    check("left-of-character wins", w.word, "writeln");
    check("word line is 1-based", str(w.line1), "2");
    check("word column is line-relative and 1-based", str(w.column1), "5");
    check("word width", str(w.width), "7");
    check("cursor just left of the token", wordAt(two, 1, 4).word, "writeln");
    check("inside indentation there is no word", wordAt(two, 1, 1).word, "");
    check("mid-line word", wordAt(two, 0, 10).word, "proc");
    check("hover the end of const", wordAt(two, 0, 7).word, "const");
    check("hover past the line end finds the last token", wordAt(two, 0, 99).word, "func");
    check("a position past the line end stops at the terminator",
          str(charIndexOf(two, 1, 99)),
          str(two.lineStart[2] + lineWidth(two.text, two.lineStart[2])));
    check("an out-of-range line is one past the text", str(charIndexOf(two, 400, 0)),
          str(length(two.text) + 1));
    check("absurd line has no word", wordAt(two, 400, 0).word, "");
    # a truncated buffer -- the normal state while typing -- has no trailing newline, and
    # the cursor sits one past the last character: the guard in wordAt is on the character
    # it looks at, not on the position to its right, and this is the case that proves it.
    setVersion(two, "  const proc: main is func\n    writeln(x);", 2);
    check("last token of a buffer with no trailing newline", wordAt(two, 1, 15).word, ";");
    check("one past the end of that line", wordAt(two, 1, 16).word, ";");
    setVersion(op, "a<&b\n", 1);
    check("operator run is one word", wordAt(op, 0, 2).word, "<&");
    check("name char before an operator", wordAt(op, 0, 1).word, "a");
    check("range pair", lspRangePair(op, 1, 1, 1),
          "{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}}");
    check("whole line range needs no document", lspWholeLine(13),
          "{\"start\":{\"line\":12,\"character\":0},\"end\":{\"line\":13,\"character\":0}}");
    setVersion(masked,
      "const integer: a is 1;  # a comment word\n" &
      "(* outer (* inner *) still comment *)\n" &
      "const integer: b is 2;\n" &
      "writeln(\"quoted word\");\n", 1);
    check("word inside a line comment is not offered", wordAt(masked, 0, 33).word, "");
    check("word before a line comment still resolves", wordAt(masked, 0, 8).word, "integer");
    check("word inside a nested comment is not offered", wordAt(masked, 1, 34).word, "");
    check("a real declaration after the comment resolves", wordAt(masked, 2, 12).word, "integer");
    check("word inside a string literal is not offered", wordAt(masked, 3, 17).word, "");
    check("the call before the string still resolves", wordAt(masked, 3, 7).word, "writeln");
    # Asserted as properties, not offsets: what a consumer depends on is that the code
    # survives, the text inside the regions does not, and the lengths still line up --
    # codeText is used to answer questions about positions in the ORIGINAL text.
    checkTrue("masking does not change the length",
              length(codeText(masked)) = length(masked.text));
    checkTrue("masking keeps every line break where it was",
              countChars(codeText(masked), chr(10)) = countChars(masked.text, chr(10)));
    checkTrue("the comment body is gone", pos(codeText(masked), "comment word") = 0);
    checkTrue("the string body is gone", pos(codeText(masked), "quoted word") = 0);
    checkTrue("the code after them is intact",
              pos(codeText(masked), "const integer: b") <> 0 and
              pos(codeText(masked), "writeln") <> 0);
    # the delimiting punctuation around a literal has to survive the mask; a machine that
    # consumes the wrong number of characters eats the "}" and ";" as well and the check
    # below is what notices.
    setVersion(masked, "const set of char: c is {'" <& chr(92) <& chr(39) <&
                      "'};\nwriteln(1);" <& chr(10), 1);
    checkTrue("the literal delimiters do not leak past the closing quote",
              pos(codeText(masked), "};") <> 0 and pos(codeText(masked), "writeln(1)") <> 0);
    checkTrue("the literal itself is gone", pos(codeText(masked), chr(92)) = 0);
    charForm("char literal: plain letter", "a");
    # a bare three-quote spelling is not a Seed7 char literal; the quote
    # character is written with an escape, which the escaped-quote case covers
    charForm("char literal: escaped backslash", "" <& chr(92) <& chr(92));
    charForm("char literal: escaped quote", "" <& chr(92) <& chr(39));
    charForm("char literal: a double quote", "" <& chr(34));
    charForm("char literal: a hash", "#");
    # charColumnForBytes is the mapping the analyzer's columns need; the astral case is
    # the one that separates a character index from a UTF-16 unit index, because the LSP
    # position must be counted in units.
    setVersion(doc, "const string: s is \"ππ\\z\";\n", 1);
    bLine := lspRangeBytes(doc, 1, 26);
    check("byte 26 of a line with two 2-byte chars -> character 23", bLine,
          "{\"line\":0,\"character\":23}");
    bLine := lspRangeBytes(doc, 1, 2147483647);
    check("an absurd byte column clamps to the line length", bLine,
          "{\"line\":0,\"character\":26}");
    # lspRangeBytes indexes the line-start table itself, so the clamp has to be proven
    # from both sides: a line below the buffer and a line past it must map, not raise.
    bLine := lspRangeBytes(doc, 0, 26);
    check("a line below range still maps its byte", bLine,
          "{\"line\":0,\"character\":23}");
    bLine := lspRangeBytes(doc, 99, 26);
    check("a line past the buffer still answers, clamped", bLine,
          "{\"line\":1,\"character\":0}");
    setVersion(doc, "const string: s is \"\128169;\\z\";\n", 1);
    bLine := lspRangeBytes(doc, 1, 26);
    check("byte 26 after an astral char -> character 23 (utf-16 units)", bLine,
          "{\"line\":0,\"character\":23}");
    # A byte strictly inside a multi-byte character names that character: the astral
    # char occupies bytes 21-24 of this line, and it sits at UTF-16 unit 20.
    bLine := lspRangeBytes(doc, 1, 23);
    check("a byte inside an astral char names that char", bLine,
          "{\"line\":0,\"character\":20}");
    # '#' between a digit and an extended digit is the radix separator of a based
    # literal (manual/tokens.htm: based_integer ::= '#' extended_digit { extended_digit }).
    # Masking it as a line comment hid the rest of every line that contains 16#beef.
    setVersion(doc, "const integer: y is 16#beef + afterThis;\n", 1);
    check("a name after a based literal is still code", wordAt(doc, 0, 35).word,
          "afterThis");
    check("a line of pure code masks to itself", codeText(doc),
          "const integer: y is 16#beef + afterThis;\n");
    setVersion(doc, "const integer: y is 16#beef; # hiddenWord\n", 1);
    check("a real comment after a based literal still hides",
          str(pos(codeText(doc), "hiddenWord")), "0");
    check("the code before that comment survives", codeText(doc)[1 .. 28],
          "const integer: y is 16#beef;");
    setVersion(doc, "const integer: w is 16#ff + 8#77; # tail\n", 1);
    check("two based literals on one line", codeText(doc)[1 .. 33],
          "const integer: w is 16#ff + 8#77;");
    check("and the comment is still a comment", str(pos(codeText(doc), "tail")), "0");
    setVersion(doc, "const integer: v is 1#;\n", 1);
    check("a hash with no extended digit after it is a comment", codeText(doc),
          "const integer: v is 1  \n");
    setVersion(doc, "# hashFirst\nconst integer: keepMe is 1;\n", 1);
    check("a hash that opens the line is still a comment",
          str(pos(codeText(doc), "hashFirst")), "0");
    check("and the next line is still code", wordAt(doc, 1, 21).word, "keepMe");
    # The astral character inside the string literal is two UTF-16 units but one character;
    # the old masked computation flattened it to one space, so the column of 'zzz' was wrong.
    # The scanner-based wordAt reports the real UTF-16 column from the token.
    setVersion(doc, "\"x\128169;y\" zzz", 1);
    check("a name after an astral string keeps its real UTF-16 column",
          str(wordAt(doc, 0, 7).character1), "7");
    # A non-ASCII character is one TK_ILLEGAL token in the scanner, but wordAt suppresses
    # it so hovering a control character does not offer a one-character word. The old
    # character-run machine returned nothing for it; the suppression preserves that.
    setVersion(doc, "a \8; b", 1);
    check("a non-ASCII character under the cursor answers nothing",
          wordAt(doc, 0, 2).word, "");
    # Two guards in the scanner's pastNumber that no fixture above reaches. The first is the one
    # standing between this rule and a comment leak: '#' after a non-digit must comment,
    # and only the left-neighbour test says so. The second is the truncated buffer a
    # typist actually has -- '#' as the last character of the document -- where reading
    # text[succ(i)] would raise and cost the client a request.
    setVersion(doc, "const integer: n is 2;#tightNote\n", 1);
    check("a comment tight against code is still a comment",
          str(pos(codeText(doc), "tightNote")), "0");
    setVersion(doc, "const integer: q is 16#", 1);
    check("a document ending in a lone hash answers without raising",
          str(length(codeText(doc))), str(length(doc.text)));
    # lspRangeUnits takes the UTF-16 column as the scanner measured it and does not convert
    # it. This line is 22 characters but 24 UTF-16 units, and "count" starts at unit 13 --
    # character 11 -- so the two bases name different columns and only one of them is LSP.
    setVersion(doc, "x := \"\128512;\128512;\"; count := 1;\n", 1);
    check("a UTF-16 column is used as given", lspRangeUnits(doc, 0, 13, 5),
          "{\"start\":{\"line\":0,\"character\":13},\"end\":{\"line\":0,\"character\":18}}");
    # that line is 22 characters but 24 UTF-16 units: an absurd column clamps to 24, twice
    check("an absurd column clamps to the line width", lspRangeUnits(doc, 0, 999, 5),
          "{\"start\":{\"line\":0,\"character\":24},\"end\":{\"line\":0,\"character\":24}}");
    check("a column of 0 names the line start", lspRangeUnits(doc, 0, 0, 1),
          "{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}}");
    # Tasks 7-9 build ranges from (line0, col16, width16) on ASCII lines too, where the
    # unit column and the character column are the same number. Sweeping every column of
    # this ASCII line -- including the ones past its end, which both paths clamp -- is what
    # pins that the new entry point does not shift the ordinary case.
    setVersion(two, "writeln(count);\nconst integer: n is 1;\n", 1);
    check("the unit path matches the character path on every ASCII column",
          str(unitDisagreements(two, 0, 30)), "0");
    # ...and the sweep can fail: the same columns on the astral line disagree, so the 0
    # above is not a comparison of a function with itself.
    checkTrue("the same sweep does disagree on the astral line",
              unitDisagreements(doc, 0, 30) > 0);
    report("doc_store");
  end func;
