$ include "seed7_05.s7i";
  include "lsp_tst.sd7";
  include "analysis.sd7";
  include "occurrences.sd7";

# "line0:col16:width16" of the i'th occurrence, or "none".
const func string: at (in array occurrence: oc, in integer: i) is func
  result
    var string: out is "none";
  begin
    if i >= 1 and i <= length(oc) then
      out := str(oc[i].line0) & ":" & str(oc[i].col16) & ":" & str(oc[i].width16);
    end if;
  end func;

# `dotPrev' of the i'th occurrence as "TRUE"/"FALSE", or "none" outside the array. The four flag
# pins below ask for a FIELD of a record, which `at' cannot answer, and a bare `oc[1].dotPrev' on a
# fixture a mutant shortened would raise INDEX_ERROR on stdout -- costing the suite its graded line
# instead of naming the check. Same degrading rule as `at' and `recAt'.
const func string: dotAt (in array occurrence: oc, in integer: i) is func
  result
    var string: out is "none";
  begin
    if i >= 1 and i <= length(oc) then
      out := str(oc[i].dotPrev);
    end if;
  end func;

# "name/line1" of syms[i], or "none" for an index outside the array -- the shape of an UNSET
# ownerSym. Degrading, not indexing syms[0], keeps a mutant's INDEX_ERROR off stdout, where it
# would cost the suite its graded line rather than name the check that failed.
const func string: recAt (in array symRec: syms, in integer: i) is func
  result
    var string: out is "none";
  begin
    if i >= 1 and i <= length(syms) then
      out := syms[i].name <& "/" <& str(syms[i].line1);
    end if;
  end func;

const func string: readAll (in string: path) is func
  result
    var string: out is "";
  local
    var file: f is STD_NULL;
    var string: one is "";
  begin
    block
      f := open(path, "r");
      while not eof(f) do
        readln(f, one);
        out &:= one <& "\n";
      end while;
      close(f);
    exception
      catch FILE_ERROR:
        out := "";
    end block;
  end func;

# The last line index of a text, on the same model as doc_store.lineCount: a trailing break
# leaves a phantom empty line, and readAll appends one break per line it reads -- so the
# fixture file's 43 lines arrive as 44 breaks and lastLine is 44, not 42. Every scope pin
# below is computed from the text handed to resolveBinding, never counted by hand.
const func integer: linesIn (in string: text) is func
  result
    var integer: out is 1;
  local
    var integer: i is 0;
  begin
    for i range 1 to length(text) do
      if text[i] = '\n' then
        out +:= 1;
      end if;
    end for;
  end func;

const func docAnalysis: analysisOf (in string: text, in string: docPath) is func
  result
    var docAnalysis: out is docAnalysis.value;
  local
    var array string: dirs is 0 times "";
  begin
    out := analyzeAll(text, dirs, docPath);
  end func;

# `bind' with the slot of the record that IS the cursor's token, which is what resolveBinding's
# row 4 now reads for its field answer: a test that puts the cursor on a token has to say WHICH
# record it is on, and a test that does not forwards 0 -- the same input the features hand in when
# `occurrenceAt' finds nothing indexable under the cursor.
const func binding: bindAt (in string: text, in array symRec: syms, in string: name,
                            in integer: line0, in integer: lastLine, in string: docPath,
                            in integer: slot) is func
  result
    var binding: out is binding.value;
  begin
    out := resolveBinding(text, syms, occurrencesOf(text, name), name, line0, lastLine,
                          docPath, slot);
  end func;

# The call shape Task 7 will use: the occurrence list is computed from the same text BEFORE
# resolution and handed in, so `capped' is a fact about the list the caller is going to publish
# rather than about a second pass over the document.
const func binding: bind (in string: text, in array symRec: syms, in string: name,
                          in integer: line0, in integer: lastLine,
                          in string: docPath) is func
  result
    var binding: out is binding.value;
  begin
    out := bindAt(text, syms, name, line0, lastLine, docPath, 0);
  end func;

# Every binding field except the two scope pins, in one string, so a failing check shows all
# of them: name|owner|resolved|keyword|capped|declLine1.
const func string: bindPin (in binding: b) is func
  result
    var string: out is "";
  begin
    out := b.name <& "|" <& b.owner <& "|" <& str(b.resolved) <& "|" <& str(b.keyword) <&
           "|" <& str(b.capped) <& "|" <& str(b.declLine1);
  end func;

const func string: scopePin (in binding: b) is func
  result
    var string: out is "";
  begin
    out := str(b.scopeStart) <& "-" <& str(b.scopeStop);
  end func;

# The excluded regions as ONE string. The order is the order the subtraction met them -- symRec
# order, which is the order reflection reported the declarations -- and NOT part of the contract:
# spec section 4 promises the SET of shadowing regions, so a check reading this pin is pinned to
# record order and would have to be re-read if analysis.sd7 ever sorted its records.
const func string: excludedPin (in binding: b) is func
  result
    var string: out is "";
  local
    var integer: i is 0;
  begin
    for i range 1 to length(b.excluded) do
      if out <> "" then
        out &:= " ";
      end if;
      out &:= str(b.excluded[i].startLine) <& "-" <& str(b.excluded[i].endLine);
    end for;
  end func;

# The surviving occurrences as line0 values, so one check pins WHICH are kept and not only
# how many: a filter that kept the wrong five would pass a length check.
const func string: linesPin (in array occurrence: oc) is func
  result
    var string: out is "";
  local
    var integer: i is 0;
  begin
    for i range 1 to length(oc) do
      if out <> "" then
        out &:= " ";
      end if;
      out &:= str(oc[i].line0);
    end for;
  end func;

# Test-only, per Task 6's brief: the buffer routines whose own scope carries `name`, with the
# count in front. This is the set the global row's subtraction has to exclude, listed from the
# analyzer's records rather than from the binding under test, so the two cannot agree by
# construction.
const func array string: shadowing (in array symRec: syms, in string: name,
                                    in string: docPath) is func
  result
    var array string: out is 0 times "";
  local
    var integer: i is 0;
    var integer: j is 0;
  begin
    for i range 1 to length(syms) do
      if isBufferFile(syms[i].file, docPath) then
        for j range 1 to length(syms[i].locals) do
          if syms[i].locals[j].name = name then
            out &:= syms[i].name;
          end if;
        end for;
      end if;
    end for;
  end func;

const func string: shadowPin (in array string: names) is func
  result
    var string: out is "";
  local
    var integer: i is 0;
  begin
    # a result variable cannot be initialised from a parameter of its own function
    out := str(length(names));
    for i range 1 to length(names) do
      out &:= " " <& names[i];
    end for;
  end func;

const proc: main is func
  local
    var string: fixPath is "tests/programs/binding.sd7";
    var string: DOC is "/tmp/binding.sd7";
    var string: text is "";
    var docAnalysis: d is docAnalysis.value;
    var array symRec: syms is 0 times symRec.value;
    var array occurrence: oc is 0 times occurrence.value;
    var binding: b is binding.value;
    var integer: lastLine is 0;
    var string: truncated is "";
    var docAnalysis: td is docAnalysis.value;
    var array symRec: tsyms is 0 times symRec.value;
    var string: oneLine is "";
    var docAnalysis: od is docAnalysis.value;
    var array symRec: osyms is 0 times symRec.value;
    var string: mixed is "";
    var docAnalysis: md is docAnalysis.value;
    var array symRec: msyms is 0 times symRec.value;
    var integer: mlast is 0;
    var array occurrence: moc is 0 times occurrence.value;
    var string: libPath is "";
    var file: libDoc is STD_NULL;
    var string: libText is "";
    var docAnalysis: ld is docAnalysis.value;
    var array symRec: lsyms is 0 times symRec.value;
    var string: lib2Path is "";
    var file: lib2Doc is STD_NULL;
    var string: lib2Text is "";
    var docAnalysis: l2d is docAnalysis.value;
    var array symRec: l2syms is 0 times symRec.value;
    var string: nested is "";
    var docAnalysis: nd is docAnalysis.value;
    var array symRec: nsyms is 0 times symRec.value;
    var string: capText is "";
    var string: pixOneLine is "";
    var string: pixTwoLines is "";
    var string: pixAfterBreak is "";
    var string: contText is "";
    var string: quoteText is "";
    var array occurrence: pixOc is 0 times occurrence.value;
    var cursorRefs: cr is cursorRefs.value;
    var array symRec: noSyms is 0 times symRec.value;
    var integer: i is 0;
  begin
    # ---- the fixture, and the proof that it is the analysable one ----------------
    text := readAll(fixPath);
    d := analysisOf(text, DOC);
    syms := d.syms;
    lastLine := pred(linesIn(text));
    check("the binding fixture analyses clean", str(length(d.parsed.diags)), "0");

    # ---- row 1: a name the enclosing routine declares in its own scope -----------
    # alpha's parameter `count' (line1 17) at a cursor inside alpha's body region 16-23.
    b := bind(text, syms, "count", 21, lastLine, DOC);
    check("inside a routine its own scope entry wins over the global of the same name",
          bindPin(b), "count|local|TRUE|FALSE|FALSE|17");
    check("a local's scope is its routine's region", scopePin(b), "16-23");
    check("a local excludes nothing", excludedPin(b), "");
    oc := occurrencesOf(text, "count");
    check("every occurrence of the name is found before scope is applied",
          str(length(oc)), "12");
    check("a local keeps only the occurrences inside its region",
          linesPin(inScope(oc, b)), "16 20 20 21 22");
    # the same row in a second routine, so the first is not one lucky record: beta's
    # `count' is a LOCALVOBJECT (line1 28) where alpha's is a REFPARAMOBJECT.
    b := bind(text, syms, "count", 29, lastLine, DOC);
    check("a second routine's own local binds the same way",
          bindPin(b), "count|local|TRUE|FALSE|FALSE|28");
    check("and its scope is that routine's region, not the first one's",
          scopePin(b), "25-31");
    check("and it keeps its own three occurrences", linesPin(inScope(oc, b)), "27 29 30");
    # Pinned by NAME and line, so it does not shift when a task adds a record above it. beta is
    # the witness because alpha carries `count' earlier in record order and is skipped (region
    # 16-23 does not hold the cursor), so this names the OWNER, not the first carrier. Written
    # after the field existed, so it passes on sight; the mutant that reddens it is in the commit.
    check("the local binding carries the record whose scope holds it", recAt(syms, b.ownerSym),
          "beta/26");
    # a local VARIABLE of the routine the cursor is in, declared two lines below its header
    b := bind(text, syms, "total", 20, lastLine, DOC);
    check("a local variable binds like a parameter",
          bindPin(b), "total|local|TRUE|FALSE|FALSE|19");

    # ---- row 2: a declaration of this buffer, minus what shadows it --------------
    b := bind(text, syms, "count", 38, lastLine, DOC);
    check("outside every routine that declares it, the buffer declaration is the answer",
          bindPin(b), "count|global|TRUE|FALSE|FALSE|8");
    check("a global's scope is the whole document", scopePin(b), "0-44");
    check("the subtraction names exactly the routines whose scope carries the name",
          excludedPin(b), "16-23 25-31");
    check("an ordinary file subtracts every shadowing region, so its scope is certain",
          str(b.scopeUncertain), "FALSE");
    check("a global drops every occurrence inside a shadowing region",
          linesPin(inScope(oc, b)), "7 38 39 41");
    check("the shadowing set the subtraction owes",
          shadowPin(shadowing(syms, "count", DOC)), "2 alpha beta");

    # ---- row 3: a name only a library declares -----------------------------------
    b := bind(text, syms, "writeln", 41, lastLine, DOC);
    check("a name only the library declares is a library symbol",
          bindPin(b), "writeln|library|TRUE|FALSE|FALSE|0");
    check("a library symbol still answers the whole document", scopePin(b), "0-44");
    check("and a library declaration line is not a line of this document",
          str(b.declLine1), "0");
    # R36's ordering: the gate runs after rows 1 and 2 and BEFORE the library row. `for' is one
    # of the 63 words the interpreter refuses as a declared name (src/keywords.sd7) AND an
    # ACTOBJECT globalObjects really reports -- 52 records of it in this fixture's parse -- so a
    # library row reached first answers "library" and references lists every `for', `in', `is'
    # and `to' in the file. Nothing a user declares can carry a gated word, so the records the
    # gate now outranks are only the analyzer's own, while rows 1 and 2 still run first for the
    # sake of a declared name that merely LOOKS like furniture (see the `type' check below).
    b := bind(text, syms, "for", 38, lastLine, DOC);
    check("a gated word the analyzer reports as an object is answered before the library row",
          bindPin(b), "for||FALSE|TRUE|FALSE|0");

    # ---- row 4: a struct field, which has no declaration source at all -----------
    # `box.pix' at line0 37, col16 8 -- the slot is LOOKED UP, not hand-counted, so an edit to the
    # fixture moves the answer instead of raising INDEX_ERROR past the array. globalObjects reports
    # Widget and never pix (spec 11.10), so this is over-included with a log line by the
    # controller's 12.2 ruling, not proven.
    b := bindAt(text, syms, "pix", 37, lastLine, DOC,
                occurrenceAt(occurrencesOf(text, "pix"), 37, 8));
    check("a dot-selected name is a field, and says it is not proven",
          bindPin(b), "pix|field|FALSE|FALSE|FALSE|0");
    b := bindAt(text, syms, "pix", 4, lastLine, DOC,
                occurrenceAt(occurrencesOf(text, "pix"), 4, 17));
    check("the same name on its own declaration line is no field",
          bindPin(b), "pix||FALSE|FALSE|FALSE|0");
    b := bind(text, syms, "total", 38, lastLine, DOC);
    check("a routine's own name used outside its region is over-included, not proven",
          bindPin(b), "total|field|FALSE|FALSE|FALSE|0");

    # The two shapes of one spelling, pinned separately. `pix' here is bound by nothing -- no
    # declaration, no scope entry, no library record -- so row 4 is the only thing that can call
    # it a field, and row 4 reads the record `occurrenceAt' names. The discriminating input is the
    # one-line text: walking the LINE labels both tokens `field' (measured -- the first binding check
    # below went red against the shipped code with got TRUE), reading the cursor's own record labels
    # only the one the dot really precedes. The cross-line pair after it is NOT discriminating for
    # THAT question -- the line-wide test and the cursor's own record answer it alike -- and it stays
    # pinned because WHICH record the slot names is the contract: row 4 reading `oc[1]' for every
    # cursor reddens three checks, measured. The last two blocks state the crossing rule, once per
    # level: the flag itself, then the same cursor seen through `resolveBinding'.
    pixOneLine := "    pix := 1; box.pix := 2;\n";
    pixTwoLines := "    pix := 1;\n  box.pix := 2;\n";
    pixAfterBreak := "    box.\n      pix := 1;\n";
    # The seam every caller now stands on, asked directly. Nothing else in any suite calls
    # `occurrenceAt' -- the features reach it only through a slot no test asserts -- so every number
    # here is a probe print, not arithmetic: occurrencesOf(pixOneLine, "pix") answers 1 = line0 0
    # col16 4 dotPrev FALSE and 2 = line0 0 col16 18 dotPrev TRUE; its ":=" records are line0 0
    # col16 8 and col16 22, both TK_OP; occurrencesOf(pixTwoLines, "pix") answers 1 = line0 0
    # col16 4 and 2 = line0 1 col16 6; occurrencesOf(pixAfterBreak, "pix") answers 1 = line0 1
    # col16 6.
    pixOc := occurrencesOf(pixOneLine, "pix");
    check("the record under a cursor on the dotted pix is the second one",
          str(occurrenceAt(pixOc, 0, 18)), "2");
    check("and under the bare pix on that same line it is the first",
          str(occurrenceAt(pixOc, 0, 4)), "1");
    check("an operator run IS in the list and is NOT a name, so the answer is 0",
          str(occurrenceAt(occurrencesOf(pixOneLine, ":="), 0, 8)), "0");
    pixOc := occurrencesOf(pixTwoLines, "pix");
    check("a column that holds no record on the cursor's line answers 0",
          str(occurrenceAt(pixOc, 0, 6)), "0");
    check("and a line that holds the name at another column answers 0 too",
          str(occurrenceAt(pixOc, 1, 4)), "0");
    # These two slots are the thing under test, so they stay literal. The length check and the `if'
    # hold the line: a future edit of this fixture then fails as a FAIL rather than raising
    # INDEX_ERROR inside `oc[slot]' on stdout, which would cost the suite its graded line.
    pixOc := occurrencesOf(pixOneLine, "pix");
    check("the one-line fixture still answers two pix records", str(length(pixOc)), "2");
    if length(pixOc) >= 2 then
      check("the bare pix, on a line that also holds a field access, is not labelled field",
            str(bindAt(pixOneLine, noSyms, "pix", 0, pred(linesIn(pixOneLine)), DOC, 1).owner =
                "field"), "FALSE");
      check("while the pix after the dot on that same line is",
            str(bindAt(pixOneLine, noSyms, "pix", 0, pred(linesIn(pixOneLine)), DOC, 2).owner),
            "field");
    end if;
    check("and a pix on the line ABOVE the field access is not labelled field either",
          str(bindAt(pixTwoLines, noSyms, "pix", 0, pred(linesIn(pixTwoLines)), DOC,
                     occurrenceAt(occurrencesOf(pixTwoLines, "pix"), 0, 4)).owner = "field"),
          "FALSE");
    check("while the one after the dot, on the dot's own line, is",
          str(bindAt(pixTwoLines, noSyms, "pix", 1, pred(linesIn(pixTwoLines)), DOC,
                     occurrenceAt(occurrencesOf(pixTwoLines, "pix"), 1, 6)).owner), "field");
    # The crossing rule, seen from the binding rather than from the flag: `box.' ENDS its line and
    # `pix' starts the next, so the dot is the previous TOKEN of a different line -- and a token
    # whose text is exactly `.' can only be a selector, so this is the field access the write path
    # must refuse. Restoring the line test the stamp used to carry (`prevLine = tk.line0') reddens
    # this check and the flag-level one below it -- measured, which is what makes the pair the
    # witness of the widened rule rather than of a blanket flag.
    check("a dot that ends the line above still marks the cursor's record as a field",
          str(bindAt(pixAfterBreak, noSyms, "pix", 1, pred(linesIn(pixAfterBreak)), DOC,
                     occurrenceAt(occurrencesOf(pixAfterBreak, "pix"), 1, 6)).owner),
          "field");
    # The cursor seam itself, asked directly and from no feature. `cursorAt' is what both readers
    # now call, so the record it returns needs a witness that goes through neither a refusal nor a
    # location list, and this pins all three of its fields at once. Every number is a probe print of
    # the shipped code (`s7 -q -l src' over these fixtures), not arithmetic. The third part is the
    # part that pays: owner "field" is reachable only through row 4's `slot <> 0 and
    # oc[slot].dotPrev', so the pin also proves the slot found here is the slot handed to
    # `resolveBinding'. Written after working code, it passes on sight; the mutant that reddens it
    # is named in the commit.
    cr := cursorAt(pixOneLine, noSyms, "pix", 0, 18, pred(linesIn(pixOneLine)), DOC);
    check("cursorAt hands back the list, the cursor's record and the binding from one pass",
          str(length(cr.oc)) <& "|" <& str(cr.slot) <& "|" <& cr.b.owner, "2|2|field");

    # ---- rows 5 and 6: language furniture, and the mystery -----------------------
    b := bind(text, syms, "begin", 37, lastLine, DOC);
    check("a keyword binds to nothing and is marked as one",
          bindPin(b), "begin||FALSE|TRUE|FALSE|0");
    check("a keyword still answers the whole document", scopePin(b), "0-44");
    b := bind(text, syms, "mysteryName", 38, lastLine, DOC);
    check("an unknown name is unresolved but not a keyword",
          bindPin(b), "mysteryName||FALSE|FALSE|FALSE|0");
    # `type' is a legal declared name (spec 11.11 measured it clean) that the completion
    # vocabulary list also holds, so a gate built from that list instead of CANNOT_BE_NAME
    # would answer owner "" here and deny a rename of a real symbol.
    b := bind(text, syms, "type", 38, lastLine, DOC);
    check("a buffer declaration named like a vocabulary word is that declaration",
          bindPin(b), "type|global|TRUE|FALSE|FALSE|10");
    b := bind(text, syms, "", 38, lastLine, DOC);
    check("the empty name is total and binds to nothing",
          bindPin(b), "||FALSE|FALSE|FALSE|0");

    # ---- a truncated buffer: the analyzer reported a declaration that failed -----
    truncated := "$ include \"seed7_05.s7i\";\n" <&
                 "const proc: main is func\n" <&
                 "  local\n" <&
                 "    var integer: count is 0;\n" <&
                 "  begin\n";
    td := analysisOf(truncated, DOC);
    tsyms := td.syms;
    check("the truncated fixture is the unanalysable one",
          str(length(td.parsed.diags) <> 0), "TRUE");
    b := bind(truncated, tsyms, "count", 3, pred(linesIn(truncated)), DOC);
    check("a truncated buffer leaves the binding unresolved",
          bindPin(b), "count||FALSE|FALSE|FALSE|0");
    check("but it still answers the whole document", scopePin(b), "0-5");

    # ---- an empty buffer: the first state of a new file ---------------------------------
    # Total by inspection -- blockRegions and occurrencesOf each walk an empty text
    # without indexing anything -- but nothing pinned it, and an empty document is the first
    # request a client ever sends.
    b := resolveBinding("", noSyms, 0 times occurrence.value, "count", 0, 0, DOC, 0);
    check("an empty buffer binds nothing",
          bindPin(b), "count||FALSE|FALSE|FALSE|0");
    check("and answers a one-line scope rather than raising", scopePin(b), "0-0");

    # ---- a routine whose whole body sits on one line pairs with no region --------
    # blocks.sd7's line-granular rule: closeFrom emits a region only when the body opens
    # above the line it closes, so `tiny' has none and its parameter can neither bind a
    # cursor nor be subtracted from the global's scope.
    oneLine := "$ include \"seed7_05.s7i\";\n" <&
               "const proc: tiny (inout integer: count) is func begin count := 1; end func;\n" <&
               "var integer: count is 0;\n" <&
               "const proc: main is func begin tiny(count); end func;\n";
    od := analysisOf(oneLine, DOC);
    osyms := od.syms;
    check("the one-line fixture analyses clean", str(length(od.parsed.diags)), "0");
    b := bind(oneLine, osyms, "count", 3, pred(linesIn(oneLine)), DOC);
    check("an unpaired routine excludes nothing from the global's scope",
          excludedPin(b), "");
    check("and the global still binds", bindPin(b), "count|global|TRUE|FALSE|FALSE|3");
    check("and an unpaired carrier marks the global's scope uncertain",
          str(b.scopeUncertain), "TRUE");
    b := bind(oneLine, osyms, "count", 0, pred(linesIn(oneLine)), DOC);
    check("an unpaired routine captures no line, not even line 0",
          bindPin(b), "count|global|TRUE|FALSE|FALSE|3");

    # ---- a one-line routine above a multi-line one: pairing is not ownership -------
    # blocks.sd7's closeFrom emits a region only when openLine < endLine, so `tiny' has none
    # and routineRegionFor pairs its name line with WIDE's region. Adjacency would be enough
    # if nothing else were asked of the pair, but row 1 reads a scope out of it and row 2
    # subtracts it, so an unowned pair renames the wrong declaration and drops a real use.
    mixed := "$ include \"seed7_05.s7i\";\n" <&
             "  include \"console.s7i\";\n" <&
             "\n" <&
             "var integer: count is 0;\n" <&
             "\n" <&
             "const proc: tiny (inout integer: count) is func begin count := 1; end func;\n" <&
             "\n" <&
             "const proc: wide is func\n" <&
             "  begin\n" <&
             "    count := 2;\n" <&
             "  end func;\n" <&
             "\n" <&
             "const proc: deep (inout integer: count) is func\n" <&
             "  begin\n" <&
             "    count := 3;\n" <&
             "    writeln(count);\n" <&
             "  end func;\n" <&
             "\n" <&
             "const proc: main is func\n" <&
             "  begin\n" <&
             "    count := 4;\n" <&
             "    tiny(count);\n" <&
             "    wide;\n" <&
             "    deep(count);\n" <&
             "    writeln(count);\n" <&
             "  end func;\n";
    md := analysisOf(mixed, DOC);
    msyms := md.syms;
    mlast := pred(linesIn(mixed));
    moc := occurrencesOf(mixed, "count");
    check("the mixed fixture analyses clean", str(length(md.parsed.diags)), "0");
    # A cursor on the global inside wide, which declares nothing. tiny pairs wide's region 7-10
    # and holds the name in its locals, so an ownership-blind row 1 answers tiny's parameter
    # line (6) as the declaration of a name the cursor never meant.
    b := bind(mixed, msyms, "count", 9, mlast, DOC);
    check("a one-line routine does not lend its pair to a cursor in the routine below",
          bindPin(b), "count|global|TRUE|FALSE|FALSE|4");
    check("and the global's scope stays the whole document", scopePin(b), "0-26");
    check("and only the routine that owns a region is subtracted from it",
          excludedPin(b), "12-16");
    check("so wide's use of the global survives the subtraction",
          linesPin(inScope(moc, b)), "3 5 5 9 20 21 23 24");
    # tiny really does shadow inside its own one-line body, and nothing here can name that body,
    # so the global's subtraction is short by it -- over-inclusion a read can live with and a
    # write cannot. The flag is the whole signal, because callers may not re-derive scope.
    check("a carrier that owns no region says the global's scope may be short",
          str(b.scopeUncertain), "TRUE");
    # The same name in a routine that DOES own its pair: row 1 must still answer it, and its own
    # region is complete, so the flag stays down.
    b := bind(mixed, msyms, "count", 14, mlast, DOC);
    check("a routine that owns its paired region still binds its own local",
          bindPin(b), "count|local|TRUE|FALSE|FALSE|13");
    check("and its scope is that region", scopePin(b), "12-16");
    check("and the owning routine keeps its own three occurrences",
          linesPin(inScope(moc, b)), "12 14 15");
    check("a binding that owns its region does not call its scope uncertain",
          str(b.scopeUncertain), "FALSE");

    # ---- an open .s7i: the declarations arrive with file = the document path -----------
    # lsp_server analyses a library buffer through driverFor(pathOf(uri)) and hands that same
    # path to analyzeAll as docPath, so its own records report the PATH, not BUFFER_FILE
    # (analysis_test measures it for probeDouble). Without that arm of isBufferFile the scope of
    # every .s7i declaration would be empty and row 1 could never bind one -- which is the shape
    # Important 1 makes destructive, because row 2 then answers `global' for a record whose
    # `locals' were never read.
    libPath := "/tmp/seed7_lsp_occurrences.s7i";
    libDoc := open(libPath, "w");
    write(libDoc, "var integer: counter is 0;\n\n" <&
          "const proc: libProbe (inout integer: counter) is func\n" <&
          "  begin\n    counter := counter + 1;\n    writeln(counter);\n  end func;\n\n" <&
          "const proc: libUse is func\n  begin\n    counter := 2;\n  end func;\n");
    close(libDoc);
    libText := readAll(libPath);
    ld := analysisOf(driverFor(libPath), libPath);
    lsyms := ld.syms;
    check("the .s7i driver fixture analyses clean", str(length(ld.parsed.diags)), "0");
    b := bind(libText, lsyms, "counter", 4, pred(linesIn(libText)), libPath);
    check("a declaration reached through the .s7i driver binds its own parameter",
          bindPin(b), "counter|local|TRUE|FALSE|FALSE|3");
    check("and its scope is the library file's own region", scopePin(b), "2-6");

    # A second .s7i, all of whose routines sit on one line: the region list is EMPTY, so the
    # pair of the name-carrying routine at line1 1 is the unset blockRef -- whose startLine 0 is
    # indistinguishable from a REAL region opening on line 0. ownsRegion's closer test is what
    # keeps that phantom from becoming a scope, and this is the input that reaches it.
    lib2Path := "/tmp/seed7_lsp_occurrences2.s7i";
    lib2Doc := open(lib2Path, "w");
    write(lib2Doc, "const proc: libTiny (inout integer: counter) is func begin counter := 1; end func;\n" <&
          "var integer: counter is 0;\n" <&
          "const proc: libUse is func begin counter := 2; end func;\n");
    close(lib2Doc);
    lib2Text := readAll(lib2Path);
    l2d := analysisOf(driverFor(lib2Path), lib2Path);
    l2syms := l2d.syms;
    check("the no-region .s7i fixture analyses clean", str(length(l2d.parsed.diags)), "0");
    b := bind(lib2Text, l2syms, "counter", 0, pred(linesIn(lib2Text)), lib2Path);
    check("a carrier with no region at all is not handed the phantom region at line 0",
          bindPin(b), "counter|global|TRUE|FALSE|FALSE|2");
    check("and its scope stays the whole file rather than one line", scopePin(b), "0-4");

    # ---- row 1's measured limit: a nested routine is not a globalObjects entry -----
    # `inner' appears only as an entry of outer's own scope (BLOCKOBJECT, line1 5) and has no
    # symRec of its own, so its locals are invisible: a cursor inside inner's body binds
    # OUTER's `count' and outer's wider region. Over-inclusive on well-formed code -- spec
    # section 4's nested case -- recorded here rather than left for a rename to discover while
    # rewriting two declarations that were meant to be one.
    nested := "$ include \"seed7_05.s7i\";\n" <&
              "const proc: outer is func\n" <&
              "  local\n" <&
              "    var integer: count is 0;\n" <&
              "    const proc: inner is func\n" <&
              "      local\n" <&
              "        var integer: count is 0;\n" <&
              "      begin\n" <&
              "        count := 2;\n" <&
              "      end func;\n" <&
              "  begin\n" <&
              "    count := 1;\n" <&
              "    inner;\n" <&
              "  end func;\n" <&
              "const proc: main is func\n" <&
              "  begin\n" <&
              "    outer;\n" <&
              "  end func;\n";
    nd := analysisOf(nested, DOC);
    nsyms := nd.syms;
    check("the nested fixture analyses clean", str(length(nd.parsed.diags)), "0");
    b := bind(nested, nsyms, "count", 8, pred(linesIn(nested)), DOC);
    check("a nested routine's own scope is invisible, so the outer one binds",
          bindPin(b) <& " " <& scopePin(b), "count|local|TRUE|FALSE|FALSE|4 1-13");
    # The cursor is in inner's region 4-9 while the binding answers outer's 1-13: inner may well
    # declare this name (it does) and reflection cannot report it, so this scope is a guess.
    check("a cursor below the matched region marks the local's scope uncertain",
          str(b.scopeUncertain), "TRUE");

    # ---- the cap: MAX_OCCURRENCES + 1 is the truncation test, no second pass -----
    # Not analysed, deliberately: the cap is a property of the occurrence pass, and 2000
    # lines of `count := 1;' is not a program. Empty records are the honest input for it.
    for i range 1 to MAX_OCCURRENCES do
      capText &:= "count := 1;\n";
    end for;
    b := bind(capText, noSyms, "count", 0, pred(linesIn(capText)), DOC);
    check("exactly MAX_OCCURRENCES occurrences are not capped", str(b.capped), "FALSE");
    capText &:= "count := 1;\n";
    b := bind(capText, noSyms, "count", 0, pred(linesIn(capText)), DOC);
    check("one more occurrence is capped", str(b.capped), "TRUE");

    # ---- Task 1's checks, unchanged ---------------------------------------------
    oc := occurrencesOf("count := 1;\nwriteln(count);\n", "count");
    check("two occurrences of count", str(length(oc)), "2");
    check("first is the declaration", at(oc, 1), "0:0:5");
    check("second is the use inside the call", at(oc, 2), "1:8:5");

    # `kind' is published for a reason (inScope and the rename path must not edit a number), but
    # until now nothing read it: the field could have been dropped and every check stayed green.
    check("a name occurrence reports TK_NAME", str(oc[1].kind), str(TK_NAME));
    oc := occurrencesOf("a := b <+ c;\n", "<+");
    check("an operator occurrence reports TK_OP", str(oc[1].kind), str(TK_OP));

    # A comment/string token's text carries its own delimiters ("# count", "\"count\""), so
    # these two prove token-boundary behaviour (the delimiters are inside the token, so the text
    # comparison rejects them whatever the filter does). What proves the KIND filter is the
    # bracket and number checks below: their token text is exactly "(" and "1".
    oc := occurrencesOf("writeln(count); # count\n", "count");
    check("a name in a line comment does not count", str(length(oc)), "1");
    oc := occurrencesOf("writeln(\"count\");\n", "count");
    check("a name inside a string does not count", str(length(oc)), "0");
    # measured: two astral characters inside a masked literal cost two UTF-16 units,
    # so the mask would answer 11 and doc.text answers 13. Review Focus 3.
    oc := occurrencesOf("x := \"\128512;\128512;\"; count := 1;\n", "count");
    check("the column counts the astral characters in the literal before it",
          at(oc, 1), "0:13:5");
    # an operator run is indexable, so references finds it; rename refuses it on the token kind
    # (spec 6), and features_test.sd7 pins both shapes -- library `+' and buffer-declared `<+'
    oc := occurrencesOf("a := b <+ c;\nd := b <+ c;\n", "<+");
    check("an operator token is an occurrence", str(length(oc)), "2");
    # These two are what reach the kind filter. A comment token's text is "# count" and a
    # string token's is "\"count\"", so their own delimiters defeat the name comparison
    # whatever the filter does -- they cannot prove it. "(" and "1" are delimiter-free like a
    # name (TK_BRACKET and TK_NUMBER are both outside TK_OP), so each fails if indexableKind
    # stops requiring TK_NAME/TK_OP.
    oc := occurrencesOf("writeln(count);\n", "(");
    check("a bracket token is not indexable", str(length(oc)), "0");
    oc := occurrencesOf("x := 1;\n", "1");
    check("a number token is not indexable", str(length(oc)), "0");
    oc := occurrencesOf("discount := 1;\n", "count");
    check("a name that is only a substring of a longer name is not an occurrence",
          str(length(oc)), "0");
    # `dotPrev' is what lets the write path refuse a record field (spec 12.2). These four pin the
    # flag itself: three on a line, which no widening may change, and one across a break, which is
    # the widened rule. They are NOT the proof: the refusal checks in features_test.sd7 were written
    # first and went red against the shipped code, and replacing this stamp with FALSE reddens
    # them again -- which is what makes the flag load-bearing rather than decorative.
    oc := occurrencesOf("total := box.total + 1;\n", "total");
    check("a name written after a dot is marked", dotAt(oc, 2), "TRUE");
    check("and the same spelling at the start of the line is not", dotAt(oc, 1), "FALSE");
    oc := occurrencesOf("sum := 1 + total;\n", "total");
    check("a name after a `+' is not a field access", dotAt(oc, 1), "FALSE");
    oc := occurrencesOf("box.\n  total := 1;\n", "total");
    check("a dot ending the line above marks it too -- a `.' token is only ever a selector",
          dotAt(oc, 1), "TRUE");

    # ---- spec 9's two hidden-text fixtures, asked for by name and never written -------------
    # The first is the literal `prg/calc7.sd7:57-58' really uses: a BACKSLASH at the end of the
    # line, inside the quotes, which Seed7 ignores together with the break and the blanks that
    # follow it, so the literal goes on. A scanner that stopped the literal at that break makes
    # the continued text code, and a name written inside it -- `count' below -- then enters the
    # index. The fixture is built with escapes because `\" <& chr(92)' at statement level is the
    # trap this branch already hit: the escape eats the closing quote and the file will not parse.
    contText := "x := \"abc \\\n  count\";\n";
    oc := occurrencesOf(contText, "count");
    check("a name inside a continued string literal is not an occurrence",
          str(length(oc)), "0");
    oc := occurrencesOf("x := count;\n", "count");
    check("the control, the same name with no literal around it", at(oc, 1), "0:5:5");
    # What the two records above cannot say, this one does: the literal is ONE token that ends at
    # the quote on the LATER line, so the code after that quote is indexed, and its column is
    # counted from the start of the continued line -- measured 1:10:5, and wrong in the line if the
    # continuation is honoured without moving the cursor over the break. Mutating the string arm of
    # `nextToken' to end at the backslash reddens the first check; dropping the scanLineBreak call
    # inside `skipContinuation' reddens this one.
    contText := "x := \"abc \\\n  count\"; count := 1;\n";
    oc := occurrencesOf(contText, "count");
    check("one name survives the continuation, and it is the one after the closing quote",
          str(length(oc)) <& " " <& at(oc, 1), "1 1:10:5");

    # The second is `lib/chartype.s7i:45' -- `{'"'}', a char literal whose element IS the double
    # quote. Read as a string introducer it opens a literal that runs to the end of its line, and
    # every name after it on that line silently leaves the index. The NEXT-line form below is the
    # one spec 9 measured, and it is stated as measured (one occurrence) -- but it is a REDUNDANCY
    # OF THE CHAR ARM, not a proof: it survived every mutation of that arm ("read no element", "read
    # no escape element"), because a string opened at that quote stops at its own line break, so the
    # literal never reaches the line below and a name there is code either way. The claim is scoped
    # to that arm on purpose: this check DOES pin the following token's LINE, so it would go red only
    # on the CONJUNCTION -- a string arm that lets a literal cross a break AND a char arm that fails
    # to read the quote as its element. The string arm alone cannot redden it, because the literal it
    # opens here never reaches the next line. Unqualified, "cannot fail" is too strong. The
    # same-line form is the check that can fail on the arm: the quote arm failing to read one element
    # and its closing quote turns its expected column into "none".
    quoteText := "const set of char: q is {'\"'};\ncount := 1;\n";
    oc := occurrencesOf(quoteText, "count");
    check("what follows a quote char literal on the next line is still code",
          at(oc, 1), "1:0:5");
    quoteText := "const set of char: q is {'\"'}; count := 1;\n";
    oc := occurrencesOf(quoteText, "count");
    check("and what follows it on ITS OWN line is still code", at(oc, 1), "0:31:5");
    # The same character written numerically, the fallback spec 9 names. It takes the ESCAPE arm of
    # the char literal -- the branch that runs `pastEscape' and then counts what it swallowed -- which
    # the quote spelling above never reaches (a quote is an ordinary element, so the plain branch reads
    # it) -- yet NO deletion of that arm reddens it: the leftovers re-tokenise as a two-character char
    # literal, a number, an operator, and a second char literal whose ELEMENT is the closing brace, so
    # nothing survives as a bracket and nothing reports TK_ILLEGAL. Measured on the mutated scanner:
    # `'\' 2, `34' 2, `;' 1, `'}' 2, `;' 1 against the shipped `'\34;' 6 + `}' 1 + `;' 1 -- an
    # unchanged total column advance, so `count' still arrives at 0:34:5. Deleting the branch left all
    # 94 checks of this suite green while scan_test.sd7 went red four times. What this check DOES
    # depend on is the escape arm's width statement (`units +:= j - before'): fixing that count at 1
    # makes the token 3 wide instead of 6, moves `count' to 0:31:5, and reddens THIS check alone -- the
    # quote spellings are 3 wide either way, so they stay green, and the plain branch's
    # `units +:= utf16CharLength(text[j])' cannot be separated from a fixed 1 by any ASCII element.
    # The same regression is already pinned in tests/scan_test.sd7 by "the five char spellings and
    # their widths" and "the name after a numeric-escape char literal is still code", so this is a
    # duplicate seen from the occurrence index, not a new proof -- and not the decorative class
    # either, because a width mutant does kill it.
    quoteText := "const set of char: q is {'\\34;'}; count := 1;\n";
    oc := occurrencesOf(quoteText, "count");
    check("the numeric spelling of the same element is hidden the same way",
          str(length(oc)) <& " " <& at(oc, 1), "1 0:34:5");

    report("occurrences");
  end func;
