$ include "seed7_05.s7i";
  include "utf8.s7i";
  include "lsp_tst.sd7";
  include "doc_index.sd7";

# Suite-local, one comparison per character: a long and/or chain of them can fail to
# match (AGENTS.md). The check below compares numbers rather than the prose because
# lsp_tst.sd7 prints on plain stdout.
const func integer: countCharsAbove127 (in string: text) is func
  result
    var integer: total is 0;
  local
    var integer: idx is 0;
  begin
    for idx range 1 to length(text) do
      if text[idx] > chr(127) then
        total +:= 1;
      end if;
    end for;
  end func;

const proc: main is func
  local
    var string: path is "/tmp/seed7_lsp_docindex.sd7";
    var file: out is STD_NULL;
    # A second fixture, written with openUtf8 so the bytes on disk are the bytes a real
    # library holds. The write(out, ...) calls that build the fixture above cannot produce
    # the defect: a plain Seed7 write emits one byte per character, so that round trip is
    # self-consistent.
    var string: nonAsciiPath is "/tmp/seed7_lsp_docindex_utf8.sd7";
    var file: utfOut is STD_NULL;
    var integer: declLine1 is 4;
  begin
    out := open(path, "w");
    write(out, "const integer: a is 1;\n");
    write(out, "\n");
    write(out, "(**\n");
    write(out, " *  Adds two numbers.\n");
    write(out, " *  @param a First addend.\n");
    write(out, " *  @return the sum.\n");
    write(out, " *)\n");
    write(out, "const func integer: addTwo (in integer: a, in integer: b) is\n");
    write(out, "  return a + b;\n");
    write(out, "\n");
    write(out, "(**\n");
    write(out, " *  First line.\n");
    write(out, " *  Second line.\n");
    write(out, " *)\n");
    write(out, "const proc: three is func\n");
    write(out, "(** *  Single line. *)\n");
    write(out, "const proc: four is func\n");
    close(out);
    utfOut := openUtf8(nonAsciiPath, "w");
    write(utfOut, "(**\n");
    write(utfOut, " *  Converts ¡ to € and back again.\n");
    write(utfOut, " *)\n");
    write(utfOut, "const proc: six is func\n");
    close(utfOut);
    check("prose of the doc comment", proseFor(path, 8), "Adds two numbers.");
    check("multi-line prose keeps both lines in order", proseFor(path, 15),
          "First line.\nSecond line.");
    check("nothing above the first line", proseFor(path, 1), "");
    check("a statement, not a documented declaration", proseFor(path, 9), "");
    check("a one-line comment documents the line below it", proseFor(path, 17),
          "Single line.");
    check("a line inside the comment is no declaration", proseFor(path, 4), "");
    check("the same walk over text in memory",
          proseForText("(**\n *  From the buffer.\n *)\nconst proc: own is func\n", 4),
          "From the buffer.");
    check("in-memory walk finds nothing above line 1",
          proseForText("(**\n *  From the buffer.\n *)\nconst proc: own is func\n", 1), "");
    check("absent file is empty", proseFor("/tmp/seed7_lsp_absent_docindex.sd7", 3), "");
    check("a line past the end of the file is empty", proseFor(path, 99), "");
    check("prose keeps a non-ASCII character as one character",
          str(length(proseFor(nonAsciiPath, declLine1))) <& "/" <&
          str(countCharsAbove127(proseFor(nonAsciiPath, declLine1))), "31/2");
    report("doc_index");
  end func;
