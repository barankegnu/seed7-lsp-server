$ include "seed7_05.s7i";
  include "lsp_tst.sd7";
  include "doc_store.sd7";
  include "blocks.sd7";

# Line count without a document, so the rules are testable without doc_store.
# Matches doc_store.lineCount: a trailing newline counts as a phantom line.
# Pinned by lineCountPin below.
const func integer: linesIn (in string: text) is func
  result
    var integer: out is 1;
  local
    var integer: i is 0;
  begin
    for i range 1 to length(text) do
      if text[i] = '\n' then
        out +:= 1;
      end if;
    end for;
  end func;

# "start-end:kind" joined by " ", so a whole answer fits on one reviewable line.
const func string: regionsOf (in string: text) is func
  result
    var string: out is "";
  local
    var array blockRef: rs is 0 times blockRef.value;
    var integer: i is 0;
    var integer: lastLine is 0;
    var string: tag is "";
  begin
    lastLine := pred(linesIn(text));
    rs := blockRegions(text, lastLine);
    for i range 1 to length(rs) do
      tag := str(rs[i].startLine) & "-" & str(rs[i].endLine);
      if rs[i].kind <> "" then
        tag := tag & ":" & rs[i].kind;
      end if;
      if out <> "" then
        out := out & " ";
      end if;
      out := out & tag;
    end for;
  end func;

# The chain of a list the CALLER holds -- the filter and the rendering, without the scan.
# Named for its parameter so a reader sees which half it exercises.
const func string: chainOfRegions (in array blockRef: all, in integer: line0) is func
  result
    var string: out is "";
  local
    var array blockRef: rs is 0 times blockRef.value;
    var integer: i is 0;
  begin
    rs := enclosingRegionsFrom(all, line0);
    for i range 1 to length(rs) do
      if out <> "" then
        out := out & " ";
      end if;
      out := out & str(rs[i].startLine) & "-" & str(rs[i].endLine);
    end for;
  end func;

const func string: chainOf (in string: text, in integer: line0) is func
  result
    var string: out is "";
  begin
    out := chainOfRegions(blockRegions(text, pred(linesIn(text))), line0);
  end func;

# The routine fixture, one array element per source line: element succ(N) is line0 N, so a
# check can name the line it points at without counting "\n" escapes. Real Seed7 -- analyzeAll
# answers completed with 0 diagnostics on it, and reports oneTwo line1 3, outer 7, bigHeader 16
# (its name line, two above its `is func') and tail 26 -- so these regions are what a document
# gives, not what a guess gives:
#   0-1  includes (imports region)     2  oneTwo `is func` (name line 3, one-line header)
#   6    outer `is func` (name 7)      8  inner `is func` (name 9, nested in outer's local)
#   16   bigHeader name line, its `is func` at 17    25  a top-level const, below every routine
const func string: demo is func
  result
    var string: out is "";
  local
    var array string: lines is [](
      "$ include \"seed7_05.s7i\";",
      "  include \"stdio.s7i\";",
      "const proc: oneTwo (val integer: n) is func",
      "  begin",
      "    writeln(n + n);",
      "  end func;",
      "const proc: outer is func",
      "  local",
      "    const proc: inner is func",
      "      begin",
      "        writeln(\"inner\");",
      "      end func;",
      "  begin",
      "    inner;",
      "  end func;",
      "const proc: bigHeader (val integer: a,",
      "                       val integer: b)",
      "    is func",
      "  begin",
      "    if a > b then",
      "      writeln(\"a\");",
      "    else",
      "      writeln(\"b\");",
      "    end if;",
      "  end func;",
      "const integer: tail is 0;");
    var integer: i is 0;
  begin
    out := "";
    for i range 1 to length(lines) do
      out := out & lines[i] & "\n";
    end for;
  end func;

# The closer of the innermost region at line0. A control, section, clause, struct, repeat,
# comment or imports region answers "", which is the whole point of the field: `kind' cannot
# say "routine body". folding_range.sd7 serialises `kind' into FoldingRange.kind, and
# blockRegions blanks it only for a clause region and for a section -- a routine body's `kind'
# is "" because it is pushed empty, not because anything strips it.
const func string: closerAt (in string: text, in integer: line0) is func
  result
    var string: out is "";
  local
    var array blockRef: rs is 0 times blockRef.value;
  begin
    rs := enclosingRegionsFrom(blockRegions(text, pred(linesIn(text))), line0);
    out := "";
    if length(rs) > 0 then
      out := rs[1].closer;
    end if;
  end func;

# Aggregate witness over the closer field: every region that carries one, "start-end:closer" in
# document order. This one line changes if a closer leaks onto a non-routine region, if the
# stack pop leaves `closerName' out of step with the other arrays, or if `closeFrom' drops the
# copy -- none of which a single named region would have to show.
const func string: closersOf (in string: text) is func
  result
    var string: out is "";
  local
    var array blockRef: rs is 0 times blockRef.value;
    var integer: i is 0;
    var string: tag is "";
  begin
    rs := blockRegions(text, pred(linesIn(text)));
    for i range 1 to length(rs) do
      if rs[i].closer <> "" then
        tag := str(rs[i].startLine) & "-" & str(rs[i].endLine) & ":" & rs[i].closer;
        if out <> "" then
          out := out & " ";
        end if;
        out := out & tag;
      end if;
    end for;
  end func;

# "start..end" of the routine body that pairs with the 1-based declaration line, or "none" --
# the answer Task 6 reads as unresolved. This is the pairing resolveBinding actually performs
# (blocks.routineRegionFor over a blockRegions scan); the one-line wrapper M5 shipped for it had
# no production caller and was deleted, so the suite calls the surviving pair directly.
const func string: regionOfDeclaration (in string: text, in integer: declLine1) is func
  result
    var string: out is "none";
  local
    var blockRef: r is blockRef.value;
  begin
    r := routineRegionFor(blockRegions(text, pred(linesIn(text))), declLine1);
    out := "none";
    if r.closer <> "" then
      out := str(r.startLine) & ".." & str(r.endLine);
    end if;
  end func;

# "start/end/kind/closer" of one region, so the no-match answer is pinned as a record, not as
# a phrase.
const func string: regionPin (in blockRef: r) is func
  result
    var string: out is "";
  begin
    out := str(r.startLine) & "/" & str(r.endLine) & "/" & r.kind & "/" & r.closer;
  end func;

# Invariant check: every region satisfies startLine >= 0, endLine <= lastLine, endLine > startLine.
# Returns the first violation found, or "" if valid.
const func string: regionsValid (in string: text) is func
  result
    var string: out is "";
  local
    var array blockRef: rs is 0 times blockRef.value;
    var integer: lastLine is 0;
    var integer: i is 0;
  begin
    lastLine := pred(linesIn(text));
    rs := blockRegions(text, lastLine);
    for i range 1 to length(rs) do
      if rs[i].startLine < 0 then
        out := "region " <& str(i) <& " has startLine < 0";
      elsif rs[i].endLine > lastLine then
        out := "region " <& str(i) <& " has endLine > lastLine";
      elsif rs[i].endLine <= rs[i].startLine then
        out := "region " <& str(i) <& " has endLine <= startLine";
      end if;
      if out <> "" then
        # Exit early on first violation
        i := length(rs) + 1;
      end if;
    end for;
  end func;

# Shared fixture list: one source of truth for exact-output checks and property checks.
const type: fixture is new struct
    var string: text is "";
    var string: expected is "";
  end struct;

const func array fixture: allFixtures is func
  result
    var array fixture: out is 0 times fixture.value;
  local
    var fixture: f is fixture.value;
  begin
    f.text := ""; f.expected := ""; out &:= f;
    f.text := "const proc: a is func\nbegin\n  noop;\nend func;\n"; f.expected := "0-3 1-3"; out &:= f;
    f.text := "const proc: a is func\nbegin\n  if TRUE then\n    noop;\n  end if;\nend func;\n"; f.expected := "0-5 1-5 2-4"; out &:= f;
    f.text := "repeat\n  noop;\nuntil TRUE;\nwriteln(1);\n"; f.expected := "0-2"; out &:= f;
    f.text := "if a then\n  x := 1;\nelsif b then\n  x := 2;\nend if;\n"; f.expected := "0-4 1-2 3-4"; out &:= f;
    f.text := "(* one\n   two *)\nwriteln(1);\n"; f.expected := "0-1:comment"; out &:= f;
    f.text := "# a\n# b\n# c\nwriteln(1);\n"; f.expected := "0-2:comment"; out &:= f;
    f.text := "# only one\nwriteln(1);\n"; f.expected := ""; out &:= f;
    f.text := "$ include \"seed7_05.s7i\";\n  include \"stdio.s7i\";\nwriteln(1);\n"; f.expected := "0-1:imports"; out &:= f;
    f.text := "(* if\n  still comment\n *)\nwriteln(1);\n"; f.expected := "0-2:comment"; out &:= f;
    f.text := "(* unclosed"; f.expected := ""; out &:= f;
    f.text := "(* unclosed\n"; f.expected := "0-1:comment"; out &:= f;
    f.text := "(* unclosed\nwriteln(1);\n"; f.expected := "0-2:comment"; out &:= f;
    f.text := "const proc: a is func\nbegin\n  if TRUE then\n"; f.expected := "0-3 1-3 2-3"; out &:= f;
    f.text := "const type: t is new struct\n  var integer: a is 0;\nend struct;\n"; f.expected := "0-2"; out &:= f;
    # A declaration whose `is' is followed by a value, not a name: the keyword that opens the
    # next block must still reach its own branch. At HEAD the `begin' branch never runs and
    # the body region is missing from the answer.
    f.text := "const proc: q is func\n  var integer: a is 0;\nbegin\n  writeln(a);\nend func;\n";
    f.expected := "0-4 2-4"; out &:= f;
    f.text := "const proc: p is func\n  local\n    var integer: a is 0;\n  begin\n    writeln(a);\n  end func;\n";
    f.expected := "0-5 1-3 3-5"; out &:= f;
    f.text := demo();
    f.expected := "0-1:imports 2-5 3-5 6-14 7-12 8-11 9-11 12-14 17-24 18-24 19-23 20-21 22-23";
    out &:= f;
  end func;

const proc: main is func
  local
    var array fixture: fixtures is 0 times fixture.value;
    var lsDoc: doc is lsDoc.value;
    var integer: i is 0;
    var string: violation is "";
    var string: text is "";
    var array blockRef: rs is 0 times blockRef.value;
  begin
    fixtures := allFixtures;
    # Exact-output checks and property checks from the same list.
    for i range 1 to length(fixtures) do
      check("fixture " <& str(i) <& " regions", regionsOf(fixtures[i].text), fixtures[i].expected);
      violation := regionsValid(fixtures[i].text);
      check("fixture " <& str(i) <& " invariant", violation, "");
      # Pin: linesIn matches lineCount for every fixture.
      setVersion(doc, fixtures[i].text, 1);
      check("fixture " <& str(i) <& " linesIn matches lineCount",
            str(linesIn(fixtures[i].text)), str(lineCount(doc)));
    end for;
    # Chain checks (not in the fixture list because they test a different interface).
    check("the chain at a position runs innermost first",
          chainOf("const proc: a is func\nbegin\n  if TRUE then\n    noop;\n  end if;\nend func;\n",
                  3), "2-4 1-5 0-5");
    check("a line outside every construct has no chain",
          chainOf("writeln(1);\n", 0), "");

    # ---- the filter applied to a list the caller holds, which is what selectionRange pays ----
    # blockRegions(text, 4) holds exactly two regions, 1-4 and 2-4; line0 3 sits in both.
    text := "$ include \"seed7_05.s7i\";" <& chr(10) <& "const proc: main is func" <& chr(10)
            <& "  begin" <& chr(10) <& "    writeln(1);" <& chr(10) <& "  end func;";
    rs := blockRegions(text, pred(linesIn(text)));
    check("filter of a held list, innermost first", chainOfRegions(rs, 3), "2-4 1-4");
    # A line that IS a region's last line: both regions still contain it. This is the
    # row that proves the end-line test is inclusive -- at line 3 it is not observable.
    check("a region's own end line is inside it", chainOfRegions(rs, 4), "2-4 1-4");
    check("a held list with nothing enclosing it", chainOfRegions(rs, 0), "");

    # ---- which region is a routine, and where does it end ----
    # Aggregate over the fixture: exactly the four routine bodies carry a closer. Sections,
    # clauses, the `if', the imports run and every comment are absent from this line.
    check("only routine bodies carry a closer", closersOf(demo()),
          "2-5:func 6-14:func 8-11:func 17-24:func");
    check("the routine region carries its closer", closerAt(demo(), 2), "func");
    check("a nested routine region carries its closer", closerAt(demo(), 8), "func");
    check("a multi-line header's region carries its closer", closerAt(demo(), 17), "func");
    check("a control body carries no closer", closerAt(demo(), 19), "");
    check("a begin section carries no closer", closerAt(demo(), 3), "");
    check("a clause carries no closer", closerAt(demo(), 20), "");
    check("an imports region carries no closer", closerAt(demo(), 0), "");
    check("a comment region carries no closer",
          closerAt("(* one\n   two *)\nwriteln(1);\n", 1), "");
    check("a repeat body carries no closer",
          closerAt("repeat\n  writeln(1);\nuntil TRUE;\n", 1), "");
    check("a struct body carries no closer",
          closerAt("const type: t is new struct\n  var integer: a is 0;\nend struct;\n", 1), "");

    # declarationRegion: a 1-based NAME line (what reflection reports) to its body region.
    check("a one-line header pairs with its own region", regionOfDeclaration(demo(), 3), "2..5");
    check("a nested one-line header pairs with its own region",
          regionOfDeclaration(demo(), 9), "8..11");
    check("a declaration line above its own region still pairs",
          regionOfDeclaration(demo(), 16), "17..24");
    check("a declaration below every routine body pairs with nothing",
          regionOfDeclaration(demo(), 26), "none");
    # The no-match answer, pinned as a record. startLine 0 alone cannot mean "nothing": a real
    # region may start at line 0 (fixture 1 is exactly that), so `closer' is the discriminator.
    check("an unpaired declaration answers the empty region",
          regionPin(routineRegionFor(blockRegions(demo(), pred(linesIn(demo()))), 26)), "0/0//");
    check("a routine on the first line still pairs",
          regionPin(routineRegionFor(blockRegions("const proc: a is func\nbegin\n  noop;\nend func;\n", 3), 1)),
          "0/3//func");
    # An unset declaration line is the default of symRec.line1, not line 0 of the document.
    # Without the guard pred(0) = -1 matches every region, so this answers the file's FIRST
    # routine body -- a wrong pair, not a missing one.
    check("an unknown declaration line pairs with nothing, not with the first routine",
          regionPin(routineRegionFor(blockRegions(demo(), pred(linesIn(demo()))), 0)), "0/0//");

    # The four checks that used to call blocks.enclosingDeclarations are gone with the function,
    # and one assertion among them is NOT lost: "a non-routine region in the chain is not a
    # declaration" -- the closer <> "" filter -- is pinned where that filter actually runs, at
    # occurrences_test.sd7 ("a carrier with no region at all is not handed the phantom
    # region at line 0"), which is production code with a real caller. The other three tested a
    # convenience wrapper no production path ever called.
    report("blocks");
  end func;
